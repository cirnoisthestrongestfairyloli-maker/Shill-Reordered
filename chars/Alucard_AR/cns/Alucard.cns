;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
;[statedef -2]


;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, Regeneration]
type = LifeAdd
triggerall = Alive = 1
trigger1 = (GameTime%10) = 0
ignorehitpause = 0
value = 1

[State -3 ]
type = PlaySnd
triggerall = time = 1
triggerall = Alive
trigger1 = stateno = 5120
value = 5120,0+random%5
channel = 0
ignorehitpause = 1

[State -3 ]
type = PlaySnd
triggerall = time = 1
triggerall = Alive
trigger1 = stateno = 5000
value = 5200,0+random%3
channel = 0
ignorehitpause = 1

[State -3 ]
type = PlaySnd
triggerall = time = 1
triggerall = Alive
trigger1 = stateno = 5030
value = 5200,0+random%3
channel = 0
ignorehitpause = 1

[State -3, AssertSpecial]
type = AssertSpecial
trigger1 = 1 && var(0) = 10
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard

[State -3, HitOverride]
type = HitOverride
trigger1 = 1 && var(0) = 10
attr = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
stateno = 1140
time = 2

[State -3]
type = AfterImage
trigger1 =  1 && var(0) = 10
trigger1 = Time = 1
time = 1
PalColor = 256
paladd = 200, 0 ,0
length = 40

[State -3]
type = AfterImageTime
trigger1 =  1 && var(0) = 10
trigger1 = Time > 1
time = 5


;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 41, 11


