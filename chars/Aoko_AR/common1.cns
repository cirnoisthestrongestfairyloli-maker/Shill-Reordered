type    = L
movetype= H
physics = N

[State 5110, 1] ;Hit ground
trigger1 = 1
type = ChangeState
value = 15110

;---------------------------------------------------------------------------
; Downed get-hit (getting up)
[Statedef 5120]
type    = L
movetype= I
physics = N

[State 5120, end]
type = ChangeState
trigger1 = 1
value = 15120

;---------------------------------------------------------------------------
; Downed get-hit (lying defeated)
[Statedef 5150]
type    = L
movetype= H
physics = N
sprpriority = -3
ctrl = 0

[State 5150, 1] ;Normal anim
type = ChangeAnim
triggerall = Time = 0
triggerall = SelfAnimExist(5140)
trigger1 = (anim != [5111,5119]) && (anim != [5171,5179])
trigger2 = !SelfAnimExist(5140 + (anim % 10))
value = 5140

[State 5150, 3] ;Hit up type anim
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (anim = [5111,5119]) || (anim = [5171,5179])
trigger1 = SelfAnimExist(5140 + (anim % 10))
value = 5140 + (anim % 10)

[State 5150, 4] ;Match over anim
type = ChangeAnim
persistent = 0
;trigger1 = Time = 0
trigger1 = MatchOver = 1
trigger1 = Anim = [5140,5149]
trigger1 = SelfAnimExist(anim+10)
value = anim+10

[State 5150, 5] ;Switch to 5110 if liedead anim does not exist
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Anim != [5140,5159]
trigger1 = Anim != [5110,5119]
value = 5110

[State 5150, 6] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 5150, 7] ;Friction
type = VelSet
trigger1 = abs(Vel x) < Const(movement.down.friction.threshold)
persistent = 0
x = 0

[State 5150, 8]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Air get-hit (fall recovery on ground; still falling)
[Statedef 5200]
type    = A
movetype= H
physics = N

[State 5200, 1] ;Change anim if done with transition
type = ChangeAnim
trigger1 = Anim = 5035
trigger1 = AnimTime = 0
value = 5050

[State 5200, 2]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5200, 3]
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Vel Y + Pos Y >= 0 
value = 5201

;---------------------------------------------------------------------------
; Air get-hit (fall recovery on ground)
[Statedef 5201]
type    = A
movetype= H
physics = N
anim = Cond(command != "holdback", 5200, 5201)
velset = 0,0

[State 5201, PosSet]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5201, 1] ;Turn if not facing opponent
type = Turn
triggerall = !Time
trigger1 = p2dist X < Const720p(-20)

[State 5201, Forward Vel]
type = VelSet
triggerall = !Time
trigger1 = AILevel = 0
trigger1 = command = "holdfwd"
x = 3

[State 5201, Backward Vel]
type = VelSet
triggerall = !Time
trigger1 = AILevel = 0
trigger1 = command = "holdback"
x = -3

[State 5201, 1.0 behavior 2]
type = VelSet
trigger1 = Time = 2
y = -7

[State 5201, YAccel]
type = VelAdd
trigger1 = Time > 2
y = 0.6

[State 5201, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 0

[State 5201, 4]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 5201, 5] ;Blink white
type = PalFX
trigger1 = Time = 0
time = 3
add = 128,128,128 ;256,256,256

[State 5201, 6]
type = Explod
trigger1 = Time = 0
anim = F60
postype = P1
pos = 0,0
facing = facing
sprpriority = -10

[State 5201, ChangeState]
type = ChangeState
trigger1 = Vel Y > 0 && Vel Y + Pos Y >= 0
value = 52 ;Jump land
ctrl = 0

;---------------------------------------------------------------------------
; Air get-hit (fall recovery in air)
[Statedef 5210]
type    = A
movetype= I
physics = N
ctrl = 0
anim = Cond(command != "holdback", 5210, 5211)
velset = 0,0

[State 5210, ChangeAnim]
type = ChangeAnim
triggerall = !Time
trigger1 = AILevel = 0
value = Cond(Vel X >= 0, 5210, 5211) 

[State 5210, 1] ;Blink white
type = PalFX
trigger1 = Time = 0
time = 3
add = 128,128,128

[State 5210, 2] ;Turn if not facing opponent
type = Turn
trigger1 = Time = 0
trigger1 = p2dist X < Const720p(-80)

[State 5210, Forward Vel]
type = VelSet
triggerall = !Time
trigger1 = AILevel = 0
trigger1 = command = "holdfwd"
x = 3

[State 5210, Backward Vel]
type = VelSet
triggerall = !Time
trigger1 = AILevel = 0
trigger1 = command = "holdback"
x = -3

[State 5210, 1.0 behavior 2]
type = VelSet
trigger1 = Time = 0
y = -7

[State 5210, 3]
type = NotHitBy
trigger1 = 1
value = SCA

[State 5210, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 0

[State 5210, 5]
type = VelAdd
trigger1 = 1
y = 0.45

[State 5210, 5] ;Land on ground
type = ChangeState
trigger1 = Vel Y > 0 && Vel Y + Pos Y >= 0
value = 52 ;Jump land
ctrl = 0

;---------------------------------------------------------------------------
; Continue screen animation
[Statedef 5500]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 5500, 1] ;Use continue animation if available
type = ChangeAnim
trigger1 = time = 0
trigger1 = SelfAnimExist(170)
value = 170

;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 5900, 3] ;Change palette
type = RemapPal
trigger1 = 1
source = 1,1
dest = 1,palno

[State 5900, 5] ;Intro for round 1
type = ChangeState
trigger1 = roundno = 1
value = 191

[State 5900, 6] ;All other rounds
type = ChangeState
trigger1 = 1
value = 0


;---------------------------------------------------------------------------
; Downed get-hit (lying down)
[Statedef 15110]
type    = L
movetype= H
physics = N

[State 15110, EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State 15110, 1] ;For hit up/up-diag type (from state 5081)
type = ChangeAnim
persistent = 0
trigger1 = Anim = 5070
value = 5171

[State 15110, 1] ;For hit up/up-diag type (from state 5081)
type = ChangeAnim
persistent = 0
trigger1 = SelfAnimExist(5110 + (anim % 10))
trigger1 = anim = [5081,5089]
value = 5110 + (anim % 10)

[State 15110, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
triggerall = anim != [5110,5119] ;Not already changed anim
triggerall = Anim != 5171
trigger1 = anim != [5161,5169]
trigger2 = !SelfAnimExist(5170 + (anim % 10))
value = 5170

[State 15110, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
triggerall = time = 0
triggerall = anim != [5110,5119] ;Not already changed anim
triggerall = Anim != 5171
trigger1 = anim = [5161,5169]
trigger1 = SelfAnimExist(5171)
value = 5171

[State 15110, 4]
type = HitFallDamage
trigger1 = Time = 0

[State 15110, 5]
type = PosSet
trigger1 = Time = 0
y = 0

[State 15110, Var] ;Get fall velocity
type = VarSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) != 0
sysvar(1) = floor(vel y)

[State 15110, 6]
type = PlaySnd
trigger1 = Time = 0
trigger1 = !SysVar(0)
value = F7, (sysvar(1) > Const720p(20)) + (sysvar(1) > Const720p(56))

;[State 15110, 7]
;type = Null
;trigger1 = Time = 0
;trigger1 = !SysVar(0)
;anim = F(60 + (sysvar(1) > Const720p(20)) + (sysvar(1) > Const720p(56)))
;pos = 0, 0
;sprpriority = Cond (sysvar(1) <= Const720p(56), -10, 10)

[State 15110, 8]
type = VelSet
trigger1 = Time = 0
y = 0

[State 15110, 9] ;For hit up type
type = ChangeAnim
persistent = 0
triggerall = anim = [5171,5179]
triggerall = SelfAnimExist(5111)
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground anim
value = 5111

[State 15110, 10] ;For normal
type = ChangeAnim
persistent = 0
triggerall = Anim != [5111,5119]
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
value = 5110

[State 15110, 11] ;If just died
type = ChangeState
triggerall = !alive
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
trigger3 = Anim = [5110,5119]
value = 5150

[State 15110, 12]
type = VarSet
trigger1 = SysVar(0)
trigger1 = Time = 0
sysvar(0) = 0

[State 15110, 13] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 15110, 14] ;Friction
type = VelSet
trigger1 = abs(Vel x) < Const(movement.down.friction.threshold)
persistent = 0
x = 0

[State 15110, 15]
type = ForceFeedback
trigger1 = alive
trigger1 = Time = 0
time = 8
ampl = 240
waveform = sine

[State 15110, 16]
type = ForceFeedback
trigger1 = !alive
trigger1 = Time = 0
ampl = 200, 7, -.467
time = 30
waveform = sine

[State 15110, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 5120
ctrl = 0

;---------------------------------------------------------------------------
; Downed get-hit (getting up)
[Statedef 15120]
type    = L
movetype= I
physics = N

[State 15120, 1a] ;Get up anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim != [5111,5119]
trigger2 = !SelfAnimExist(5120 + (anim % 10))
value = 5120

[State 15120, 1b] ;Get up anim (for hit up/diag-up)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim = [5111,5119]
trigger1 = SelfAnimExist(5120 + (anim % 10))
value = 5120 + (anim % 10)

[State 15120, 2]
type = VelSet
trigger1 = Time = 0
x = 0

[State 15120, 3]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 15120, 4]
type = HitFallSet
trigger1 = AnimTime = 0
value = 1

[State 15120, 5] ;Can't be thrown right after getting up
type = NotHitBy
trigger1 = AnimTime = 0
value = , NT,ST,HT
time = 12

[State 15120, 6] ;Can't be hit right after getting up (short time)
type = NotHitBy
trigger1 = AnimTime = 0
value2 = SCA
time = 3

[State 15120, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1