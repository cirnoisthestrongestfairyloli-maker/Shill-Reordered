; Common state file for M.U.G.E.N 1.0
;
; System variables usage
; ----------------------
; Var name    Type   Purpose
; --------    ----   -------
; sysvar(0)   Temp   Set by state 5081 (HITL_SLIDE) to 1 to prevent
;                    showing ground hit frame in state 5110 (HIT_LIEDOWN).
;                    Used by guarding states.
; sysvar(1)   Temp   Used by state 40 (Jump Start) amd 45 (Air Jump Start)
;                    to keep track of which way to jump.
;                    Used by state 5100 and 5110 to remember downward
;                    velocity of player just before hitting the ground.
;                    Used in state 5080 for storing the anim # to display.

; The following states have special handling within MUGEN, and should be
; overridden with caution:
; Jump Start (40): airjumping bookkeeping at time = 0
; All guard states (120-155): guard handling throughout state
; Hit_trip, shaking (5070): defense increases at time = 0
; Downed get-hit (hit ground from fall) (5100):
;   defense increases at time = 0, player becomes invincible if within 10
;   ticks of getting up
; Hit_liedown (5110): player changes to get-up state (5120) when ready
; Hit_getup (5120): player's defence is restored to normal at time = 0
; Hitfall_recover (5200): player's defence is restored at time = 0
; Hitfall_airrecover (5210): player's defence is restored at time = 0


;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0


[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2 && anim=0
trigger2 = Time = 4
x = 0

[State 0, CtrlSet]
type = CtrlSet
triggerall = AILevel>0
triggerall = prevstateno = 20
triggerall = roundstate = 2
trigger1 =time = 0
value = 1
[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

[State 10, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State 11, 2] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0
[State 20, 1]
type = VelSet
triggerall = AILevel=0
trigger1 = command = "holdfwd"
x = Cond(PalNo != 11, const(velocity.walk.fwd.x), const(velocity.walk.fwd.x) + 2)

[State 20, 2]
type = VelSet
triggerall = AILevel=0
trigger1 = command = "holdback"
x = Cond(PalNo != 11, const(velocity.walk.back.x), const(velocity.walk.back.x) - 2)

[State 20, 1]
type = VelSet
triggerall = AILevel>0
trigger1 = helper(10003),var(25)
x = Cond(PalNo != 11, const(velocity.walk.fwd.x), const(velocity.walk.fwd.x) + 2)

[State 20, 2]
type = VelSet
triggerall = AILevel>0
trigger1 =!helper(10003),var(25)
x = Cond(PalNo != 11, const(velocity.walk.back.x), const(velocity.walk.back.x) - 2)


[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20


[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21
[State 0, CtrlSet]
type = CtrlSet
triggerall = AILevel > 0
trigger1 = time > 20|| p2bodydist x < 35
value = 1

[State 0, CtrlSet]
type = CtrlSet
triggerall = AILevel > 0
trigger1 = time = 0
value = 0
[State 0, ChangeState]
type = ChangeState
trigger1 = vel x =0
value =0
ctrl = 1


;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
movetype = I
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1
movehitpersist = 1

[State 40, VarSet]
type = VarSet
triggerall = AILevel = 0
trigger1 = command = "ar_btn_a"
var(19) = 600
ignorehitpause = 1

[State 40, VarSet]
type = VarSet
triggerall = AILevel = 0
trigger1 = command = "ar_btn_b"
trigger1 = Var(19) = 0
var(19) = 610
ignorehitpause = 1

[State 40, VarSet]
type = VarSet
triggerall = AILevel = 0
trigger1 = command = "ar_btn_c"
trigger1 = Var(19) = 0
var(19) = 620
ignorehitpause = 1

[State 40, VarSet]
type = VarSet
triggerall = AILevel = 0
trigger1 = command = "ar_btn_x"
trigger1 = Var(19) = 0
var(19) = 630
ignorehitpause = 1

[State 40, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA, AT 

[State 40, Superjump VarSet]
type = VarSet
triggerall = !Time
trigger1 = PrevStateNo = 100
trigger2 = AILevel != 0 && RoundState = 2
trigger2 = EnemyNear, Pos Y < -200
trigger3 = AILevel != 0 && PrevStateNo = [200,421] 
trigger3 = EnemyNear, Pos Y < -200
var(5) = Cond(PrevStateNo = 100 || AILevel!= 0, 1, 0)

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = AILevel = 0
trigger1 = command = "holdfwd"
trigger2 = AILevel != 0 && RoundState = 2
trigger2 = P2BodyDist X > 0
trigger2 = FrontEdgeBodyDist > 30
trigger3 = AILevel != 0 && RoundState = 2
trigger3 = P2BodyDist X > 0
trigger3 = PrevStateNo = [200,620]
trigger3 = MoveHit
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = AILevel = 0
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
triggerall = PalNo != 11
trigger1 = AnimTime = 0
x = Cond(sysvar(1)=0, const(velocity.jump.neu.x), Cond(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 4]
type = VelSet
triggerall = PalNo = 11
trigger1 = AnimTime = 0
x = Cond(sysvar(1)=0, const(velocity.jump.neu.x), Cond(sysvar(1)=1, const(velocity.jump.fwd.x) + 2, const(velocity.jump.back.x) - 2))
y = const(velocity.jump.y) - 2

[State 40, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

[State 40, 6]
type = ChangeState
trigger1 = Helper(10003),var(30)=0 &&Time = 0  && AILevel>0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45, VarSet]
type = VarSet
trigger1 = 1
var(5) = 0

[State 45, VarSet]
type = VarSet
trigger1 = !Time
var(6) = 1

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = AILevel = 0
trigger1 = command = "holdfwd"
trigger2 = AILevel != 0 && RoundState = 2
trigger2 = P2BodyDist X > 0
trigger2 = FrontEdgeBodyDist > 30
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = AILevel = 0
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
triggerall = PalNo != 11
trigger1 = Time = 1
x = Cond(sysvar(1)=0, const(velocity.jump.neu.x), Cond(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 45, 6]
type = VelSet
triggerall = PalNo = 11
trigger1 = Time = 1
x = Cond(sysvar(1)=0, const(velocity.jump.neu.x), Cond(sysvar(1)=1, const(velocity.jump.fwd.x) + 2, const(velocity.jump.back.x) -2))
y = const(velocity.jump.y) - 1

[State 45, 7]
type = ChangeState
trigger1 = Time = 1
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, ChangeState]
type = ChangeState
trigger1 = var(19) != 0
value = var(19)
ctrl = 0

[State 50, VelAdd]
type = VelAdd
triggerall = Time < 5
trigger1 = Var(5) = 1 
x = Cond(Vel X = 0, 0, Cond (Vel X > 0, 0.5, -0.5))
y = -0.4

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = Cond((vel x)=0, 41, Cond((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 41 && anim <= 43
persistent = 0
value = Anim + 3

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = Cond((vel x)=0, 41, Cond((vel x)>0, 42, 43))

[State 50, 2]
type = ChangeAnim
triggerall = Var(5) = 1
trigger1 = Time = 0
value = Cond((vel x)=0, 61, Cond((vel x)>0, 62, 63))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 41 && anim <= 43
persistent = 0
value = Anim + 3

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0
;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 51]
type    = A
physics = A

[State 51, 1]
type = Null
trigger1 = 1

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47
facep2 = 1

[State 52, 1]
type = VelSet
trigger1 = !Time
y = 0

[State 52, 2]
type = PosSet
trigger1 = !Time
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 1
value = 1

[State 52, 4]
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
x = 0

[State 52, end]
type = ChangeState
trigger1 = AnimTime = 0
value = Cond(Anim=47&&command="holddown",11,0)
ctrl = 1
;-----------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type = S
movetype = I
physics = N
anim = 100
sprpriority = 1
ctrl = 0

[State 100, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 4
value = S100,0
volumescale = 200
channel = 1
freqmul = 1.0
loop = 0
pan = 0

[State 100, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 8
value = S100,1
volumescale = 200
channel = 2
freqmul = 1.0
loop = 0
pan = 0

[State 100, 1]
type = VelSet
trigger1 = AnimElemTime(3) >= 0
x = Cond(PalNo != 11, const(velocity.run.fwd.x), const(velocity.run.fwd.x) + 2)

[State 100, 2] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 3]
type = ChangeState
trigger1 = AILevel = 0 && AnimElemTime(3) > 0 && command = "up"
value = 40
ctrl = 0

[State 100, end]
type = ChangeState
trigger1 = AILevel = 0 && AnimElemTime(5) > 0 && command != "holdfwd"
value = 101
ctrl = 0
;---------------------------------------------------------------------------
[Statedef 101]
type    = S
movetype = I
physics = N
anim = 101
sprpriority = 1
ctrl = 0
velset = 0,0

[State 101, PosSet]
type = PosSet
trigger1 = 1
y = 0

[State 101, end]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------
; Hop backwards
[Statedef 105]
type = S
movetype = I
physics = S
ctrl = 0
anim = 105
sprpriority = 1

[State 105, 1]
type = VelSet
trigger1 = AnimElem = 4
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = AnimElemTime(4) = 2
statetype = A
physics = A

[State 105, end]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 106

;---------------------------------------------------------------------------
; Hop backwards (land)
[Statedef 106]
type    = S
physics = S
ctrl = 0
anim = 106

[State 106, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 106, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 106, CtrlSet]
type = CtrlSet
trigger1 = Time = 1
value = 1

[State 106, end]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Air Dash Fwd
[Statedef 110]
type    = A
physics = N
anim = 110
sprpriority = 1
ctrl = 0
velset = 0,0
movehitpersist = 1

[State 110, Explod]
type = Explod
trigger1 = Vel X != 0
anim = 10110
ID = 10110
pos = 0,-30
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = 1
vel = 0,0
accel = 0,0
random = 0,0
removetime = -2
pausemovetime = 0
scale = 0.5, 0.5
sprpriority = 0
ontop = 1
shadow = 0,0,0
ownpal = 1
removeongethit = 1
persistent = 0

[State 110, PlaySnd]
type = PlaySnd
