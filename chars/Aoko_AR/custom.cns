;---------------------------------------------------------------------------
; Stand Light Punch
; CNS difficulty: easy
[Statedef 50201]
type    = A
movetype= H
physics = N
velset = 0,0
facep2=1


[State 0, PosAdd]
type = PosAdd
trigger1 = time=0 && enemy,var(11)
y = -const(size.mid.pos.y)-10
 ;5051 - 4 + type
[State 0, Turn]
type = Turn
trigger1 =facing=enemy,facing
;ignorehitpause = 
;persistent = 


[State 5020, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0 && selfanimexist(5030)
value = 5030
[State 5020, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim2
trigger1 = Time = 0 && !selfanimexist(5030)
value = 5030
[State 5020, 5]
type = ChangeState
trigger1 = HitShakeOver
value = 50202
;---------------------------------------------------------------------------
; HITA_UP (initial going up)
[Statedef 50202]
type    = A
movetype= H
physics = N
ctrl = 0
[State 5020, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0 && selfanimexist(5061)
value = 5061
[State 5050, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = Time = 0 && !selfanimexist(5061)
value = 5050
[State 5030, 1]
type = VelAdd;Gravity
triggerall = prevstateno!=10003
trigger1 = time>0
y = GetHitVar(yaccel)
[State 5030, 1]
type = VelAdd;Gravity
triggerall = prevstateno=10003
trigger1 = time>0
y =.47
[State 5030, 2]
type = HitVelSet
triggerall = prevstateno!=10003
trigger1 = Time = 0
x = 1
y = 1

[State 5030, 2]
type = VelSet
triggerall = prevstateno=10003
trigger1 = Time = 0
x = -.75
y = -6

[State 5035, 4]
type=selfState
triggerall = time>2
trigger1= Pos Y >= Const240p(35)
value = 5100 ;HITA_FALL

[State 0, SelfState]
type = SelfState
triggerall = alive 
triggerall =canrecover && HitOver  && (time>gethitvar(hittime)) 
trigger1 = command="recovery"
trigger2= AIlevel >0 && random <100*AILevel
trigger3 = var(16) = 1&& p1name="Training"
value =5210
;ctrl =
;ignorehitpause = 0
;persistent = 1

[State 5030, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 50203 ;HITA_UP (transition)

;---------------------------------------------------------------------------
; HITA_UP_T (transition)
[Statedef 50203]
type    = A
movetype= H
physics = N

[State 5035, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5061)
trigger1 = Anim != [5051,5059] ;Not if in hit up anim
trigger1 = Anim != 5090 ;Not if hit off ground anim
value = 5061

[State 5035, 2]
type = VelAdd
trigger1 = time>0
y = GetHitVar(yaccel)



[State 5035, 4]
type=selfState
triggerall = time>2 
trigger1 = Pos Y >=35;.
value = 5100 ;HITA_FALL


[State 0, SelfState]
type = SelfState
triggerall = alive 
triggerall =canrecover && HitOver  && (time>gethitvar(hittime)) 
trigger1 = command="recovery"
trigger2= AIlevel >0 && random <100*AILevel
trigger3 = var(16) = 1&& p1name="Training"
value =5210

