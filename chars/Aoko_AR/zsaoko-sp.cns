; A Aoko Moonsault
[StateDef 1005]
type = S
movetype = A
physics = N
velset = 0,0
ctrl = 0
anim = 1005
poweradd = Cond(var(59) = 0, 50, 0)
sprpriority = 2
facep2 = 1

[State 1005, VelSet]
type = VelSet
trigger1 = AnimElem = 2
x = 2

[State 1005, NotHitBy]
type = NotHitBy
trigger1 = AnimElemTime(6) < 0
value = SCA

[State 1005, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 3
value = S1005, 1
volumescale = 100
channel = 1
ignorehitpause = 1

[State 1005, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 3
value = S5,11
volumescale = 100
channel = 2
ignorehitpause = 1

[State 1005, Explod]
type = Explod
trigger1 = AnimElem = 4
anim = 11005
ID = 11005
pos = 20,-30
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = -1
removetime = -2
pausemovetime = 0
scale = 0.5, 0.5
sprpriority = 3
shadow = 0,0,0
ownpal = 1
removeongethit = 0
ignorehitpause = 1

[State 1005, StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 5
statetype = A

[State 1005, VelSet]
type = VelSet
trigger1 = AnimElem = 5
y = -4

[State 1005, 1]
type = HitDef
trigger1 = AnimElemTime(5) >= 0
attr = A, SA
damage = floor(70*fvar(20)),15
animtype = Heavy
guardflag = MA
hitflag = MAF
priority = 4, Hit
pausetime = 5,5
sparkno = S10001
guard.sparkno = S10130
sparkxy = -20, -70
hitsound = S5, 2
guardsound = S6, 0
ground.type = Low
ground.slidetime = 18
ground.hittime = 18 + Cond(var(21) = 0, 0, 4) 
ground.velocity = -2.5, -9.5
air.animtype = Back
air.velocity = -2.5, -9.5
air.hittime = Cond(14 - var(30) < 0, 7, 14 - var(30)) + Cond(var(21) = 0, 0, 4)
fall = 1
fall.recovertime = Cond(var(36) = 0, 44, var(36)) + Cond(var(21) = 0, 0, 4)
yaccel = 0.5
palfx.time = 30
palfx.add = 100,100,180
palfx.mul = 256,256,256
palfx.sinadd = -80,-80,-80,10
palfx.invertall = 1
palfx.color = 0
persistent = 0 
ground.cornerpush.veloff = 0
id = StateNo
getpower = Cond(var(59) = 0, 50, 0)
givepower = 50
fall.yvelocity = 0
id = 1005

[State 1005, VelAdd]
type = VelAdd
trigger1 = AnimElemTime(7) >= 0
x = -0.01
y = 0.55

[State 1005, StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 9
movetype = I

[State 1005, Untech Proration]
type = VarAdd
triggerall = MoveHit
trigger1 = NumTarget(StateNo)
var(36) = 4
persistent = 0

[State 1005, ChangeState]
type = ChangeState
triggerall = Vel Y > 0
trigger1 = Vel Y > -Pos Y
value = 1008
ctrl = 0

