trigger1 = !Time
name = "Super FX" 
ID = 30000
stateno = 30000 
pos = -30, -85
postype = p1    ;p2,front,back,left,right
pausemovetime = 999
ownpal = 1
scale = 0.25, 0.25

[State 3000, NotHitBy]
