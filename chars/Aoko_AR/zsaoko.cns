;== Reversals ==

[State -2, Reversals Allowed]
type = VarSet
;trigger1 = StateNo = 15110 && Time >= 15; Can reversal after the first 15 frames of liedown
trigger1 = StateNo = 5120 && Time >= 17 ; Can reversal after the first 18 frames of wakeup
trigger2 = StateNo = 5201 && AnimTime >= -10 ; Can reversal during the last 10 frames of recovery roll
var(44) = 1
ignorehitpause = 1
persistent = 0

;[State -2, Reversal Explod]
;type = Explod
;triggerall = StateNo = [1000,3999]
;triggerall = MoveType = A
;triggerall = NumExplod(6005) = 0
;trigger1 = var(44)
;anim = F(IfElse(TeamSide = 1,6005,6006))
;ID = 6005
;pos = IfElse(TeamSide = 1, 10, 275),90
;postype = left  ;p2,front,back,left,right
;facing = 1
;vfacing = 1
;bindtime = -1
;vel = 0,0
;accel = 0,0
;random = 0,0
;removetime = -2
;scale = 0.5, 0.5
;sprpriority = 0
;ontop = 1
;shadow = 0,0,0
;ownpal = 1
;removeongethit = 0
;supermovetime = 999
;pausemovetime = 999

[State -2, Reversals Disallowed]
type = VarSet
trigger1 = (StateNo = [150,155]) && !Time ; Cannot reversal immediately after entering blockstun
trigger2 = StateNo < 120 && var(44) = 1 && Time > 10 ; Cannot reversal after 10 frames have passed in an idle state
trigger3 = StateNo = 5120 && Time < 10 ; Cannot reversal after the first 10 frames of wakeup
trigger4 = StateNo = 5201 && AnimTime < -10 ; Cannot reversal before 10 frames of recovery roll
var(44) = 0
ignorehitpause = 1
persistent = 0

[State -2, Reversals Reset]
type = VarSet 
triggerall = var(44) = 1
trigger1 = StateNo = [200,3999]
trigger2 = StateNo = 5000 || StateNo = 5010 || (StateNo = [5030,5090])
trigger3 = StateNo = 0
var(44) = 0

;==

[State -2, Custom State]
type = TargetState
triggerall = StateNo != [3020,3025]
triggerall = MoveType = A && NumTarget(StateNo)
trigger1 = P2StateType= A && movehit = 1 && (P2StateNo!=[55020,55035])
value = 55020
ID = StateNo
ignorehitpause = 1 

[State -2, Force Fall Custom State]
type = TargetState
triggerall = MoveType = A &&  NumTarget(55050)
triggerall = Target, HitShakeOver = 1
trigger1 = P2StateType = A && movehit = 1 && (P2StateNo!=[55020,55035])
value = 55050
id = 55050
ignorehitpause = 1 


[State -2, Ground Bounce Custom State]
type = TargetState
triggerall = MoveType = A &&  NumTarget(55051)
triggerall = Target, HitShakeOver = 1
trigger1 = P2StateType = A && movehit = 1 && (P2StateNo!=[55020,55035])
value = 55051
id = 55051
ignorehitpause = 1 
;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, PowerSet]
type = PowerSet
trigger1 = PalNo = 12 && var(59) = 0
value = 3000
ignorehitpause = 1
persistent = 1

[State 0, Helper]
type = Helper
triggerall = RoundState = 2
trigger1 =numhelper(10002)=0
name = "Kamekaze's SpAIder"
ID =  10002
stateno = 9998
pos = 61,-37
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 1
size.xscale =1*const(size.xscale)
size.yscale =1*const(size.yscale)
ignorehitpause=1

[State 0, Helper]
type = Helper
triggerall = RoundState = 2
trigger1 =numhelper(10003)=0
name = "Kamekaze's Neutrality"
ID =  10003
stateno = 9999
pos = 61,-37
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 1
size.xscale =1*const(size.xscale)
size.yscale =1*const(size.yscale)
ignorehitpause=1

[State -3, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noairguard

[State -3, AssertSpecial]
type = AssertSpecial
triggerall = RoundState > 2
trigger1 = var(56)
flag = nomusic 

[State -3, ScreenBound]
type = ScreenBound
triggerall = RoundState > 2
trigger1 = var(56)
value = 1
movecamera = 0,0

[State -3, Var(16) Reset]
type = VarSet
triggerall = var(56)
trigger1 = PrevStateNo = 3021 && RoundState < 3
var(56) = 0
ignorehitpause = 1

[State -3, Superjump VarSet]
type = VarSet
triggerall = StateNo != 45
triggerall = PrevStateNo != 45
triggerall = StateType != A
trigger1 = command = "highjump"
var(5) = 1
ignorehitpause = 1
persistent = 1

[State -3, CH Helper]
type = Helper
triggerall = MoveType != H
triggerall = numenemy
triggerall = var(21)
triggerall = StateNo != [190,199] ;Does not activate during intros.
triggerall = StateNo != [800,899] ;Does not activate during throws.
triggerall = NumHelper(10010) = 0
trigger1 = var(21) = 1 && Var(16) = 1 ;Move hit, Ok
name = "Counter FX"
ID = 10010
stateno = 10010
pos = 0,0
postype = p1  
facing = 1
keyctrl = 0
ownpal = 1
ignorehitpause = 1

[State -3, Burst Mode Helper]
type = Helper
triggerall = StateNo = [700,701]
trigger1 = NumHelper(10012) = 0
name = "Burst Mode FX"
ID = 10012
stateno = 10010
pos = 0,0
postype = p1  
facing = 1
keyctrl = 0
ownpal = 1
ignorehitpause = 1

[State -3, Dust]
type = Helper
triggerall = NumHelper(10040) = 0
trigger1 = StateNo = 50 && Time = 1 && PrevStateNo != 45
trigger2 = StateNo = 52 && Time = 1
trigger3 = (Anim = 100 || Anim = 105) && Time = 1
trigger4 = Anim = [1005,1007]
trigger4 = Time = 1
trigger5 = Anim = 3002 && Time = 1
name = "Dust"
ID = 10040
stateno = 10040
pos = 0,0
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 1
persistent = 0

[State -3, Helper]
type = Helper
triggerall = NumHelper(10700) = 0
trigger1 = StateNo = 700 && var(59) = 1
name = "Power Drain" 
ID = 10700
stateno = 10700
pos = 0,0
postype = p1    ;p2,front,back,left,right
pausemovetime = 0
ownpal = 1
scale = 1,1
persistent = 0

[State -3, Superjump Var Reset]
type = VarSet
trigger1 = stateno = 52
trigger2 = MoveType = H
trigger3 = StateNo != [40,50] 
trigger3 = Time = 1
var(5) = 0
ignorehitpause = 1
persistent = 1

[State -3, CornerPush Disabled]
type = VarSet
triggerall = Vel X = 0
triggerall = Vel Y = 0
trigger1 = NumHelper(30000) = 1
trigger2 = NumHelper(30001) = 1
trigger3 = NumHelper(30002) = 1
trigger4 = StateNo = [3000,3050]
var(10) = 2

[State -3, Standard Victory Quote]
type = VictoryQuote
triggerall = NumEnemy
trigger1 = !WinPerfect
value = (Random%10)

[State -3, Perfect Victory Quote]
type = VictoryQuote
triggerall = NumEnemy
trigger1 = WinPerfect
trigger1 = EnemyNear, Name != "ZSAoko"
trigger1 = EnemyNear, Name != "ZSShiki"
value = 10

[State -3, Mirror]
type = VictoryQuote
triggerall = NumEnemy
trigger1 = EnemyNear, Name = "ZSAoko"
value = 20

[State -3, Vs. ZSShiki]
type = VictoryQuote
triggerall = NumEnemy
trigger1 = EnemyNear, Name = "ZSShiki"
value = 21

;== Jump Cancel / Airdash Cancel Detection ==

[State -3, Jump Cancel Variable Set]
type = VarSet
triggerall = MoveType = A 
triggerall = Var(16) = [1,2] ; Move must make contact
trigger1 = StateNo = 200
trigger2 = StateNo = 210
trigger3 = StateNo = 421
trigger4 = StateNo = 430
trigger5 = StateNo = 600 && var(6) = 0
trigger6 = StateNo = 610 && var(6) = 0
trigger7 = StateNo = 630 && var(6) = 0
var(8) = 1
ignorehitpause = 1

[State -3, Jump Cancel Reset]
type = VarSet
trigger1 = Time = 1
trigger2 = MoveType = H
trigger3 = Anim = 47
trigger4 = var(6) = 1 || var(7) = 1
trigger5 = MoveType = I
var(8) = 0
ignorehitpause = 0

;= Invul State Check

;== Hit Detection ==

[State -3, Var(16) MoveHit]
type = VarSet
triggerall = !IsHelper
trigger1 = MoveHit
var(16) = ifElse(MoveHit, 1, 3)
ignorehitpause = 1

[State -3, Var(16) Move/Projectile Guarded/Reversed]
type = VarSet
triggerall = !IsHelper
trigger1 = MoveGuarded
trigger2 = ProjGuarded = 1
trigger3 = MoveReversed
var(16) = ifElse((MoveGuarded||MoveReversed),2,4)
ignorehitpause = 1

[State -3, Var(16) Reset]
type = VarSet
trigger1 = Time = 1
trigger2 = MoveType = I
trigger3 = MoveType = H 
var(16) = 0
ignorehitpause = 1


;== Special/Super Cancel Detection ==

[State -3, Special Cancel Variable Set]
type = VarSet
triggerall = MoveType = A
triggerall = StateNo = [200,630] 
triggerall = Var(18) < 5 ; Applies to normals and command moves only
triggerall = Var(16) = [1,2] ; Move must make contact
trigger1 = StateNo != [222,224] ;Excludes 6ABC combo moves
var(17) = 1
ignorehitpause = 1

[State -3, Super Cancel Variable Set (Specials and EX Specials]
type = VarSet
triggerall = MoveType = A
triggerall = Var(18) = [5,6] ;Applies to Specials and EX Specials only
trigger1 = Var(16) = [1,2]
var(17) = 2
ignorehitpause = 1

[State -3, Super Cancel Variable Set (Lv. 1 Supers)]
type = VarSet
triggerall = MoveType = A
triggerall = Var(18) = 7 && StateNo < 3010 ;Applies to Specials and EX Specials only
triggerall = Var(59) = 1
trigger1 = Var(16) = [1,2]
var(17) = 3
ignorehitpause = 1

[State -3, Cancel Variable Reset]
type = VarSet
trigger1 = Var(16) = 0
trigger2 = StateNo = [800,899]
trigger3 = StateNo = 700
var(17) = 0
ignorehitpause = 1

