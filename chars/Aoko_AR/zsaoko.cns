ignorehitpause = 1

;== 
;Damage Dampening System

[State -3, Hit Count Add]
type = VarAdd
triggerall = NumEnemy
triggerall = HitDefAttr != SCA, AT
trigger1 = MoveHit = 1
var(20) = 1
persistent = 0

[State -3, Hit Counter Reset]
type = VarSet
triggerall = NumEnemy
trigger1 = EnemyNear, MoveType != H
var(20) = 0
ignorehitpause = 0
persistent = 0

[State -3, Decay Set]
type = VarSet
triggerall = NumEnemy
trigger1 = 1
fvar(20) = 1 - .05 * var(20)
ignorehitpause = 1
persistent = 1

[State -3, Minimum Multiplier Calculation (Normals/Specials)]
type = VarSet
triggerall = NumEnemy
triggerall = StateNo = [200, 3000)
triggerall = Enemy,GetHitVar(HitCount) > 0
triggerall = fvar(20) <=  0.3
trigger1 = 1
fvar(20) = 0.3
ignorehitpause = 1

[State -3, Minimum Multiplier Calculation (Supers)]
type = VarSet
triggerall = NumEnemy
triggerall = StateNo = [3000,3010)
triggerall = Enemy,GetHitVar(HitCount) > 0
triggerall = fvar(20) <=  0.5
trigger1 = 1
fvar(20) = 0.5
ignorehitpause = 1

[State -3, Minimum Multiplier Calculation (NEOMAX)]
type = VarSet
triggerall = NumEnemy
triggerall = StateNo = [3010,3025] 
triggerall = Enemy,GetHitVar(HitCount) > 0
triggerall = fvar(20) <= 0.6
trigger1 = 1
fvar(20) = 0.6
ignorehitpause = 1

