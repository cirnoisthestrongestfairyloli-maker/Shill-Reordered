;---------------------------------------------------------------------------
; Introduction
[Statedef 191]
type = S
ctrl = 0
anim = 191
velset = 0,0

[State 190, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 191

[State 191, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 2
value = S191, Random % 5
volumescale = 200

[State 191, Helper]
type = Helper
trigger1 = AnimElem = 19
name = "Suitcase"
ID = 10191
stateno = 10191
pos = 0,0
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 0
supermovetime = 0
pausemovetime = 0

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 3] ;Change to stand state
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, Debug]
type = DisplayToClipboard
trigger1 = 1
text = "Pos Y = %d, P2BodyDist X = %d, P2Dist Y = %d, Cancel Type = %d"
params = Floor(Pos Y), Floor(P2Dist X), Floor(P2Dist Y), var(17)

[State -2, P2 Facing]
type = targetfacing
trigger1 = movecontact = 1 && numtarget = 1
trigger1 = !(target,hitshakeover) && !(target,hitfall) && (target,time <= 1)
value = ifelse(p2dist x>= 0, -1, 1)
ignorehitpause = 1


[State -2, Throws Disallowed]; Resets condition every tick to check again
type = VarSet
trigger1 = 1
var(0) = 0

[State -2, Throws Disallowed]
type = VarSet
triggerall = NumEnemy
triggerall = RoundState = 2
trigger1 = P2Stateno = [150,155]
trigger2 = P2MoveType = H || P2StateType = L
trigger3 = (P2StateNo = [5020,5040]) && !(enemynear,hitfall)
trigger4 = ((P2StateNo = 0) || (P2StateNo = 52)) && (enemynear,prevstateno = [5000,5040]) && ((enemynear,time <= 0) || !(enemynear,ctrl))
trigger5 = (P2StateNo = 0) && (enemynear,prevstateno = 52) && ((enemynear,time <= 0) || !(enemynear,ctrl))
trigger6 = (P2StateNo = 40) && (enemynear,time>= 1 || enemynear,prevstateno = 0 || enemynear,prevstateno = 52)
trigger7 = MoveType = H
trigger8 = abs(P2Dist X) > 50
trigger9 = StateType != S && StateType != C
var(0) = 1

[State -2, Air Throws Disallowed]; Resets condition every tick to check again
type = VarSet
trigger1 = 1
var(1) = 0

[State -2, Air Throws Disallowed]
type = VarSet
triggerall = NumEnemy
triggerall = RoundState = 2
trigger1 = (enemynear,stateno = [150,155])
trigger2 = EnemyNear, StateType != A 
trigger3 = (enemynear,stateno = [5020,5040]) && !(enemynear,hitfall)
trigger4 = ((enemynear,stateno = 0) || (enemynear,stateno = 52)) && (enemynear,prevstateno = [5000,5040]) && ((enemynear,time <= 0) || !(enemynear,ctrl))
trigger5 = (enemynear,stateno = 0) && (enemynear,prevstateno = 52) && ((enemynear,time <= 0) || !(enemynear,ctrl))
trigger6 = (enemynear,stateno = 40) && (enemynear,time>= 1 || enemynear,prevstateno = 0 || enemynear,prevstateno = 52)
trigger7 = MoveType = H
trigger8 = StateType = L
trigger9 = EnemyNear,StateType = L
trigger10 = P2BodyDist X != [0,50]
trigger11 = P2Dist Y != [-30,30]
trigger12 = StateType != A
trigger13 = Pos Y >= -30
var(1) = 1

[State -2, Prevent Underground Juggles]
type = targetbind
trigger1 = movehit = 1
trigger1 = numtarget = 1 && numenemy
trigger1 = (target,time <= 1) && (target,ID = enemynear,ID); this is just to prevent Simul issues as usual
trigger1 = !(target,hitshakeover) && (target, hitfall) && (target, pos y>0)
pos = ceil(p2dist x), ceil(-pos y); keeps P2 at the same horizontal distance, but resets his Y position
ignorehitpause = 1


;================================================================================
; ------- KOF Cornerpush System by Vans --------
;===============================================================================
[State -2, Superpause Check]
type = VarAdd
trigger1 = var(10)
var(10) = -1

[State -2, Reset Time counter]
type = VarSet
trigger1 = movecontact = 1
var(11) = 0

[State -2, Accel]
type = VarSet
triggerall = roundstate = 2
triggerall = var(10) <=  0
triggerall = numtarget >= 1
trigger1 = target, hitshakeover
fvar(10) = (target, gethitvar(xvel)*exp((-0.25)*((var(11)))));exp((-0.1886)*((var(11)))))

[State -2, Push]
type = PosAdd
triggerall = roundstate = 2
triggerall = !var(10)
triggerall = numtarget >= 1
triggerall = (target, BackEdgeBodyDist <=  0) || (target, FrontEdgeBodyDist <=  0)
triggerall = target,statetype != L
triggerall = target,statetype != A
trigger1 = Statetype != A
x = ifelse(facing = -1,fvar(10),-fvar(10))

[State -2, Increase]
type = VarSet
triggerall = numtarget >= 1
triggerall = target, hitshakeover
trigger1 = var(10) <=  0
trigger1 = var(11)
var(11) = var(11)+1

[State -2, Time counter]
type = VarSet
trigger1 = !var(11)
trigger1 = fvar(10)
var(11) = 1

[State -2, Freeze Pos During Superpause]
type = PosFreeze
trigger1 = var(10)
value = 1

[State -2, Drop]
type = VarSet
triggerall = fvar(10)
trigger1 = !numtarget
trigger2 = projcontact = 1
trigger3 = movecontact = 1
fvar(10) = 0
ignorehitpause = 1

;================================================================================
; ------- COUNTER HIT by Vans (Based on Sander's Method) --------
;===============================================================================
[State -2, VarSet];Checks if opponent is in attack state
type = VarSet
triggerall = numenemy
trigger1 = enemy, movetype = a
var(21) = 1
ignorehitpause = 1

[State -2, VarSet];This resets the condition if counter not succesful and succesful
type = VarSet
triggerall = numenemy
trigger1 = enemy, movetype = i || var(22) >= 1 ;Enemy is Idle | Counter was Succesful
trigger2 = var(22) > 10 && enemy, movetype = h ;10 ticks passed & enemy is on gethit state
trigger3 = MoveType = I
var(21) = 0
ignorehitpause = 1

[State -2, VarSet];Counter Hit Succesful
type = VarSet
trigger1 = var(21) = 1 && var(16) = 1 ;Counter Check Ok, Move Hit Succesfully.
trigger1 = StateNo != [190,199] ;Does not activate during intros.
trigger1 = StateNo != [800,899]
var(22) = 1
ignorehitpause = 1

[State -2, VarAdd];Counter Hit Timer
type = VarAdd
trigger1 = var(22) >= 1 ;Counter was succesful
var(22) = 1
ignorehitpause = 1

[State -2, VarSet];Counter Hit Reset
type = VarSet
trigger1 = var(22) >= 22 && var(16) = 1;Reset if 22 ticks passed and move hit
trigger2 = p2movetype != h ;Reset if P2 is no longer in gethit state
trigger3 = movetype = h ;Reset if P1 is getting hit
var(22) = 0
ignorehitpause = 1

;[State -2, EnvColor];This will produce a flash a la KOF2K2
;type = EnvColor
;triggerall = MoveType != H
;triggerall = numenemy
;triggerall = var(21)
;triggerall = StateNo != [190,199] ;Does not activate during intros.
;triggerall = StateNo != [800,899] ;Does not activate during throws.
;trigger1 = var(21) = 1 && Var(16) = 1 ;Move hit, Ok
;value = 255,255,255
;time = 1
;under = 1
;ignorehitpause = 1
;persistent = 0

[State -2, Air Jump Var Reset]
type = VarSet
trigger1 = StateNo = 52 || PrevStateNo = 52
trigger2 = MoveType = H
var(6) = 0

[State -2, Air Dash Var Reset]
type = VarSet
trigger1 = StateNo = 52 || PrevStateNo = 52
trigger2 = MoveType = H
var(7) = 0

[State -2, Distance Check Reset]
type = VarAdd
trigger1 = var(26) = 0
var(28) = 0
;== 

[State -3, var(15) = 0 (Enemy Is Not Recovering)]
type = VarSet
triggerall = NumEnemy
trigger1 = EnemyNear, StateNo != 5120
trigger1 = EnemyNear, StateNo != [5200,5210]
var(15) = 0
ignorehitpause = 1
persistent = 0

[State -3, var(15) = 1 (Enemy Is Recovering)]
type = VarSet
triggerall = NumEnemy
trigger1 = EnemyNear, StateNo = 5120
trigger2 = EnemyNear, StateNo = [5200,5210]
var(15) = 1
ignorehitpause = 1

;== Hitstun/Untech Scaling

[State -2, Hitstun Scaling]
type = VarAdd
trigger1 = Enemy, GetHitVar(HitCount) > 1
triggerall = NumEnemy
triggerall = MoveHit = 1
triggerall = EnemyNear, HitFall = 1
trigger1 = var(18) = [1,4]
var(35) = 1
persistent = 0

[State -2, Hitstun Scaling Var Reset]
type = VarSet
triggerall = NumEnemy
trigger1 = P2MoveType != H
var(35) = 0
ignorehitpause = 1
