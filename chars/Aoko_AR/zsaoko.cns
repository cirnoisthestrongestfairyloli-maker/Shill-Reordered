anim = 182
velset = 0,0

[State 182, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 4
value = S181,1
volumescale = 200

[State 182, AssertSpecial]
type = AssertSpecial
trigger1 = Time < 225
flag = roundnotover


