;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
trigger2 = stateno = 106
trigger3 = stateno = [57,58]
value = 40, 0

[State -3, ]
type = PlaySnd
triggerall = time = 0
trigger1 = random <= 499
trigger1 = stateno = [150,152]
value = 151, 0+random%3
channel = 0

[State -3, Special KO]
type = changestate
triggerall = var(34) = 0
trigger1 = !alive
trigger1 = stateno != [5690,5691]
trigger1 = prevstateno != [5690,5691]
value = 5690
ignorehitpause = 1

[State -3, Special KO]
type = changestate
triggerall = var(34) != 0
trigger1 = !alive
trigger1 = stateno != [5690,5691]
trigger1 = prevstateno != [5690,5691]
trigger1 = stateno != 5699 && prevstateno != 5699
value = 5699
ignorehitpause = 1

;Incremental Cornerpush
[State -3, Corner Push Reset]
type= varset
trigger1 = fvar(0)
trigger1 = numtarget
trigger1 = (target,hitover) || (target,gethitvar(hitshaketime) > 0 && target,time <= 0)
trigger2 = stateno = [1000,4000]
fvar(0) = 0

[State -3, Corner Push Initial Velocity]
type = varset
trigger1 = movecontact = 1 && numtarget
fvar(0) = (target,gethitvar(xvel))
ignorehitpause = 1

[State -3, Corner Push]
type = posadd
triggerall = fvar(0)
triggerall = numtarget
triggerall = !hitpausetime && (target,gethitvar(hitshaketime) <= 0)
triggerall = (target,statetype = S || target,statetype = C) && !(target,gethitvar(yvel)) && !(target,hitfall)
trigger1 = target,frontedgebodydist <= abs(target,vel x)
trigger1 = (target,gethitvar(xvel)*target,facing) > 0
trigger2 = target,backedgebodydist <= abs(target,vel x)
trigger2 = (target,gethitvar(xvel)*target,facing) < 0
x = Cond(target,frontedgebodydist <= 0,-1,1)*(target,facing)*(fvar(0)+(fvar(6)*0.075)*facing)

[State -3, Corner Push Friction]
type = varset
trigger1 = numtarget
trigger1 = target,gethitvar(hitshaketime) <= 0
fvar(0) = fvar(0)*0.8

[State -2, Hit Count Reset]
type = varset
trigger1= P2MoveType != H
fvar(6) = 0
ignorehitpause = 1

[State -2, Hit Count Scaling]
type = varset
triggerall = numtarget
trigger1 = target,gethitvar(hitcount)
fvar(6) = target,gethitvar(hitcount)
ignorehitpause = 1

[State -2, Midair Jump Reset]
type = varset
trigger1 = statetype != A
var(6) = 0

;Hitstun Decay
[State -2, Stun Decay Timer]
type = varadd
trigger1 = p2movetype = H
trigger1 = stateno != [800,860]
fvar(10) = ceil(1)

;Hitstun Decay
[State -2, Stun Decay Timer]
type = varadd
trigger1 = p2movetype = H
trigger1 = stateno = [800,860]
fvar(10) = (1.5)

[State -2, Stun Decay Value]
type = varset
trigger1 = fvar(10)
fvar(11) = cond((fvar(10) <= 240),(1),cond((fvar(10) = [240,480]),(0.75),cond((fvar(10) = [480,960]),(0.25),cond((fvar(10) = [961,1200]),(0.1),0))))

[State -2, Stun Decay Timer Reset]
type = varset
trigger1 = p2movetype != H
fvar(10) = 0

[State -2, Stun Decay Value Reset]
type = varset
trigger1 = p2movetype != H
fvar(11) = 1

;Ink's Projectile detection system

[state -2, AI Detect Projectile System]
type = helper
trigger1 = ailevel ;M.U.G.E.N 1.0+
trigger1 = !numhelper(33333333)
name = "AI Detect Projectile System"
ID = 33333333
stateno = 33333333
postype = p1
ownpal = 1
keyctrl = 0
size.xscale = 1.0
size.yscale = 1.0
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1

;Attack Decider

[state -2, ]
type = helper
trigger1 = var(34) != 0
trigger1 = ailevel
trigger1 = !numhelper(9990)
name = "Attack Decider"
ID = 9990
stateno = 9990
postype = p1
ownpal = 1
keyctrl = 0
size.xscale = 1.0
size.yscale = 1.0
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1

;Custom State Detect

[State -3, Custom State Detection]
type = Explod
triggerall = !NumExplod(5999)
trigger1 = numhelper(3959) || numhelper(9883)
anim = 9999
ID = 5999
removetime = 1
ignorehitpause = 1