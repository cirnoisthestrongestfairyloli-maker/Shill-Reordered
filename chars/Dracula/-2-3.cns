;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[statedef -2]

;---------------------------------------------------------------------------
;Boss Attributes
[State -2, NotHitBy]
type = NotHitBy
trigger1 = var(35) <= 1
value = ,AT
time = 1
ignorehitpause = 1
persistent = 1

[State -2, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoStandGuard
flag2 = NoCrouchGuard
flag3 = NoAirGuard
ignorehitpause = 1

[State -2, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn
ignorehitpause = 1

[State -2, AssertSpecial]
type = AssertSpecial
trigger1 = var(45) != 0
flag = timerfreeze
ignorehitpause = 1

[State -2, AssertSpecial]
type = poweradd
trigger1 = roundstate >= 2
value = 9999
ignorehitpause = 1

;Armor
[State -2, HitOverride]
type = HitOverride
triggerall = var(35) <= 1
trigger1 = 1
attr = SCA, AA, AP, AT
stateno = 9500
ignorehitpause = 1

[State -2]
type = varset
triggerall = var(35) = 1
trigger1 = enemynear,stateno = [3900,3999]
;trigger1 = enemy,hitdefattr = SCA,HA,HP,AT
var(35) = 2

[State -2]
type = varset
triggerall = var(35) > 1
trigger1 = enemynear,stateno != [3900,3999]
trigger1 = roundstate = 2
;trigger1 = enemy,hitdefattr = SCA,HA,HP,AT
var(35) = 1

[State -2]
type = varset
triggerall = NumExplod(5999)
triggerall = var(35) > 1
trigger1 = enemynear,movetype != A
var(35) = 1

[State -3, VarSet]
type = VarSet
trigger1 = stateno != [9500, 9501]
var(2) = stateno 
ignorehitpause = 1

[State -3, VarSet]
type = varset
trigger1 = roundstate < 2
var(4) = facing
ignorehitpause = 1

[State -3, Turn]
type = Turn
trigger1 = var(35) <= 1
trigger1 = roundstate >= 2
trigger1 = facing != var(4)
ignorehitpause = 1

;---------------------------------------------------------------------------

[State -2]
type = AssertSpecial
