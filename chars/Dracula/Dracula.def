st2     = Helpers.cns
st3     = -2-3.cns
st4	= Config.txt
stcommon = Dracula_common.cns
sprite  = Dracula.sff
anim    = Dracula.air
sound   = Dracula.snd

[Palette Keymap]
a = 1
b = 2
c = 3
x = 4
y = 5
z = 6
a2 = 7
b2 = 8
c2 = 9
x2 = 10
y2 = 11
z2 = 12

