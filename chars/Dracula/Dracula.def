; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Dracula" 
displayname = "The Dark Lord" 
versiondate = 09,30,2009    
mugenversion = 1.1          
author = "OHMSBY"         
pal.defaults = 1      

[Files]
cmd     = Dracula.cmd
cns     = Dracula.cns
