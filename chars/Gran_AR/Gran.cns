movetype= A
physics = S
juggle  = 4
poweradd= 35
velset = 0,0
anim = 1500
ctrl = 0
sprpriority = 2

[State 0]
type = playsnd
trigger1 = !time
value = 1500,0
channel = 0

;Go directly to attack with the level variable stored.
[State 1500, GBVSR resume stored level]
type = ChangeState
triggerall = !ailevel
trigger1 = !time
trigger1 = var(44) >= 1
value = 1500 + var(44)

[State 610, 2];LV2
type = ChangeState
trigger1 = !time
triggerALL = var(44)=1
triggerall = ailevel
value = 1512

[State 610, 2];LV3
type = ChangeState
trigger1 = !time
triggerALL = var(44)=2
triggerall = ailevel
value = 1513

[State 610, 2];LV4
type = ChangeState
trigger1 = !time
triggerALL = var(44)=3
triggerall = ailevel
value = 1514

[State 610, 2]
type = ChangeState
triggerall = !ailevel
trigger1 = time <= 49
trigger1 = command != "holdx"
value = 1511

[State 610, 2]
type = ChangeState
triggerall = !ailevel
trigger1 = time >= 49
trigger1 = command = "holdx"
value = 1501




;Cancel by pressing A
[State 1300, 6]
type = ChangeState
trigger1 = time >= 25
trigger1 = command = "a" || command = "b" || command = "c" || command = "holdback"  
value = 1510
ctrl = 0

