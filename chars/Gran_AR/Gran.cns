;=================== GBVS Rising moveset (gran_gbvsr.py) ===================
;GBVSR cL: 38 dmg, MA, startup 5, active 3, recovery 6, block 4, hit 8
[Statedef 9100]
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= A                      ;Move-type: A-attack, I-idle, H-gethit
physics = S                      ;Physics: S-stand, C-crouch, A-air
juggle  = 1                      ;Number of air juggle points move takes
velset = 0,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 9100                       ;Change animation (Def: no change)
poweradd = 20                   ;Power to add (Def: 0)
sprpriority = 2                  ;Set p1's sprite layering priority to 2 (in front)

[State 300, Var]
type = varadd
trigger1 = !time
var(30) = -1

[State 1, ]
type = PlaySnd
triggerall = random <= 700
trigger1 = time = 0
value = 200, 0+random%4
channel = 0

[State 300, 1]
type = HitDef
trigger1 = !movecontact && !movereversed
trigger1 = enemynear,movetype != A
attr = S, NA                     ;Attribute: Standing, Normal Attack
damage = 38, 0
animtype = light                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = MA
hitflag = MAF                    ;Flags of conditions that move can hit
priority = 3, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
;Hit/Miss/Dodge type (Def: Hit)
pausetime = 8, 8
sparkno = 0                      ;Spark anim no (Def: set above)
sparkxy = -15, -70             ;X-offset for the "hit spark" rel. to p2,
;Y-offset for the spark rel. to p1
hitsound = S5,2                  ;Sound to play on hit
guardsound = S6, 0                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 16
ground.hittime  = 16
ground.velocity = -1.5             ;Velocity at which opponent is pushed
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -.7,-2           ;X-velocity at which opponent is pushed,
guard.ctrltime = 12
ground.cornerpush.veloff = ifelse(var(46) > 3, -14, -6)
air.cornerpush.veloff = ifelse(var(46) > 3, -8, 0)
air.fall = 1
fall.recovertime = 25
nochainID = 8000
guard.hittime = 12
guard.slidetime = 12
guard.cornerpush.veloff = ifelse(var(46) > 3, -14, -6)
[State 300, 1]
type = HitDef
trigger1 = !movecontact && !movereversed
trigger1 = enemynear,movetype = A
attr = S, NA                     ;Attribute: Standing, Normal Attack
damage = 46, 0
animtype = light                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = MA
hitflag = MAF                    ;Flags of conditions that move can hit
priority = 3, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
;Hit/Miss/Dodge type (Def: Hit)
pausetime = 8, 8
sparkno = 0                      ;Spark anim no (Def: set above)
sparkxy = -15, -70             ;X-offset for the "hit spark" rel. to p2,
;Y-offset for the spark rel. to p1
hitsound = S5,2                  ;Sound to play on hit
guardsound = S6, 0                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 16
ground.hittime  = 16
ground.velocity = -1.5             ;Velocity at which opponent is pushed
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -.7,-2           ;X-velocity at which opponent is pushed,
guard.ctrltime = 12
ground.cornerpush.veloff = ifelse(var(46) > 3, -14, -6)
air.cornerpush.veloff = ifelse(var(46) > 3, -8, 0)
air.fall = 1
fall.recovertime = 25
nochainID = 8000
