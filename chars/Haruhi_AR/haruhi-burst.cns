;---------------------------------------------------------------------------
; Burst (from Kamijo): X+Y+Z (her attack buttons) while being hit. Invincible, blows the opponent away, no damage.
; Recharges in 75 seconds (var(30), counted down in State -1), fresh every round.

[Statedef 720]
type     = S
movetype = I
physics  = N
velset   = 0, 0
ctrl     = 0
facep2   = 1
anim     = ifelse(StateType = A, 9605, 9604)
sprpriority = 3

[State 720, Invincible]
type = NotHitBy
trigger1 = 1
value = SCA

[State 720, Hold pose]
type = ChangeAnim
trigger1 = AnimTime = 0
value = Anim
elem = AnimElemNo(0)

[State 720, Cooldown]
type = VarSet
trigger1 = Time = 0
var(30) = 4500

[State 720, Sound]
type = PlaySnd
trigger1 = Time = 0
value = 9600, 0
volume = 255
channel = -1

[State 720, Voice]
type = PlaySnd
trigger1 = Time = 0
value = 701, 0
channel = 0

[State 720, Flash]
type = PalFX
trigger1 = Time = 0
time = 12
add = 120, 120, 120

[State 720, Shake]
type = EnvShake
trigger1 = Time = 0
time = 12
ampl = 4

[State 720, Attacking]
type = StateTypeSet
trigger1 = Time = 4
movetype = A

[State 720, Done attacking]
type = StateTypeSet
trigger1 = Time = 10
movetype = I

[State 720, Burst cloud ground]
type = Explod
trigger1 = Time = 4
trigger1 = StateType != A
anim = 9670
ID = 9670
pos = 0, 50
postype = p1
bindtime = -1
supermovetime = 9999
pausemovetime = 9999
scale = 1, 1
sprpriority = 3
ownpal = 1
removeongethit = 1
ignorehitpause = 1

[State 720, Burst cloud air]
type = Explod
trigger1 = Time = 4
trigger1 = StateType = A
anim = 9671
ID = 9671
pos = 0, -50
postype = p1
bindtime = -1
supermovetime = 9999
pausemovetime = 9999
scale = 1, 1
sprpriority = 3
ownpal = 1
removeongethit = 1
ignorehitpause = 1

[State 720, Blow away]
type = HitDef
trigger1 = Time = [4, 9]
trigger1 = !MoveContact
attr = S, NA
damage = 0
animtype = Light
guardflag =
hitflag = MAF
priority = 7, Hit
pausetime = 0, 0
sparkno = -1
hitsound = -1
ground.type = High
ground.slidetime = 5
ground.hittime = 12
ground.velocity = -18.4, -5
air.type = High
air.velocity = -18.4, -4
air.hittime = 12
airguard.velocity = -18.9, -0.8
fall = 1
fall.recover = 0
;hard knockdown: no tech, no quick rise
down.recover = 0
down.recovertime = 50
getpower = 0
givepower = 0
ground.cornerpush.veloff = 0

[State 720, End]
type = ChangeState
trigger1 = Time >= 32
value = 0
ctrl = 1

