air.type = Low
ground.hittime = 20
air.hittime = 20
ground.velocity = -10, -3
air.velocity = -6, -4
fall = 1
air.fall = 1
fall.recover = 0
sparkno = s87020
hitsound = S41000, 0

[State 3884, Ending]
type = VarSet
trigger1 = var(2) >= 12
trigger1 = Time % 5 = 4
trigger2 = Time >= 75
trigger3 = RoundState >= 4
var(7) = 1

[State 3884, Full charge: at least 55%]
;tops up whatever the hits did (after attack/defence scaling) to 55% of the opponent's max life, ignoring defence
type = TargetLifeAdd
trigger1 = var(7) = 1
trigger1 = parent,var(4) = 1
trigger1 = var(2) >= 1
trigger1 = NumEnemy
trigger1 = ceil(0.55 * EnemyNear, LifeMax) - (fvar(2) - EnemyNear, Life) > 0
value = -(ceil(0.55 * EnemyNear, LifeMax) - (fvar(2) - EnemyNear, Life))
absolute = 1
kill = 1

[State 3884, Tip off]
type = RemoveExplod
trigger1 = var(7) = 1
ID = 38750

[State 3884, Done]
type = DestroySelf
trigger1 = var(7) = 1

;---------------------------------------------------------------------------
; Kamehameha beam body: stretched from Goku's hands to the head
[Statedef 3885]
type     = A
movetype = I
physics  = N
ctrl     = 0
anim     = 82464
velset   = 0,0
sprpriority = 3

[State 3885, Invincible]
type = NotHitBy
trigger1 = 1
value = SCA

[State 3885, Screen]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0,0

[State 3885, No shadow]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 3885, At the hands]
type = PosSet
trigger1 = 1
x = parent,Pos X + ifelse(parent,var(9), 56, 47) * parent,Facing
y = parent,Pos Y - ifelse(parent,var(9), 72, 58)

[State 3885, Stretch]
type = AngleDraw
trigger1 = NumHelper(3884)
value = -atan((helper(3884),Pos Y - Pos Y) / ifelse(abs(helper(3884),Pos X - Pos X) < 1, 1, abs(helper(3884),Pos X - Pos X))) * 57.2958
scale = (50.0 + ((helper(3884),Pos X - Pos X) ** 2 + (helper(3884),Pos Y - Pos Y) ** 2) ** 0.5) / 58.0, ifelse(parent,var(9), 1.5, 1)

[State 3885, Kaioken beam]
type = PalFX
trigger1 = parent,var(9) = 1
time = 2
add = 120,-30,-40

[State 3885, Gone]
type = DestroySelf
trigger1 = NumHelper(3884) = 0
trigger1 = Time > 5
trigger2 = RoundState >= 4

