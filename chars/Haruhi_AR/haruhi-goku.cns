trigger1 = Time = 0
anim = 81411
postype = p1
pos = 0,-50
scale = 2,2
sprpriority = 2
ownpal = 1
removetime = -2

[State 3870, Teleport snd]
type = PlaySnd
trigger1 = Time = 0
value = 42302, 0

[State 3870, Haruhi KO]
type = ChangeState
trigger1 = root,alive = 0
value = 3881

[State 3870, Charge]
type = ChangeState
trigger1 = Time >= 12
value = 3871

