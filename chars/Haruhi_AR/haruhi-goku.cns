;===========================================================================
; SSJ Goku - Kamehameha summon (random pick from the Flame Haze super, 2424+c, 1100 meter,
; only in the wheel at half life or less; holding c after the input at 25% life with 5 bars = guaranteed, all 5 bars)
; Assets copied from SSJ_GokuZ2 (Team Z2): personal use only.
;   sprites: group 45000 + original (Blue copies: 41000 + original)   anims: 80000 + original (Blue: 90000 + original)
;   sounds: group 40000 + original
;   music: 40500,0 = Chou Super Dragon Soul (karaoke, 26 s, Haruhi channel 5, started in state 3300)
;          40600,k = vocal version starting k seconds in (crossfaded in on a KO, Haruhi channel 6)
;
; Flow: teleport in -> charge 18 s (bar; Haruhi takes up to +10% damage)
;   regular: SSJ -> SSJ3 at 9 s            5-bar (desperation): SSJ -> SSJ3 at 6 s -> Blue at 12 s
;   2424+c again during the charge = fire now (blockable, damage scaled to the charge)
;   bar full = fires on his own, unblockable
;   SSJ / SSJ3: ground Kamehameha     Blue: aerial Super Saiyan Blue Kaioken Kamehameha
;   KO: vocal version, teleports next to Haruhi, back-to-normal win pose with her
;   Haruhi KO'd first: time-over pose     otherwise: teleports away, music fades
;
; Root vars: var(17) charge progress (0-1080), var(16) > 0 fade channel 5, var(18) GameTime the karaoke started,
;            var(19) = 100 desperation summon, fvar(7) = 1 + vocal clip to start
; Helper vars: var(1) beam hit, var(4) full charge (unblockable), var(5) form (0 SSJ, 1 SSJ3, 2 Blue),
;              var(6) GameTime at summon, var(8) desperation, var(9) fire mode (0 ground, 1 air),
;              fvar(0) charge fraction at firing
;===========================================================================

;---------------------------------------------------------------------------
; Goku - teleports in on screen
[Statedef 3870]
type     = S
movetype = I
physics  = N
ctrl     = 0
anim     = 80000
velset   = 0,0
