[State 3884, Aim]
;ground: straight ahead; air (Blue): straight at the opponent
type = VarSet
trigger1 = Time = 0
fvar(1) = ifelse(parent,var(9) && NumEnemy, atan((EnemyNear,Pos Y - 50 - Pos Y) / ifelse(abs(EnemyNear,Pos X - Pos X) < 1, 1, abs(EnemyNear,Pos X - Pos X))), 0)

[State 3884, Life at start]
type = VarSet
trigger1 = Time = 0
trigger1 = NumEnemy
fvar(2) = EnemyNear, Life

[State 3884, Damage per hit]
;full charge: 350 (ground) / 450 (Blue); early: scaled down with the charge
