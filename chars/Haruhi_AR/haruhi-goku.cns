ignorehitpause = 1

[State 3870, Invincible]
type = NotHitBy
trigger1 = 1
value = SCA
ignorehitpause = 1

[State 3870, Screen]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0,0

[State 3870, Hidden]
