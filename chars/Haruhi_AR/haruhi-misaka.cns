;---------------------------------------------------------------------------
; Misaka - hit during the charge: flinch, then run off; Haruhi fades the theme out early
[Statedef 3868]
type     = S
movetype = I
physics  = S
ctrl     = 0
velset   = 0,0
sprpriority = 3

[State 3868, Theme]
type = AssertSpecial
trigger1 = 1
flag = nomusic
ignorehitpause = 1

[State 3868, Invincible]
type = NotHitBy
trigger1 = 1
value = SCA
ignorehitpause = 1

[State 3868, Interrupted flag]
type = VarSet
trigger1 = Time = 0
var(1) = 1
ignorehitpause = 1

[State 3868, Fade theme]
;Haruhi's state -1 fades channel 5 out while var(16) counts up
type = RootVarSet
trigger1 = Time = 0
trigger1 = root,var(16) = 0
var(16) = 1
ignorehitpause = 1

[State 3868, Drop charge fx]
type = RemoveExplod
trigger1 = Time = 0
ID = 3862
ignorehitpause = 1

[State 3868, Drop coin fx]
type = RemoveExplod
trigger1 = Time = 0
ID = 7450
ignorehitpause = 1

[State 3868, Flinch flash]
type = PalFX
trigger1 = Time = 0
time = 12
add = 120,0,0
mul = 256,180,180

[State 3868, Run]
type = ChangeState
trigger1 = Time >= 12
value = 3863

[State 3868, Round over]
type = DestroySelf
trigger1 = RoundState >= 4

