;---------------------------------------------------------------------------
; Misaka - the railgun got the KO: run next to Haruhi, win pose when Haruhi wins
[Statedef 3869]
type     = S
movetype = I
physics  = N
ctrl     = 0
anim     = 50100
velset   = 0,0
sprpriority = 1

[State 3869, Invincible]
type = NotHitBy
trigger1 = 1
value = SCA
ignorehitpause = 1

[State 3869, Screen]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0,0

[State 3869, Target]
;spot beside Haruhi, behind her
type = VarSet
trigger1 = 1
fvar(0) = root,Pos X - 45 * root,Facing

[State 3869, Face the spot]
type = Turn
trigger1 = var(3) = 0
trigger1 = (fvar(0) - Pos X) * Facing < 0

[State 3869, Run]
type = VelSet
trigger1 = var(3) = 0
x = 6.5
y = 0

[State 3869, Arrived]
type = VarSet
trigger1 = var(3) = 0
trigger1 = abs(fvar(0) - Pos X) <= 7
var(3) = 1

[State 3869, Stop]
type = VelSet
trigger1 = var(3) = 1
x = 0
y = 0

[State 3869, Line up]
type = PosSet
trigger1 = var(3) = 1
trigger1 = Anim = 50100
x = fvar(0)
y = 0

[State 3869, Same way as Haruhi]
type = Turn
trigger1 = var(3) = 1
trigger1 = Facing != root,Facing

[State 3869, Stand]
type = ChangeAnim
trigger1 = var(3) = 1
trigger1 = Anim = 50100
value = 50000

[State 3869, Win pose]
type = ChangeAnim
trigger1 = Anim = 50000
trigger1 = (root,StateNo = [180,189]) || RoundState = 4
value = 50181

[State 3869, Win voice]
type = PlaySnd
trigger1 = Anim = 50181
trigger1 = AnimElem = 1
value = 30010, 2
channel = 0
