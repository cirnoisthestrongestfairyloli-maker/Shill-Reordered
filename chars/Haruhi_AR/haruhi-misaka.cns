;===========================================================================
; Misaka Mikoto - Railgun summon (random pick from the Flame Haze super, 2424+b)
; Assets copied from misakaNEW (Bagilu, DidiGetsRekt): personal use only.
;   sprites: group 30000 + original   anims: 50000 + original   sounds: group 30000 + original
; Haruhi side: haruhi-H.cns states 3300/3301 spawn helper 3860 when var(15) = 1
;===========================================================================

;---------------------------------------------------------------------------
; Misaka - jump in from behind Haruhi
[Statedef 3860]
type     = A
movetype = I
physics  = N
ctrl     = 0
anim     = 50042
velset   = 4.5,-4
sprpriority = 3

[State 3860, Theme]
type = AssertSpecial
trigger1 = 1
flag = nomusic
ignorehitpause = 1

[State 3860, Invincible]
type = NotHitBy
trigger1 = 1
value = SCA
ignorehitpause = 1

[State 3860, Offscreen ok]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0,0

[State 3860, Gravity]
type = VelAdd
trigger1 = 1
y = 0.45

[State 3860, Falling anim]
type = ChangeAnim
trigger1 = Vel Y > 0
trigger1 = Anim != 50043
value = 50043

[State 3860, Land]
type = ChangeState
trigger1 = Pos Y >= 0
trigger1 = Vel Y > 0
value = 3861

[State 3860, Round over]
type = DestroySelf
trigger1 = RoundState >= 4

