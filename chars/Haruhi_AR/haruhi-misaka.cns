;---------------------------------------------------------------------------
; Misaka - Railgun (adapted from misakaNEW Statedef 3000)
[Statedef 3862]
type     = S
movetype = A
physics  = S
ctrl     = 0
anim     = 53050
velset   = 0,0
sprpriority = 3

; Charge: no super pause, Misaka can be hit. Hit -> 3868 (runs away, theme fades early).
; Uninterrupted for 85 frames -> 3867 (super pause into the railgun).

[State 3862, Theme]
type = AssertSpecial
trigger1 = 1
flag = nomusic
ignorehitpause = 1

[State 3862, Interrupted]
type = HitOverride
trigger1 = 1
attr = SCA, AA, AP, AT
stateno = 3868
slot = 0
time = 1
ignorehitpause = 1

[State 3862, Start snd]
type = PlaySnd
trigger1 = Time = 0
value = 30100, 2

[State 3862, Voice 1]
type = PlaySnd
trigger1 = Time = 0
value = 30010, 16

[State 3862, Coin]
type = PlaySnd
trigger1 = AnimElem = 2
value = 30100, 1

[State 3862, Spark]
type = PlaySnd
trigger1 = AnimElem = 4
value = 30001, 2

[State 3862, Charge 1]
type = Explod
trigger1 = Time = 4
anim = 54110
ID = 3862
postype = p1
pos = 0,-55
sprpriority = -3
ownpal = 1
supermovetime = 9**8
ignorehitpause = 1

[State 3862, Charge 2]
type = Explod
trigger1 = Time = 4
anim = 54120
ID = 3862
postype = p1
pos = 0,-55
sprpriority = -4
ownpal = 1
supermovetime = 9**8
ignorehitpause = 1

[State 3862, Coin spark]
type = Explod
trigger1 = AnimElem = 4
anim = 57450
ID = 7450
supermovetime = 9**8
postype = p1
pos = 5,-58
ownpal = 1
sprpriority = 1
bindtime = -1
ignorehitpause = 1

;hold the charge pose (loop element 12) until frame 85; the fire state continues from element 13
[State 3862, Hold charge]
type = ChangeAnim
trigger1 = AnimElem = 13
trigger1 = Time < 85
value = 53050
elem = 12

[State 3862, Fire]
type = ChangeState
trigger1 = Time >= 85
value = 3867

[State 3862, Round over]
type = DestroySelf
trigger1 = RoundState >= 4

