;-----------------------------------------------------------------------------
; 卍解
;-----------------------------------------------------------------------------
; 天鎖斬月

[Statedef 3000]
type     = S
movetype = A
physics  = S
juggle   = 0
velset   = 0,0
anim     = 3000
ctrl     = 0
sprpriority = 3
facep2 = 1

[state 1000, VarSet];先行入力初期化
type = varset
trigger1 = time = 0
var(31) = 0

[state 1000, VarSet];先行入力初期化
type = varset
trigger1 = time = 0
var(32) = 0

[State 170, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA

[State 2000, 超必殺技発動の時間停止]
type = SuperPause
trigger1 = time = 0
anim = -1
movetime = 75
time = 75
p2defmul = 1.0
poweradd = -3000

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 1
value = s9,1

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 1
value = s10+(var(15)*10),34
channel = 10

[State 3100, Bankai Super Flash]
type = Explod
trigger1 = time = 0
anim = 10640
ID = 10640
pos = 0, GameHeight - (0)
postype = back
facing = 1
vfacing = 1
bindtime = 1
accel = 0,0
random = 0,0
removetime = -2
supermovetime = 60
pausemovetime = 0
scale = 1
sprpriority = 5
ontop = 1
shadow = 0,0,0
ownpal = 1
removeongethit = 0
ignorehitpause = 1

[state a]
type = varset
trigger1 = Time = 0
v = 38
value = 1

[State 3000, AR Long Bankai cost]
;Abstract Reordered: the C version costs 5 bars (3 come off with the super pause)
type = PowerAdd
trigger1 = Time = 0
trigger1 = var(17) = 2700
value = -2000

[state a]
;Abstract Reordered: 45 s for the C version, 15 s otherwise
type = varset
trigger1 = Time = 70
v = 40
value = ifelse(var(17) = 2700, 2700, 900)

; RF/Shunpo Control
[State -2, RF New Round Reset]
type = VarSet
trigger1 = Time > 70
var(11) = 3

[State -2, Shunpo New Round Reset]
type = VarSet
trigger1 = Time > 70
var(13) = 3

[State 195, 2]
type = ChangeState
triggerall = var(59)
trigger1 = AnimTime = 0
value = 99

[State 195, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; 卍解終了
; CNS レベル: 基本

[Statedef 3010]
type     = S
movetype = I
physics  = S
anim     = 3010
velset   = 0,0
ctrl     = 0
sprpriority = 2

[state a]
type = varset
trigger1 = Time = 0
trigger1 = RoundState = 2
v = 38
value = 0

[state a]
type = varset
trigger1 = Time = 0
v = 39
value = 0

[state a]
type = varset
trigger1 = Time = 0
v = 40
value = 0

[State 195, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;-----------------------------------------------------------------------------
; 卍解中の特殊行動
;---------------------------------------------------------------------------
; RUN_BACK
[Statedef 6105]
type    = S
physics = S
anim = 6105
sprpriority = 1
ctrl = 0

;;;ジャンプはすぐできる
[State 100, jump]
type = ChangeState
triggerall = !var(59)
triggerall = command = "holdup"
Trigger1 = command = "holdfwd"
Trigger2 = command = "holddown"
Trigger3 = command != "holdfwd"
Trigger3 = command != "holddown"
value = 40

[State 100, 1]
type = VelSet
trigger1 = AnimElemTime(2) >= 0
x = -9

[State 191,]
type = PlaySnd
triggerall = time = 4
trigger1 = Alive
value = s5,2

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
triggerall = AnimElemTime(2) >= 0
trigger1 = command != "holdback"
trigger2 = Time >= 30
value = 101

;---------------------------------------------------------------------------
; 立ち弱攻撃

[Statedef 6200]
type     = S
movetype = A
physics  = S
juggle   = 0
velset   = 0,0
ctrl     = 0
anim     = 6200
poweradd = 0
sprpriority = 2
facep2 = 1

[State 6200, AR light count]
;Abstract Reordered: consecutive standing lights (var(43)); blocked 2nd = pushback, blocked 3rd = more pushback and minus
type = VarSet
trigger1 = Time = 0
var(43) = ifelse(prevstateno = 6200, var(43) + 1, 1)

[State 6200, AR pushback]
type = VelSet
trigger1 = MoveGuarded = 1
trigger1 = var(43) >= 2
x = ifelse(var(43) >= 3, -5, -3)

[State 6200, AR minus]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = var(43) >= 3
trigger1 = MoveGuarded
value = 7300

[State 200, 攻撃設定]
type = HitDef
trigger1 = AnimElem = 2
attr = S, HA
damage    = ifelse(var(15),24,16)*var(8),4*var(8)
getpower  = 0
givepower = 10,10
animtype = Light
guardflag = M
hitflag = MAF
priority = 3, Hit
pausetime = 10,10+var(0)
sparkno = s20100+random%4
guard.sparkno = s10040
sparkxy = -10,-ceil(50*Const(size.yscale))
hitsound   = s1,10
guardsound = s2,0
ground.type = High
ground.slidetime = 16
ground.hittime  = 16
ground.velocity = -4
air.velocity = 0,-5
airguard.velocity = 0,0

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 2
value = s10+(var(15)*10),0
channel = 10

[State 200, 効果音]
type = PlaySnd
trigger1 = AnimElem = 2
value = s0,10

[State 200, チェンジ]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

