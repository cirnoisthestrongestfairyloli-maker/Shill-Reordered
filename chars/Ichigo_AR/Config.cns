;---------------------------------------------------------------------------
; AirJump Start
[Statedef 36]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 856, Air Dash Limit]
type = Varadd
trigger1 = Time = 0
var(3) = -1

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44+(6000*var(39))

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41+(6000*var(39))

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = 1
sysvar(1) = 1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 37]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 856, Air Dash Limit]
type = Varadd
trigger1 = Time = 0
var(3) = -1

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44+(6000*var(39))

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41+(6000*var(39))

[State 45, 3]
