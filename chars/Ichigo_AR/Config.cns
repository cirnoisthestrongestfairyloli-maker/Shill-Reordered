;-----------------------------------------------------------------------------
;設定項目
;-----------------------------------------------------------------------------
[Statedef 40000]
anim = 9999
Ctrl = 0

;-----------------------------------------------------------------------------
;本体システム設定
;-----------------------------------------------------------------------------
;MUGENバージョン設定(MUGEN Version Setting)
; var(0) = 0･･･MUGEN 1.0
; var(0) = 1･･･WinMugen
[State 40000, Setting]
Type = parentvarset
Trigger1 = 1
var(0) = 1

;瞬歩の無敵の設定
;　var(1) = 0･･･原作仕様(完全無敵)
;　var(1) = 1･･･アレンジ(対打撃・飛び道具無敵)
[State 40000, Setting]
Type = VarSet
Trigger1 = 1
var(1) = 0

;ガードキャンセル瞬歩・ダメージキャンセルのゲージ消費の設定
;　var(2) = 0･･･原作仕様(GC瞬歩のゲージ消費なし・DCで1ゲージ消費)
;　var(2) = 1･･･アレンジ(GC瞬歩で1ゲージ消費・DCで2ゲージ消費)
[State 40000, Setting]
Type = VarSet
Trigger1 = 1
var(2) = 1

;-----------------------------------------------------------------------------
;AI設定
;-----------------------------------------------------------------------------
;AIレベル設定
;　var(57)の数値を1～8の間で変更して下さい。
;　新Mugenの場合、AILevelでも代用可能です。
;　　1～2････Easy
;　　3～4････Normal
;　　5～6････Hard
;　　7～8････対AI特化
[State 40000, AILV]
Type = parentvarset
trigger1 = !Parent,var(57)
var(57) = 4

;反応速度設定
;　var(56)の数値を1～10の間で変更して下さい。
;　反応速度50F(レベル0)からレベルを1上げるごとに5Fずつ速くなります。10で反応制限なし。
[State 40000, AILV]
Type = parentvarset
trigger1 = !Parent,var(56)
var(56) = 4

;挑発設定
;　var(55)の数値を1(以上)にすると、レベルと反応速度を上げるために挑発を使用してきます。
[State 40000, AItaunt]
Type = parentvarset
trigger1 = 1
var(55) = 0

;-----------------------------------------------------------------------------
;設定項目はここまで。以下はいじらないでください
;-----------------------------------------------------------------------------

[State 6000]
type = AssertSpecial
Trigger1 = 1
flag = NoShadow
flag2 = invisible

[State 6000]
type = NotHitBy
Trigger1 = 1
value = SCA,AA,AT,AP

;[State 6000]
;type = DestroySelf
;trigger1 = RoundState > 1

;-----------------------------------------------------------------------------
; AI用のステート
;-----------------------------------------------------------------------------
; Jump Start
[Statedef 31]
type    = S
physics = S
anim = 40+(6000*var(39))
ctrl = 0
sprpriority = 1

[State 40, NotHitBy]
type = NotHitBy
trigger1 = 1
value = , NT, ST, HT

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = 1
sysvar(1) = 1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

