;-----------------------------------------------------------------------------
[Statedef -2];常時監視ステート(相手に行動を制御されても関係無く常に実行される)
;-----------------------------------------------------------------------------
;-----------------------------------------------------------------------------
;---------------------------------------------------------------------------
;斑鳩製キャラ用：規格判別信号(仮)
;---------------------------------------------------------------------------
;「id = 78411」 = "ikaruga_KOF1"(KOFキャラ用)
;「id = 78412」 = "ikaruga_KOF2"(KOF'98キャラ用)
;「id = 78413」 = "ikaruga_KOF3"(KOF'02UMキャラ用)
;「id = 78421」 = "ikaruga_YATAGARASU"(ヤタガラスキャラ用)
;「id = 78431」 = "ikaruga_BDS"(ブリーチDSキャラ用)

[State -2, Explod]
type = Explod
trigger1 =!numexplod(78431)
anim = 9999
id = 78431
name = "ikaruga_BDS"
sprpriority = 0
postype = p1
pos = 0,-9999
bindtime = -1
removetime = -1
ownpal = 1

;---------------------------------------------------------------------------
;設定用ヘルパー
;---------------------------------------------------------------------------
[State -2, Helper]
Type = Helper
trigger1 = numhelper(40000) = 0
name = "Config"
id = 40000
pos =  0,-9999
postype = left
stateno = 40000
helpertype = normal
sprpriority = 1
keyctrl = 0

;---------------------------------------------------------------------------
; モード判別
;---------------------------------------------------------------------------
[State -2, キャラ判別]
type = VarSet
trigger1 = Name = "Ichigo_InnerHollow"
var(15) = 1

;-----------------------------------------------------------------------------
;イントロ・KO演出
;-----------------------------------------------------------------------------
;ラウンド開始時音楽消去
[State -2, AssertSpecial]
type = AssertSpecial
triggerall = roundno = 1
trigger1 = roundState < 2
flag = NoMusic

;---------------------------------------------------------------------------
[State -2, VarSet]
type = VarSet
trigger1 = 1
var(36) = 0

[State -2, VarSet]
type = VarSet
trigger1 = RoundState = [0,1]
trigger2 = RoundState >= 3
trigger2 =!winko && fvar(36) = 1
trigger3 = numexplod(9910) = 1 || enemy,authorname = "ikaruga" && enemy,numexplod(9910) = 1
var(36) = 1
ignorehitpause = 1

[State -2, VarSet]
type = VarSet
trigger1 = 1
fvar(36) = 0

[State -2, VarSet]
type = VarSet
trigger1 = enemy,authorname = "ikaruga" && enemy,numexplod(78411)
trigger1 = enemy,var(11) = 0
trigger2 = enemy,authorname = "ikaruga" && enemy,numexplod(78412)
trigger2 = enemy,numhelper(9900)
trigger3 = enemy,authorname = "ikaruga" && enemy,numexplod(78413)
trigger4 = enemy,authorname = "ahuron"
trigger4 = p2name != "Oswald" && p2name != "DuoLon" && p2name != "Eiji Kisaragi"
trigger5 = enemy,authorname = "or2=3"
trigger5 = p2name = "IoriXIII" || p2name = "ViceXIII" || p2name = "H-SaikiXIII"
fvar(36) = 1

[State -2, ]
type = AssertSpecial
trigger1 = var(36) = 1
flag = nobardisplay

[State -2, AssertSpecial]
type = AssertSpecial
trigger1 = matchover
trigger1 = winko
flag = nomusic
ignorehitpause = 1

;-----------------------------------------------------------------------------
;カウンターヒット判定
;-----------------------------------------------------------------------------
[State -2, Counter]
type = VarSet
trigger1 = P2MoveType = A
var(6) = 1

[State -2, Counter Time Add]
type = VarAdd
trigger1 = P2MoveType != A
trigger1 = var(6) >= 1
var(6) = 1

[State -2, Counter Time Reset]
type = VarSet
trigger1 = var(6) > 3
var(6) = 0
ignorehitpause = 1

[State -2, EnvColor]
type = EnvColor
triggerall = var(6) >= 1
trigger1 = movehit = 1
persistent = 0
ignorehitpause = 1
time = 2
value = 255,255,255
under = 2

[State -2, カウンターヒット呼出]
type = null;helper
triggerall = Numhelper(10300)=0
triggerall = var(6) >= 1
trigger1 = movehit = 1
name="counter"
id = 10300
pos = 0,0
postype = left
stateno = 10300
helpertype = normal
ownpal = 1
keyctrl = 0
size.xscale = 1
size.yscale = 1
persistent = 0
ignorehitpause = 1
supermovetime = 999
pausemovetime = 999

;---------------------------------------------------------------------------
;瞬歩・RFゲージ
;---------------------------------------------------------------------------
[State -2, Gauge-helper]
;Abstract Reordered: switched back on (draws the Shunpo stock gauge)
type = Helper
trigger1 = numhelper(10500) = 0
id = 10500
name = "RF/Shunpo"
pos = 0,0
postype = p1
stateno = 10500
helpertype = normal
pausemovetime = 99999999
supermovetime = 99999999
keyctrl = 0 
ownpal = 1


; RF/Shunpo Control
[State -2, RF New Round Reset]
type = VarSet
trigger1 = RoundState < 2
var(11) = 3

[State -2, Shunpo New Round Reset]
type = VarSet
trigger1 = RoundState < 2
var(13) = 3

[State -2, RF Recovery]
type = Null;VarSet
triggerall = alive
trigger1 = var(10) < 600
trigger1 = var(11) < 3
var(10) = var(10) + 1

[State -2, RF Stock1]
type = VarSet
trigger1 = var(10) >= 600
trigger1 = var(11) < 3
var(11) = var(11) + 1

[State -2, RF Stock2]
type = VarSet
trigger1 = var(10) >= 600
var(10) = 0

[State -2, RF Stock3]
type = VarSet
trigger1 = var(11) = 3
trigger1 = var(10) != 0
var(10) = 0

[State -2, Shunpo Recovery1]
;Abstract Reordered: one stock every 7 seconds (420 ticks), whatever he's doing
type = VarSet
triggerall = alive
triggerall = fvar(14) < 420
triggerall = var(13) < var(11)
trigger1 = 1
fvar(14) = fvar(14) + 1

[State -2, Shunpo Recovery2]
type = Null;VarSet
triggerall = alive
triggerall = fvar(14) < 600
triggerall = var(13) < var(11)
triggerall = movetype != H
trigger1 = (StateNo = [40,52]) || (StateNo = [110,119]) || ((StateNo = [200,4999]) && (StateNo != [800,803]) && movetype != H)
fvar(14) = fvar(14) + 1.5

[State -2, Shunpo Stock1]
type = VarSet
trigger1 = fvar(14) >= 420
trigger1 = var(13) < var(11)
var(13) = var(13) + 1

[State -2, Shunpo Stock2]
type = VarSet
trigger1 = fvar(14) >= 420
fvar(14) = 0

[State -2, Shunpo Stock3]
type = VarSet
trigger1 = var(13) >= var(11)
trigger1 = fvar(14) != 0
fvar(14) = 0

[State -2, Shunpo Stock4]
type = VarSet
trigger1 = var(13) > var(11)
var(13) = var(11)

;タッグ時に自分がP1
[State -2,v43]
type = Varset
triggerall = Numpartner > 0
triggerall = ID < partner,ID
trigger1 = partner,AuthorName = "ikaruga"
trigger1 = partner,numexplod(78431)
var(37) = 1

;---------------------------------------------------------------------------
; RF攻撃の判定
;---------------------------------------------------------------------------
[State -2, VarSet]
type = VarSet
trigger1 = 1
var(24) = 0

[State -2, VarSet]
type = VarSet
triggerall = enemy,authorname = "ikaruga"
triggerall = enemy,numexplod(78431)
trigger1  = (p2stateno = [1020,1029])
trigger2  = (p2stateno = [1120,1129])
trigger3  = (p2stateno = [1220,1229])
trigger4  = (p2stateno = [1320,1329])
trigger5  = (p2stateno = [1420,1429])
trigger6  = (p2stateno = [1520,1529])
trigger7  = (p2stateno = [1620,1629])
trigger8  = (p2stateno = [1720,1729])
trigger9  = (p2stateno = [1820,1829])
trigger10 = (p2stateno = [1920,1929])
var(24) = 1

[State -2, VarSet]
type = VarSet
triggerall = enemy,authorname = "ikaruga"
triggerall = enemy,numexplod(78431)
trigger1 = p2name = "Byakuya Kuchiki" && (p2stateno = [1000,1099]) ;千本桜
var(24) = 1

;---------------------------------------------------------------------------
;ダメージキャンセル
;---------------------------------------------------------------------------
; Damage Cancel Check to make sure the enemy isn't in a Super
[State -2, Damage Cancel Check 1]
type = VarSet
trigger1 = movetype != H
var(14) = 1

; Damage Cancel Check to make sure the enemy isn't in a Super
[State -2, Damage Cancel Check 3]
type = VarSet
trigger1 = (NumEnemy = 1) && !(enemy(0),HitDefAttr = SCA, HA, HT, HP)
trigger1 = (stateno = 5000) || (stateno = 5010) || (stateno = 5020) || (stateno = 5030) || (stateno = 5080)
trigger1 = time > 1
trigger2 = (NumEnemy > 1)
trigger2 = !(enemy(0),HitDefAttr = SCA, HA, HT, HP) && !(enemy(1),HitDefAttr = SCA, HA, HT, HP)
trigger2 = (stateno = 5000) || (stateno = 5010) || (stateno = 5020) || (stateno = 5030) || (stateno = 5080)
trigger2 = time > 1
var(14) = 1

; Damage Cancel Check to make sure the enemy isn't in a Super
[State -2, Damage Cancel Check 2]
type = VarSet
trigger1 = NumEnemy = 1 && (enemy(0),HitDefAttr = SCA, HA, HT, HP)
trigger1 = movetype = H
trigger1 = !HitOver
trigger2 = (NumEnemy > 1)
trigger2 = (enemy(0),HitDefAttr = SCA, HA, HT, HP) || (enemy(1),HitDefAttr = SCA, HA, HT, HP)
trigger2 = movetype = H
trigger2 = !HitOver
var(14) = 0

;---------------------------------------------------------------------------
;ステート抜け(対戦相手が斑鳩製キャラの場合のみ)
[State -2, Damage Cancel]
type = ChangeState
value = 850
triggerall = var(59) != 1 || var(59) = 1 && var(57) <= 2
triggerall = command = "DC"
triggerall = (helper(40000),var(2) = 0) && power >= 1000 || (helper(40000),var(2) = 1) && power >= 2000
triggerall = alive
triggerall = movetype = H
triggerall = enemy,AuthorName = "ikaruga"
triggerall = var(14) = 1
trigger1 = (stateno = [290,292])
;trigger2 = (stateno = [5600,5609])

;AI用
[State -2, Damage Cancel]
type = ChangeState
value = 850
triggerall = var(59) = 1
triggerall = var(57) >= 1
triggerall = (helper(40000),var(2) = 0) && power >= 1000 || (helper(40000),var(2) = 1) && power >= 2000
triggerall = alive
triggerall = movetype = H
triggerall = RoundState = 2 && enemynear(var(58)),life > 0 && fvar(22) = 0
triggerall = random <= (200 + (var(57) * 100))
triggerall = enemynear(var(58)),MoveType = A
triggerall =!enemynear(var(58)),Ctrl
triggerall = enemynear(var(58)),StateNo != [0,22]
triggerall = enemynear(var(58)),StateNo != [50,52]
triggerall = enemynear(var(58)),StateNo != [100,119]
triggerall = p2bodydist X = [-60,60]
triggerall = enemynear(var(58)),Pos Y - Pos Y = [-60,60]
triggerall = enemy,AuthorName = "ikaruga"
triggerall = (stateno = [290,292]); || (stateno = [5600,5609])
triggerall = var(14) = 1
trigger1 = helper(40000),var(2) = 1
trigger1 = life < 400
trigger1 = random <= 10+(life<100)*100
trigger2 = helper(40000),var(2) = 0
trigger2 = random <= 50+(life<200)*200

;-----------------------------------------------------------------------------
;卍解
;-----------------------------------------------------------------------------
[State -2,MAX-helper]
type = Helper
trigger1 = numhelper(10520) = 0
id = 10520
name = "MAX"
pos = 0,0
postype = p1
stateno = 10520
helpertype = normal
pausemovetime = 99999999
supermovetime = 99999999
keyctrl = 0 
ownpal = 1

[State -2, VarAdd]
type = varadd
trigger1 = var(40) > 0
v = 40
value = -1

[State -2, VarSet]
type = varset
trigger1 = var(40) < 0
trigger2 = RoundState = [0,1]
v = 40
value = 0

;---------------------------------------------------------------------------
[State -2, VarSet]
type = varset
trigger1 = var(40) > 0
v = 39
value = 1

[State -2, VarSet]
type = varset
trigger1 = RoundState = [0,1]
v = 39
value = 0

[State -2, AssertSpecial] ;ガード不可
type = AssertSpecial
trigger1 = var(39)
flag = NoStandGuard
flag2 = NoCrouchGuard
flag3 = NoAirGuard

[State -2, AssertSpecial] ;歩行不可
type = AssertSpecial
trigger1 = var(39)
flag = NoWalk

;-----------------------------------------------------------------------------
;各種補正
;-----------------------------------------------------------------------------
[State -2, VarSet]
type = varset
trigger1 = 1
var(8) = 2
;1：原作火力
;2：アレンジ火力

[State -2, VarSet]
type = varset
trigger1 = 1
fvar(0) = 1.0

[State -2, VarAdd];連続ヒット数記憶
type = varadd
triggerall = enemynear(var(58)),movetype = H
triggerall = stateno != [1000,3999]
trigger1 = movehit = 1
fvar(5) = 1

[State -2, VarAdd];連続ヒット数記憶
type = varadd
triggerall = enemynear(var(58)),movetype = H
triggerall = stateno = [1000,1999]
trigger1 = movehit = 1
fvar(5) = 0.6

[State -2, VarAdd];連続ヒット数記憶
type = varadd
triggerall = enemynear(var(58)),movetype = H
triggerall = stateno = [2000,3999]
trigger1 = movehit = 1
fvar(5) = 0.4

[State -2, VarSet];ヒット数リセット
type = varset
trigger1 = enemynear(var(58)),ctrl || enemynear(var(58)),movetype != H
trigger2 = roundState != 2
trigger3 = enemynear(var(58)),statetype = L 
fvar(5) = 0

[State -2, VarSet];補正
type = varset
trigger1 = enemynear(var(58)),movetype = H
trigger1 = fvar(5) >= 1
fvar(0) = (100.0 - (fvar(5) * 10.0)) / 100.0

[State -2, ];補正無視
type = varset
triggerall = fvar(0) < 1
trigger1 = stateno = 901
fvar(0) = 1

[State -2, VarSet];補正(超必)
type = varset
triggerall = fvar(0) < 0.3
trigger1 = stateno = [2000,3999]
fvar(0) = 0.3

[State -2, VarSet];補正(必殺技)
type = varset
triggerall = fvar(0) < 0.2
trigger1 = stateno = [1000,1999]
trigger2 = var(39)
fvar(0) = 0.2

[State -2, VarSet];補正
type = varset
trigger1 = fvar(0) < 0.1
fvar(0) = 0.1

[State -2, ];攻撃力合計
type = varset
trigger1 = 1
fvar(1) = fvar(0)*ifelse(var(6),1.2,1)

[State -2, ]
type = attackmulset
trigger1 = 1
value = fvar(1)

;-----------------------------------------------------------------------------
;根性値
;-----------------------------------------------------------------------------
[State -2, DefenceMulSet]
Type = DefenceMulSet
Trigger1 = Alive
value = fvar(6)

[State -2, VarSet]
Type = VarSet
Trigger1 = (1000*Life/LifeMax) > 500
FV = 6
Value = 1
IgnoreHitPause = 1

[State -2, VarSet]
Type = VarSet
Trigger1 = (1000*Life/LifeMax) = [251,500]
FV = 6
Value = 0.95
IgnoreHitPause = 1

[State -2, VarSet]
Type = VarSet
Trigger1 = (1000*Life/LifeMax) = [101,250]
FV = 6
Value = 0.9
IgnoreHitPause = 1

[State -2, VarSet]
Type = VarSet
Trigger1 = (1000*Life/LifeMax) <= 100
FV = 6
Value = 0.75
IgnoreHitPause = 1

