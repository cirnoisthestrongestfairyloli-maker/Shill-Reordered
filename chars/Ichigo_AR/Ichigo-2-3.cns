;---------------------------------------------------------------------------
;ダメージボイス
;---------------------------------------------------------------------------
[State -2,]
type = StopSnd
trigger1 = Movetype = H
channel = 10
ignorehitpause = 1

[State -2,]
type = PlaySnd
triggerall = alive = 1
triggerall = random <= 250
triggerall = time = 1
trigger1 = stateno = 5000
trigger1 = anim = 5000 || anim = 5010
trigger2 = stateno = 5010
trigger2 = anim = 5020
value = s11+(var(15)*10),1

[State -2,]
type = PlaySnd
triggerall = alive = 1
triggerall = random <= 250
triggerall = time = 1
trigger1 = stateno = 5000
trigger1 = anim = 5002 || anim = 5012
trigger2 = stateno = 5010
trigger2 = anim = 5022
value = s11+(var(15)*10),2

[State -2,]
type = PlaySnd
triggerall = alive = 1
triggerall = random <= 500
triggerall = time = 1
trigger1 = stateno = 5101
value = s11+(var(15)*10),3

;KOボイス
[State 00]
type = PlaySnd
trigger1 = !alive && life <= 0
trigger1 = var(19) = 0
trigger1 = stateno != 5950
trigger1 = var(19) := 1
value = s11+(var(15)*10),5

[State -2, a]
type = varset
triggerall = var(19) = 1
trigger1 = alive
var(19) = 0

;-------------------------------------------------------------------------------
; アーマー処理
;-------------------------------------------------------------------------------
[State -2, アーマーヘルパー呼び出し]
type = Helper
triggerall = !NumHelper(9000) && !Ishelper
triggerall = MoveType != H
trigger1 = var(39)
name = "Armor"
stateno = 9000
ID = 9000
size.xscale = 1
size.yscale = 1
postype = p1
pos = 0,0
ownpal = 1
supermovetime = 99999
pausemovetime = 99999
ignorehitpause = 1

[State -2, アーマー中の無敵]
type = NotHitBy
trigger1 = NumHelper(9000)
value = SCA
time = 2

[State -2, アーマー中に被弾した時の無敵時間延長（２重被弾抑制処置）]
type = NotHitBy
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
value = SCA
time = Helper(9000),GetHitVar(hitshaketime)+5

[State -2, アーマー受けした時のライフ減少]
type = LifeAdd
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
value = -1*Helper(9000),GetHitVar(damage)
absolute = 1
ignorehitpause = 1

[State -2, Pause]
type = Pause
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
time = 10

[State -2, PalFX]
type = PalFX
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
time = 10
add = 255,  0,  0
;mul = 255,  0,  0

;-----------------------------------------------------------------------------
;BGMジャック
;-----------------------------------------------------------------------------
[State -2, VarSet]
type = varset
trigger1 = RoundState = [0,1]
v = 38
value = 0

;ステージBGM消去
[State -2, BGM]
type = AssertSpecial
trigger1 = Var(38) = 1
flag = nomusic
ignorehitpause = 1

[State -2, BGM]
type = PlaySnd
trigger1 = Var(38) = 1
trigger1 = Stateno != 3000 && Stateno != 3090
value = s9999,0
channel = 31
lowpriority = 1
loop = 1
ignorehitpause = 1

;BGM停止条件
[State -2, BGM]
type = StopSnd
trigger1 = Var(38) = 0
channel = 31
ignorehitpause = 1
persistent = 0

;-----------------------------------------------------------------------------
;AI用重力加速度計測
;-----------------------------------------------------------------------------
[State -2, yaccel]
type = varset
trigger1 = fvar(20) != enemynear(var(58)),const(movement.yaccel)
trigger1 = enemynear(var(58)),stateno != [5000,5210]
trigger1 = enemynear(var(58)),Vel Y != 0
FV = 20
value = enemynear(var(58)),const(movement.yaccel)
ignorehitpause = 1

[State -2, yaccel]
type = varset
trigger1 = fvar(20) != enemynear(var(58)),GetHitVar(yaccel)
trigger1 = enemynear(var(58)),stateno = [5000,5210]
trigger1 = enemynear(var(58)),Vel Y != 0
FV = 20
value = enemynear(var(58)),GetHitVar(yaccel);(打撃当てた時のyaccel値)
ignorehitpause = 1

;敵が空中じゃない時
[State -2, yaccel]
type = varset
trigger1 = fvar(20) != 0
trigger1 = enemynear(var(58)),Vel Y = 0
FV = 20
value = 0;(打撃当てた時のyaccel値)
ignorehitpause = 1

;---------------------------------------------------------------------------
;AI用p2name
;---------------------------------------------------------------------------
;特殊地上受け身なし
[State -1, ]
Type = VarSet
triggerall = var(59)
trigger1 = 1
fvar(21) = 0

;特殊地上受け身持ち1(高め)
[State -1, ]
Type = VarSet
triggerall = var(59)
trigger1 = enemynear(var(58)),authorname = "ahuron"
trigger1 = enemynear(var(58)),name != "SHIN" || enemynear(var(58)),name != "REI" || enemynear(var(58)),name != "JAGI" || enemynear(var(58)),name != "THOUTHER"
trigger1 = enemynear(var(58)),name != "Shinnosuke Kagami" || enemynear(var(58)),name != "Mukuro"
trigger1 = enemynear(var(58)),name != "Misuzu"
trigger2 = enemynear(var(58)),authorname = "jin"
