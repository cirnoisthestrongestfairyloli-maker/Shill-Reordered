[Statedef 2005]
type     = S
movetype = A
physics  = N
juggle   = 0
poweradd = 0
velset   = 0,0
anim     = 2005
ctrl     = 0
sprpriority = 5

[State 170, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA

[State 1001, 特殊効果]
type = AssertSpecial
trigger1 = 1
flag = NoShadow ;影を消す

[state a]
type = velset
trigger1 = time = 0
x = 8

[State 600, 2]
type = HitDef
trigger1 = time = 1
attr = A, HP
animtype  = hard
damage    = floor(8*root,var(8)*fvar(0)),4*root,var(8)
getpower  = 0
givepower = 10,10
priority = 4, Hit
guardflag = MA
pausetime = 1,2
sparkno = s20030+random%4
sparkxy = 0,-60 + (floor(p2bodydist Y))
hitsound   = s1,3
guard.sparkno = s10040
guardsound = s2,0
ground.type = high
ground.slidetime = 18
ground.hittime  = 18
ground.velocity = -2,-2
air.velocity = -2,-2
fall = 1
fall.recover = 0
;Abstract Reordered: OTG - also hits a downed opponent and pops them back up for a juggle
hitflag = MAFD
down.velocity = -2.5, -6
down.hittime = 20
down.bounce = 0

[State 600, 2]
type = HitDef
trigger1 = time != 0
trigger1 = Time % 3 = 0
attr = A, HP
animtype  = hard
damage    = floor(24*root,var(8)*fvar(0)),4*root,var(8)
getpower  = 0
givepower = 10,10
priority = 4, Hit
guardflag = MA
pausetime = 1,2
sparkno = s20030+random%4
sparkxy = 0,-60 + (floor(p2bodydist Y))
hitsound   = s1,3
guard.sparkno = s10040
guardsound = s2,0
ground.type = high
ground.slidetime = 18
ground.hittime  = 18
ground.velocity = -2,-2
air.velocity = -2,-2
fall = 1
fall.recover = 0
;Abstract Reordered: OTG - also hits a downed opponent and pops them back up for a juggle
hitflag = MAFD
down.velocity = -2.5, -6
down.hittime = 20
down.bounce = 0

[State 1000, ]
type = Varset
trigger1 = 1
fvar(0) = root,fvar(0)

[state -2, VarSet];補正
type = varset
trigger1 = fvar(0) < 0.3
fvar(0) = 0.3

[State 1000, ]
type = ParentVaradd
trigger1 = movehit = 1
fvar(5) = 0.4

[State 3000]
type = Projectile
trigger1 = time = 0
projID = 2000
projanim = 2006
projremove = 0
projpriority = 99
projhitanim = -1
projremanim = -1
projsprpriority = 0
projshadow = 0,0,0
projremovetime = 15
offset = 0,0
velocity = vel X, vel Y

[state a];透過
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256,128

[state a]
type = angledraw
trigger1 = 1
scale = 2*Const(size.xscale),2*Const(size.yscale)

[State 1000, このヘルパーを消す]
type = DestroySelf
trigger1 = time >= 15
trigger2 = root,numprojID(2000) = 0
trigger2 = frontedgedist > 0

