trigger1 = AnimElem = 4,= 1
value = -ifelse(var(15),40,32)*var(8)

[State 810, ターン]
type = Turn
trigger1 = AnimTime = 0
value = -1

[State 810, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

