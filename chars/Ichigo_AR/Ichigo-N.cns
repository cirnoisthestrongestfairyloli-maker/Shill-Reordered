;---------------------------------------------------------------------------
; ここからは通常攻撃技のステート
;---------------------------------------------------------------------------
; 立ち弱攻撃

[Statedef 200]
type     = S
movetype = A
physics  = S
juggle   = 0
velset   = 0,0
ctrl     = 0
anim     = 200
poweradd = 0
sprpriority = 2
facep2 = 1

[State 200, AR light count]
;Abstract Reordered: consecutive standing lights (var(43)); blocked 2nd = pushback, blocked 3rd = more pushback and minus
type = VarSet
trigger1 = Time = 0
var(43) = ifelse(prevstateno = 200, var(43) + 1, 1)

[State 200, AR pushback]
type = VelSet
trigger1 = MoveGuarded = 1
trigger1 = var(43) >= 2
x = ifelse(var(43) >= 3, -5, -3)

[State 200, AR minus]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = var(43) >= 3
trigger1 = MoveGuarded
value = 7300

[State 200, ChangeAnim]
type = ChangeAnim
trigger1 = var(15) = 1
trigger1 = Time = 0
value = 201

[State 200, 攻撃設定]
type = HitDef
trigger1 = AnimElem = 2
attr = S, NA
damage    = ifelse(var(15),15,13)*var(8),0
getpower  = floor(24*1.25),floor(24*1.25)
givepower = 10,10
animtype = Light
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = 10,10+var(0)
guard.pausetime = 20,0
sparkno = s20000+random%4
guard.sparkno = s10040
sparkxy = -10,-ceil(50*Const(size.yscale))
hitsound   = s1,0
guardsound = s2,0
ground.type = High
ground.slidetime = 16
ground.hittime  = 16
ground.velocity = -4
air.velocity = 0,-5
airguard.velocity = 0,0
id = 200

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 2
value = s10+(var(15)*10),0
channel = 10

[State 200, 効果音]
type = PlaySnd
trigger1 = AnimElem = 2
value = s0,0

[State 200, チェンジ]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

