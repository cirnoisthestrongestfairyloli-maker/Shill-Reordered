;投げ１・投げている（自分）
[Statedef 901]
type    = S
movetype= A
physics = S
anim = 901

[State 810, リセット]
type = VarSet
trigger1 = Time = 0
var(2) = 0

[State 810, 前を押しているか]
type = VarSet
trigger1 = !var(59)
trigger1 = command = "holdfwd"
trigger2 = var(59)
trigger2 = backedgedist > 120
var(2) = 1

[State 810, ターン]
type = Turn
trigger1 = var(2)
trigger1 = AnimElem = 1

[State 810, 相手もターン]
type = TargetFacing
trigger1 = var(2)
trigger1 = AnimElem = 1
value = -1

[State 170, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA

[State 810, 物理的なキャラの幅]
type = Width
trigger1 = 1
edge = 60,0

[State 810, 1]
type = PlaySnd
Trigger1 = time = 0
value = s1,20

[State 200, 効果音]
type = PlaySnd
trigger1 = AnimElem = 4
value = s0,2

[State 200, 効果音]
type = PlaySnd
trigger1 = AnimElem = 4
value = s1,3

[State 810, 1]
type = PlaySnd
Trigger1 = AnimElem = 4
value = s10+(var(15)*10),15
channel = 10

[State 810, 3]
type = TargetBind
Trigger1 = AnimElemtime(1) >= 0 && AnimElemtime(2) < 0
pos = 40, 0

[State 810, 3]
type = TargetBind
Trigger1 = AnimElemtime(2) >= 0 && AnimElemtime(3) < 0
pos = 25, -65

[State 810, 3]
type = TargetBind
Trigger1 = AnimElemtime(3) >= 0 && AnimElemtime(4) < 0
pos = 15, -70

[State 810, 3]
type = TargetBind
Trigger1 = AnimElemtime(4) = 0
pos = 40, -10

[State 810, 掴んだ相手の体力ゲージの増減]
