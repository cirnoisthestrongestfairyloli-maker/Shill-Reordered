;---------------------------------------------------------------------------
; ここからは必殺技のステート
;---------------------------------------------------------------------------
; 弱　斬月

[Statedef 1000]
type     = S
movetype = A
physics  = S
juggle   = 0
poweradd = 50
velset   = 0,0
anim     = 1000
ctrl     = 0
sprpriority = 3
facep2 = 1

[State 800, Guard Cancel Effect]
type = Explod
triggerall = time = 0
trigger1 = prevstateno = [150,155]
trigger1 = var(16) = 0
anim = 872
ID = 872
pos = Const(size.mid.pos.x),Const(size.mid.pos.y)
postype = p1
facing = 1
vfacing = 1
bindtime = 1
accel = 0,0
random = 0,0
removetime = -2
supermovetime = 0
pausemovetime = 0
scale = 1
sprpriority = 4
ontop = 0
shadow = 0,0,0
ownpal = 1
removeongethit = 0
ignorehitpause = 1

[State 700,]
type = Poweradd
triggerall = helper(40000),var(2) = 1
triggerall = time = 0
trigger1 = prevstateno = [150,155]
trigger1 = var(16) = 0
value = -1000

[State 700,];点滅
type = palfx
triggerall = time = 0
trigger1 = prevstateno = [150,155]
trigger1 = var(16) = 0
time = 5
add = 230,230,230

[state 1000, VarSet];先行入力初期化
type = varset
trigger1 = time = 0
var(31) = 0

[state 1000, VarSet];先行入力初期化
type = varset
trigger1 = time = 0
var(32) = 0

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 1
value = s10+(var(15)*10),20
channel = 10

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 4
value = s0,12

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 5
value = s12,0

[State 1100, エフェクト表示]
type = Explod
trigger1 = AnimElem = 4
anim = 1001
ID = 1000
postype = P1
pos = 0,0
sprpriority = 10
bindtime = -1
ignorehitpause = 0
scale = Const(size.xscale),Const(size.yscale)

[State 1000, 攻撃設定]
type = HitDef
trigger1 = AnimElem = 4
attr = S, SA
animtype  = Hard
damage    = 24*var(8),4*var(8)
getpower  = floor(36*1.25),floor(36*1.25)
givepower = 10,10
guardflag = MA
hitflag   = MAF
pausetime = 8,8
sparkno = s20120+random%4
guard.sparkno = s10040
sparkxy = -10,-ceil(50*Const(size.yscale))
hitsound   = s1,12
guardsound = s2,0
ground.type = High
ground.slidetime = 20
ground.hittime  = 20
ground.velocity = -6
air.velocity = 0,-5
air.hittime = 20
guard.velocity = -4
airguard.velocity = 0,0

[State 1000,4]
type = helper
trigger1 = AnimElem = 5
stateno = 1005
id = 1005
name = "zangetsu"
pos = ceil(50*Const(size.xscale)),0
postype = P1
helpertype = normal
keyctrl = 0
ownpal = 1

[State 1000, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;--------------------------------------------------------------------------
;(HELPER)弾
[Statedef 1005]
type     = S
movetype = A
physics  = N
juggle   = 0
poweradd = 0
velset   = 0,0
anim     = 1005
ctrl     = 0
sprpriority = 5

[State 170, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA

[State 1001, 特殊効果]
type = AssertSpecial
trigger1 = 1
flag = NoShadow ;影を消す

[state a]
type = velset
trigger1 = time = 0
x = 5

[State 600, 2]
type = HitDef
trigger1 = Time >= 1
trigger1 = Time % 2 = 0
attr = A, SP
animtype  = hard
damage    = floor(12*root,var(8)*fvar(0)),4*root,var(8)
getpower  = floor(24*1.25),floor(24*1.25)
givepower = 10,10
priority  = 4, Hit
guardflag = MA
pausetime = 1,2
sparkno = s20020+random%4
sparkxy = -10,-30 + (floor(p2bodydist Y))
hitsound   = s1,2
guard.sparkno = s10040
guardsound = s2,0
ground.type = high
ground.slidetime = 18
ground.hittime  = 18
ground.velocity = -1,-1
air.velocity = -1,-1
fall = 1
fall.recover = 0

[State 1000, ]
type = Varset
trigger1 = 1
fvar(0) = root,fvar(0)

[state 1000, VarSet];補正
type = varset
trigger1 = fvar(0) < 0.2
fvar(0) = 0.2

[State 1000, ]
type = ParentVaradd
trigger1 = movehit = 1
fvar(5) = 0.6

[State 3000]
type = Projectile
trigger1 = time = 0
projID = 1000
projanim = 1006
projremove = 0
projpriority = 1
projhitanim = -1
projremanim = -1
projsprpriority = 0
projshadow = 0,0,0
projremovetime = 10
offset = 0,0
velocity = vel X, vel Y

[state a];透過
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256,128

[state a]
type = angledraw
trigger1 = 1
scale = Const(size.xscale),Const(size.yscale)

[State 1000, このヘルパーを消す]
type = DestroySelf
trigger1 = time >= 10
trigger2 = root,numprojID(1000) = 0

