;-----------------------------------------------------------------------------
; Special Movement
;-----------------------------------------------------------------------------
; Shunpo start
[Statedef 800]
type    = U
physics = N
ctrl = 0
anim = 800+(6000*(var(40)>0))
sprpriority = 2

[State 800, Guard Cancel Effect]
type = Explod
triggerall = time = 0
trigger1 = prevstateno = [150,155]
trigger1 = var(16) = 0
anim = 872
ID = 872
pos = Const(size.mid.pos.x),Const(size.mid.pos.y)
postype = p1
facing = 1
vfacing = 1
bindtime = 1
accel = 0,0
random = 0,0
removetime = -2
supermovetime = 0
pausemovetime = 0
scale = 1
sprpriority = 4
ontop = 0
shadow = 0,0,0
ownpal = 1
removeongethit = 0
ignorehitpause = 1

[State 700,]
type = Poweradd
triggerall = helper(40000),var(2) = 1
triggerall = time = 0
trigger1 = prevstateno = [150,155]
trigger1 = var(16) = 0
value = -1000

[State 700,];点滅
type = palfx
triggerall = time = 0
trigger1 = prevstateno = [150,155]
trigger1 = var(16) = 0
time = 5
add = 230,230,230

[State 800, 無敵]
type = NotHitBy
trigger1 = helper(40000),var(1) = 0
trigger1 = var(24) = 0
value = SCA

[State 800, 非無敵]
type = HitBy
trigger1 = helper(40000),var(1) = 1
trigger1 = var(24) = 0
value = SCA, AT

[State 800, No Autoturn]
type = AssertSpecial
trigger1 = 1
flag = noautoturn

[State 800, Shunpo Timer]
type = VarSet
trigger1 = time = 0
var(22) = ifelse((prevstateno = [200,799]), 8, 0)

[State 800, Shunpo downback]
type = VarSet
triggerall = var(59) != 1 || var(59) = 1 && var(57) <= 2
triggerall = prevstateno != 20
trigger1 = command = "holddown"
trigger1 = command = "holdback"
trigger1 = statetype = A
var(23) = 8

[State 800, Shunpo upback]
type = VarSet
triggerall = var(59) != 1 || var(59) = 1 && var(57) <= 2
triggerall = prevstateno != 20
trigger1 = command = "holdup"
trigger1 = command = "holdback"
var(23) = 6

[State 800, Shunpo down]
type = VarSet
triggerall = var(59) != 1 || var(59) = 1 && var(57) <= 2
trigger1 = command = "holddown"
trigger1 = (command != "holdfwd") && (command != "holdback")
trigger1 = statetype = A
var(23) = 5

[State 800, Shunpo downfwd]
type = VarSet
triggerall = var(59) != 1 || var(59) = 1 && var(57) <= 2
trigger1 = command = "holddown"
trigger1 = command = "holdfwd"
trigger1 = statetype = A
var(23) = 4

[State 800, Shunpo fwd]
type = VarSet
triggerall = var(59) != 1 || var(59) = 1 && var(57) <= 2
trigger1 = (command != "holdup") && (command != "holddown")
trigger1 = command != "holdback"
trigger2 = command = "holddown"
trigger2 = command != "holdback"
trigger2 = statetype != A
var(23) = 3

[State 800, Shunpo upfwd]
type = VarSet
triggerall = var(59) != 1 || var(59) = 1 && var(57) <= 2
trigger1 = command = "holdup"
trigger1 = command = "holdfwd"
var(23) = 2

[State 800, Shunpo up]
type = VarSet
triggerall = var(59) != 1 || var(59) = 1 && var(57) <= 2
trigger1 = command = "holdup"
trigger1 = (command != "holdfwd") && (command != "holdback")
var(23) = 1

[State 800, Shunpo back]
type = VarSet
triggerall = var(59) != 1 || var(59) = 1 && var(57) <= 2
trigger1 = (command != "holdup") && (command != "holddown")
trigger1 = command = "holdback"
trigger2 = command = "holddown"
trigger2 = command = "holdback"
trigger2 = statetype != A
var(23) = 7

[State 800, Sound2]
type = PlaySnd
trigger1 = time = 0
value = 8,0

[State 800, Shunpo Stock1]
type = VarSet
trigger1 = time = 0
trigger1 = !var(7)
fvar(14) = 0

[State 800, Shunpo Stock2]
;Abstract Reordered: combo Shunpo (var(7)) pays meter instead of a stock
type = VarSet
trigger1 = time = 0
trigger1 = !var(7)
var(13) = var(13) - 1

;Abstract Reordered: Shunpo out of an attack (var(7) = previous state was an attack) costs half a stock
;(210 of the 420-tick refill) when he has one, otherwise 1 bar.
;var(18): 0 = normal Shunpo, 1 = half from the refill, 2 = one stock with half refunded, 3 = 1 bar
[State 800, AR cancel payment]
type = VarSet
trigger1 = time = 0
var(18) = ifelse(!var(7), 0, ifelse(fvar(14) >= 210, 1, ifelse(var(13) >= 1, 2, 3)))

[State 800, AR half stock from refill]
type = VarAdd
trigger1 = time = 0
trigger1 = var(18) = 1
fvar(14) = -210

[State 800, AR half stock (stock)]
type = VarAdd
trigger1 = time = 0
trigger1 = var(18) = 2
var(13) = -1

[State 800, AR half stock (refund)]
type = VarAdd
trigger1 = time = 0
trigger1 = var(18) = 2
fvar(14) = 210

[State 800, AR cancel cost]
type = PowerAdd
trigger1 = time = 0
trigger1 = var(18) = 3
value = -1000

[State 800, State Change]
type = ChangeState
trigger1 = time = 0
value = 801

