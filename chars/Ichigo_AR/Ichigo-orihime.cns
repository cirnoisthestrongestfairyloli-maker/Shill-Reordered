;---------------------------------------------------------------------------
; 214+A: Tsubaki flies forward
[Statedef 74110]
type     = A
movetype = A
physics  = N
anim     = 71300
velset   = 6, 0
ctrl     = 0
sprpriority = 3

[State 74110, Safe]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 74110, Size]
;her original spawns this at 1/10 size
type = AngleDraw
trigger1 = 1
scale = 0.1, 0.1

[State 74110, Glow]
;the orb sits on black: draw it additively so only the glow shows
type = Trans
trigger1 = 1
trans = add

[State 74110, Trail]
type = Explod
trigger1 = Time % 3 = 0
anim = 71365
ID = 74111
pos = 0, 0
postype = p1
bindtime = 1
removetime = -2
scale = 0.1, 0.1
sprpriority = 2
ownpal = 1
ignorehitpause = 1

[State 74110, Hit]
type = HitDef
trigger1 = Time = 0
attr = S, SP
animtype = Hard
damage = 55, 6
getpower = 0
givepower = 20, 10
hitflag = MAFD
guardflag = MA
priority = 4, Hit
pausetime = 0, 14
guard.pausetime = 0, 14
sparkno = 2
guard.sparkno = 40
sparkxy = -10, 0
hitsound = s1, 12
guardsound = s2, 0
ground.type = High
ground.slidetime = 14
ground.hittime = 14
ground.velocity = -2.3, -5.5
air.velocity = -2.3, -5.5
air.hittime = 14
guard.velocity = -7
airguard.velocity = -3, 0
fall = 1
fall.recover = 0

[State 74110, Done]
type = DestroySelf
trigger1 = MoveContact
trigger2 = FrontEdgeBodyDist < -60
trigger3 = Time > 150
trigger4 = RoundState > 2
ignorehitpause = 1

;---------------------------------------------------------------------------
; 214+B: Santen Kesshun barrier in front of Ichigo (3 s, takes 3 hits, gone if he's hit)
[Statedef 74120]
type     = A
movetype = I
physics  = N
ctrl     = 0
sprpriority = 4

[State 74120, Start anim]
type = ChangeAnim
trigger1 = var(2) = 0
value = 73800

[State 74120, Hits it can take]
type = VarSet
trigger1 = var(2) = 0
var(0) = 3

[State 74120, Started]
type = VarSet
trigger1 = var(2) = 0
var(2) = 1

[State 74120, Age]
type = VarAdd
trigger1 = 1
var(1) = 1

[State 74120, Bind]
type = BindToRoot
trigger1 = 1
time = 1
facing = 1
pos = 27, -117
ignorehitpause = 1

[State 74120, Look]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256, 256

[State 74120, Shape]
type = AngleDraw
trigger1 = 1
scale = 0.6, 1.0

[State 74120, No push]
type = PlayerPush
trigger1 = 1
value = 0

[State 74120, Absorb]
type = HitOverride
trigger1 = 1
attr = SCA, NA, SA, HA, NP, SP, HP
stateno = 74121
time = 1
ignorehitpause = 1

[State 74120, Expire]
type = ChangeState
trigger1 = var(1) >= 180
trigger2 = root,MoveType = H
trigger3 = RoundState > 2
value = 74122

[State 74120, Broken]
type = ChangeState
trigger1 = var(0) <= 0
value = 74123

