;---------------------------------------------------------------------------
; Abstract Reordered: Orihime assist (art from Orihime Inoue by Ashisukurou)
; 214+A Tsubaki projectile | 214+B Santen Kesshun barrier | 214+C Santen Kesshun floor trap
; root var(27) = which assist, root var(29) = cooldown (5 s, counts down after she leaves)
;---------------------------------------------------------------------------

; Ichigo calls her
[Statedef 74000]
type     = S
movetype = I
physics  = S
anim     = 0 + 6000 * var(39)
velset   = 0, 0
ctrl     = 0

[State 74000, Orihime]
type = Helper
trigger1 = Time = 1
helpertype = normal
name = "Orihime"
ID = 74100
stateno = 74100
pos = -35, 0
postype = p1
facing = 1
keyctrl = 0
ownpal = 1

[State 74000, Cooldown]
type = VarSet
trigger1 = Time = 1
var(29) = 300

[State 74000, Call flash]
type = PalFX
trigger1 = Time = 0
time = 8
add = 120, 80, 20

[State 74000, Done]
type = ChangeState
trigger1 = Time >= 12
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Orihime herself
[Statedef 74100]
type     = S
movetype = I
physics  = N
anim     = ifelse(root,var(27) = 1, 74000, ifelse(root,var(27) = 2, 76001, 135000))
velset   = 0, 0
ctrl     = 0
sprpriority = 1

[State 74100, Kind]
type = VarSet
trigger1 = Time = 0
var(0) = root,var(27)

[State 74100, Floor]
type = PosSet
trigger1 = Time = 0
y = 0

[State 74100, Safe]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 74100, No push]
type = PlayerPush
trigger1 = 1
value = 0

[State 74100, Off screen ok]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0, 0

[State 74100, Fade in]
type = Trans
trigger1 = Time < 6
trans = addalpha
alpha = Time * 42, 256 - Time * 42

[State 74100, Throw]
type = Helper
trigger1 = var(0) = 1
trigger1 = AnimElem = 6
helpertype = normal
name = "Tsubaki"
ID = 74110
stateno = 74110
pos = 45, -36
postype = p1
facing = 1
keyctrl = 0
ownpal = 1

[State 74100, Barrier]
type = Helper
trigger1 = var(0) = 2
trigger1 = Time = 8
trigger1 = NumHelper(74120) = 0
helpertype = normal
name = "Santen Kesshun"
ID = 74120
stateno = 74120
pos = 0, 0
postype = p1
facing = 1
keyctrl = 0
ownpal = 1

[State 74100, Trap]
type = Helper
trigger1 = var(0) = 3
trigger1 = Time = 50
helpertype = normal
name = "Santen Kesshun"
ID = 74130
stateno = 74130
pos = 145, 0
postype = p1
facing = 1
keyctrl = 0
ownpal = 1
size.xscale = 0.3
size.yscale = 0.3

[State 74100, Run away (C)]
type = ChangeState
trigger1 = var(0) = 3 && Time >= 70
value = 74102

[State 74100, Leave]
type = ChangeState
trigger1 = var(0) = 1 && AnimTime = 0 && Time > 3
trigger2 = var(0) = 2 && Time >= 47
trigger3 = RoundState > 2
value = 74101

[Statedef 74101]
type     = S
movetype = I
physics  = N
ctrl     = 0

[State 74101, Safe]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 74101, Hold]
type = ChangeAnim
trigger1 = AnimTime = 0
value = Anim
elem = AnimElemNo(0)

[State 74101, Fade]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256 - Time * 32, Time * 32

[State 74101, Gone]
type = DestroySelf
trigger1 = Time >= 8

;---------------------------------------------------------------------------
; after the C trap: she turns and runs off screen - she can be hit while running
[Statedef 74102]
type     = S
movetype = I
physics  = N
anim     = 70100
ctrl     = 0
sprpriority = 1

[State 74102, Turn]
type = Turn
trigger1 = Time = 0

[State 74102, Run]
type = VelSet
trigger1 = 1
x = 5
y = 0

[State 74102, No push]
type = PlayerPush
trigger1 = 1
value = 0

[State 74102, Off screen ok]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0, 0

[State 74102, Get hit]
type = HitOverride
trigger1 = 1
attr = SCA, NA, SA, HA, NP, SP, HP, NT, ST, HT
stateno = 74106
time = 1

[State 74102, Gone]
type = DestroySelf
trigger1 = FrontEdgeDist < -60
trigger2 = Time >= 120
trigger3 = RoundState > 2

; hit while running away: knocked out of the fight
[Statedef 74106]
type     = S
movetype = H
physics  = N
ctrl     = 0
velset   = 0, 0

[State 74106, Safe]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 74106, Hold]
type = ChangeAnim
trigger1 = AnimTime = 0
value = Anim
elem = AnimElemNo(0)

[State 74106, Flash]
type = PalFX
trigger1 = Time = 0
time = 10
add = 255, 255, 255

[State 74106, Knocked back]
type = VelSet
trigger1 = Time = 0
x = -3
y = 0

[State 74106, Fade]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256 - Time * 16, Time * 16

[State 74106, Gone]
type = DestroySelf
trigger1 = Time >= 16

