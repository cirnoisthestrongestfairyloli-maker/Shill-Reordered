trigger1 = 1
flag = noshadow

[state a]
type = posset
trigger1 = 1
x = pos x - screenpos x +160
y = pos y - screenpos y +120

[state a]
type = varset
trigger1 = time = 0
v = 1
value = 0

[state a]
type = varadd
trigger1 = animelem = 8,>=0
v = 1
value = 10

