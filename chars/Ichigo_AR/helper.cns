[state a]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256-var(1),40+var(1)

[state a]
type = AngleDraw
trigger1 = 1
scale = 1.5+0.05*Time,1.5+0.05*Time

[State 181, 特殊効果]
