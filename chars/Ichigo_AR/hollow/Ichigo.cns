;---------------------------------------------------------------------------
; 基本データ、サイズ等を決めるための第一CNSファイル。
;---------------------------------------------------------------------------

[Data];データ
life              = 1000  ;体力ゲージの初期値
power             = 3000  ;超必殺技ゲージ最大値
attack            = 100   ;攻撃力%
defence           = 90    ;防御力%
fall.defence_up   = 50    ;ダウン時に攻撃された時に一時的に上がる防御力
liedown.time      = 60    ;倒れてから起き上がるまでの最大時間
airjuggle         = 15    ;ジャグルポイント
sparkno           = 2     ;hitdefで設定していない時の基本ヒットスパークナンバー
guard.sparkno     = 40    ;hitdefで設定していない時の基本ガードスパークナンバー
KO.echo           = 0     ;0にするとKOされた時に声にエコーがかからない
volume            = 128   ;キャラの音量　255が最高
intpersistindex   = 56    ;Varの次ラウンド持ち越しが可能
floatpersistindex = 40    ;同じくFVarの次ラウンド持ち越しが可能

; 変数持ち越しの例
; IntPersistIndex = 20　（Var(20)以降の変数が次のラウンドへ持ち越され、それ以外は0に戻る）
; FloatPersistIndex = 25（FVar(25)以降の変数が次のラウンドへ持ち越され、それ以外は0に戻る）


;---------------------------------------------------------------------------

[Size];サイズ
xscale           = 1.15     ;水平方向の縮尺
yscale           = 1.15     ;垂直方向の縮尺
ground.back      = 15       ;キャラクターの幅（後方、地上）
ground.front     = 16       ;キャラクターの幅（前方、地上）
air.back         = 12       ;キャラクターの幅（後方、空中）
air.front        = 12       ;キャラクターの幅（前方、空中）
height           = 60       ;キャラの高さ(の3分の2くらいを指定)
attack.dist      = 160      ;攻撃時に相手がガード体勢に入る最低距離（最大320）
proj.attack.dist = 90       ;相手がガード体勢に入る発射物との最低距離（最大320）
proj.doscale     = 0        ;xscale, yscaleの設定が発射物にも有効かどうかの設定（1なら有効）
head.pos         = -5, -90  ;頭の大体の座標（BindToTarget使用時に必要）
mid.pos          = -5, -60  ;体中心の大体の座標（BindToTarget使用時に必要）
shadowoffset     = 0        ;影の垂直方向オフセット(画像位置ズレ補正手段)
draw.offset      = 0,0      ;描画位置オフセット(画像位置ズレ補正最終手段)

;---------------------------------------------------------------------------

[Velocity];移動速度
walk.fwd     = 3.5         ;前に歩く時の速度
walk.back    = -3.2        ;後ろに歩く時の速度
run.fwd      = 6.5,0       ;前に走る時の速度 (x, y) ホップさせる時は y を 0 以下にする
run.back     = -8,-2.4     ;後ろに走る時の速度 (x, y) 走らせる時は y を 0 にします
jump.neu     = 0,-7.5      ;ジャンプ時の垂直移動速度 (x, y)
jump.back    = -3.5        ;後ろにジャンプした時の水平移動速度
jump.fwd     = 3.5         ;前にジャンプした時の水平移動速度
runjump.back = -3.5,-7.5   ;後ろに走りながらのジャンプ時の速度指定
runjump.fwd  = 3.5,-7.5    ;前に走りながらのジャンプ時の速度指定
airjump.neu  = 0,-7.5      ;空中ジャンプ時の垂直移動速度
airjump.back = -3.5        ;空中で後ろにジャンプした時の水平移動速度
airjump.fwd  = 3.5         ;空中で前にジャンプした時の水平移動速度

;---------------------------------------------------------------------------

[Movement];動作
airjump.num     = 1      ;空中ジャンプの回数
airjump.height  = 35     ;空中ジャンプに必要な最低限の高さ
yaccel          = .42    ;垂直方向にかかる加速度（重力）
stand.friction  = .85    ;立ち状態の摩擦係数
crouch.friction = .82    ;屈み状態の摩擦係数
