;Gazelle Punch Light
[Statedef 1020]
type = S
movetype = A
physics = S
anim = 1000
ctrl = 0
velset = 0,0
poweradd = 70 * !var(20)
sprpriority = 2
facep2 = 1

[State 0, Button Detect]
type = VarSet
trigger1 = !Time && !var(59)
var(10) = ifElse((command = "x" || command = "rlsx"  || PrevStateNo = 750), 2, ifElse((command = "x" || command = "rlsx"), 1, 0))

[State 0, Button Detect (AI)]
type = VarSet
trigger1 = !Time && var(59)
var(10) = ifElse((P2MoveType = H || PrevStateNo = 750 || Random < 333), 2, ifElse(Random < 500, 1, 0))

[State 1020, Voice]
type = PlaySnd
trigger1 = AnimElem = 1
value = 0,3
channel = 0

[State 1020, Swing Snd]
type = PlaySnd
trigger1 = Animelem = 5
value = 1, 2

[State 0, Snd]
type = PlaySnd
trigger1 = Animelem = 5
value = 41, 0
channel = 1

[State 1020, Rising Velocity]
type = VelSet
trigger1 = AnimElem = 3
x = 5

[State 1020, Rising Velocity]
type = VelSet
trigger1 = AnimElem = 5
x = 0

[State 1020, FX]
type = Explod
trigger1 = AnimElem = 5
anim = 4000
ID = 4000
postype = p1
pos = 40,0
bindtime = -1
sprpriority = 2
ownpal = 1
removeongethit = 1
ignorehitpause = 0
persistent = 0
ontop = 1
scale = .5,.5

[State 1020, Hit]
type = HitDef
air.fall = 1   ;Abstract Reordered: juggles
trigger1 = !var(16) && var(15) < 6
trigger1 = Animelem = 5
attr = A, SA
damage = ceil(ifElse(fvar(11) * 30 < 7, 7, fvar(11) * 30)), 8
priority = 4, hit
animtype = Hard
getpower = 50 * !var(20), 30 * !var(20)
givepower = 35, 35
guardflag = MA
hitflag = MAF
hitsound = S2,2
guardsound = S130,0
pausetime = 8,8
guard.pausetime = 10,10
sparkNo = -1 + 0 * (var(33) := 8013)
guard.sparkNo = -1 + 0 * (var(34) := 8001)
sparkXY = -10 + 0 * (var(35) := 50), var(36) := -110
air.animtype = Back
fall.animtype = Back
ground.type = Low
air.type = Low
ground.slidetime = 18
ground.hittime  = 18
guard.hittime = 18
ground.velocity = -2, ifelse(var(49) >= 1, -5, -10)   ;Abstract Reordered: 2nd one drops
air.velocity = -2, ifelse(var(49) >= 1, -5, -10)
guard.velocity = -5
airguard.velocity = -5, -2
airguard.ctrlTime = 16
ground.cornerPush.velOff = 0
guard.cornerPush.velOff = 0
air.cornerPush.velOff = 0
yaccel = ifelse(var(49) >= 1, .9, .5)
fall = 1
fall.recover = 0
forcestand = 0
palFX.time = 12 * var(9)
palFX.add = 255,255,255
palFX.sinAdd= -255,-255,-255,48
envshake.time = 14
envshake.ampl = 4
envShake.freq = 140

[State 1020, StateTypeSet: Idle]
type = StateTypeSet
trigger1 = AnimElemTime(6) >= 0
moveType = I

[State 1020, End]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

