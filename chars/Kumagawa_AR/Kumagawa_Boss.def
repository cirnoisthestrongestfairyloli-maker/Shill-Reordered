;--| 基本情報 |---------------------------------------------------------------

[Info]
Name         = "Kumagawa Misogi"  ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "The Good Loser"  ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 04,14,2002     ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 04,14,2002     ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "Elecbyte"     ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 1,2,3;ＣＰＵで出てきた時のカラーパレットの順番

;-----------------------------------------------------------------------------
[Files]
Cmd     = kumagawa_cmd.cns   ;コマンドファイルの登録
Cns     = kumagawa.cns       ;コンスタンツファイルの登録
St      = kumagawa.cns       ;ステートファイルの登録・最大１１個まで増やせます
                             ;（St,St0,St1,St2,St3,St4,St5,St6,St7,St8,St9）
                             ;「St」のみ必要な項目なので省略出来ません
st1 = kumagawa_intro.cns
st2 = kumagawa_-2.cns
st3 = kumagawa_N.cns
st4 = kumagawa_S.cns
st5 = kumagawa_H.cns
st6 = kumagawa_Helper.cns
st7 = kumagawa_ex.cns
st8 = kumagawa_AI.cns
st9 = kumagawa_AR.cns
movelist = kumagawa_movelist.dat
                        
StCommon = common.cns  		 ;コモンステートファイルの登録
Sprite  = kumagawa.sff       ;複数のＰＣＸ画像をまとめたスプライトファイルの登録
Anim    = kumagawa.air       ;アニメーションファイルの登録
Sound   = kumagawa.snd       ;複数のＷＡＶＥ音声をまとめたサウンドファイルの登録

;--| カラーパレットファイル |-------------------------------------------------

Pal1 = act/ar_01_default.act	;Default
Pal2 = act/ar_02_own.act	;2 Zenkichi (Medaka Box)
Pal3 = act/ar_03_sunset.act	;3 Sunset
Pal4 = act/ar_04_azure.act	;4 Azure
Pal5 = act/ar_05_jade.act	;5 Jade
Pal6 = act/ar_06_orchid.act	;6 Orchid
Pal7 = act/ar_07_rose.act	;7 Rose
Pal8 = act/ar_08_pastel.act	;8 Pastel
Pal9 = act/ar_09_ice.act	;9 Ice
Pal10 = act/ar_10_noir.act	;10 Noir
Pal11 = act/ar_11_gold.act	;11 Gold
Pal12 = act/ar_12_ember.act	;12 Ember
Pal13 = act/ar_13_cross.act	;13 Satoru Gojo (Jujutsu Kaisen)
Pal14 = act/bossrush.act   ;Abstract Reordered: boss rush colour (locked until this character clears boss rush)



