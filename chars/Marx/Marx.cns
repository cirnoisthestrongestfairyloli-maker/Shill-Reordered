[State 0, PosSet]
type = ctrlset
trigger1 = roundstate > 1
trigger1 = prevstateno != [190,194]
trigger1 = prevstateno != 0
value = 1

[State 0, VarSet]
type = null;VarSet
trigger1 = ctrl
trigger1 = roundstate < 3
trigger2 = var(5) != -1
trigger2 = prevstateno != [180, 199]
trigger2 = prevstateno != [10180, 10199]
trigger2 = prevstateno != 5900
trigger2 = prevstateno
trigger2 = var(3)*4 > var(1)
var(5) = 1
persistent = 0

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = roundstate > 2
trigger1 = var(3)*4 > var(1)
statetype = S

[State 0, VarSet]
type = VarSet
triggerall = var(5) = -1
trigger1 = !numhelper(1)
trigger1 = !numhelper(2)
trigger2 = numhelper(1)
trigger2 = numhelper(2)
trigger2 = helper(1), stateno = 1
trigger2 = helper(2), stateno = 1
trigger2 = helper(1), var(3) > 20
trigger2 = helper(2), var(3) > 20
trigger3 = numhelper(1)
trigger3 = !numhelper(2)
trigger3 = helper(1), stateno = 1
trigger3 = helper(1), var(3) > 20
trigger4 = !numhelper(1)
trigger4 = numhelper(2)
trigger4 = helper(2), stateno = 1
trigger4 = helper(2), var(3) > 20
var(5) = 1
persistent = 0

[State 0, VelAdd]
type = VelAdd
triggerall = !ailevel
triggerall = ctrl
trigger1 = vel x <= 2
trigger1 = (command = "holdfwd")
x = 0.2

[State 0, VelAdd]
type = VelAdd
triggerall = !ailevel
triggerall = ctrl
trigger1 = vel x >= -2
trigger1 = (command = "holdback")
x = -0.2

[State 0, VelSet]
type = Velmul
trigger1 = !(command = "holdfwd")
trigger1 = !(command = "holdback")
x = .9

[State 0, VelAdd]
type = varAdd
triggerall = !ailevel
triggerall = ctrl
trigger1 = fvar(13) <= -10
trigger1 = (command = "holddown")
fvar(13) = 1

[State 0, VelAdd]
type = varAdd
triggerall = !ailevel
triggerall = ctrl
trigger1 = fvar(13) >= -80
trigger1 = (command = "holdup")
fvar(13) = -1

[State 0, VarAdd]
type = VarAdd
trigger1 = 1
var(3) = 1

[State 0, VarAdd]
type = VarAdd
trigger1 = 1
var(0) = 1

[State 0, VarSet]
type = VarSet
triggerall = numhelper(3)
trigger1 = prevstateno != [9100, 9105]
trigger2 = var(3) != [1, var(1)]
fvar(2) = pos x*0.95 + helper(3), pos x*0.05

[State 0, VarSet]
type = VarSet
triggerall = numhelper(3)
trigger1 = prevstateno = [9100, 9105]
trigger1 = var(3) = [1, var(1)]
fvar(2) = (pos x*(1 - var(3)*fvar(0)) + helper(3), pos x*var(3)*fvar(0))*(1 - var(3)*fvar(0)) + (pos x*0.95 + helper(3), pos x*0.05)*var(3)*fvar(0)

[State 0, PosSet]
type = PosSet
trigger1 = numhelper(3)
trigger1 = var(3) > var(1)
y = fvar(3)

[State 0, PosSet]
type = changestate
trigger1 = ailevel
trigger1 = var(34) != 0
trigger1 = fvar(35) >= 30
trigger1 = enemynear,stateno = 5145
value = 2999

[State 0, PosSet]
type = PosSet
trigger1 = numhelper(3)
trigger1 = var(3) = [1, var(1)]
x = fvar(2);pos x*0.95 + helper(3), pos x*0.05
y = pos y*(1 - var(3)*fvar(0)) + fvar(3)*var(3)*fvar(0)

