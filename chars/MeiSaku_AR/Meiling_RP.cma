;-| Button Remapping |-----------------------------------------------------
; If the following lines are NOT preceded by semicolons, please
; add them or remove the remap entirely since Ricepigeon is a
; lazy bastard who forgets to remove it before releasing stuff
; *facepalms*
;[Remap]
;x = x
;y = y
;z = b;z
;a = s;a
;b = a;b
;c = c
;s = z

;-| Default Values |-------------------------------------------------------
[Defaults]
; Default value for the "time" parameter of a Command. Minimum 1.
command.time = 15
; Default value for the "buffer.time" parameter of a Command. Minimum 1,
; maximum 30.
command.buffer.time = 1

;-| Single Button |---------------------------------------------------------
[Command]
name = "a"
command = x
time = 1
buffer.time = 2

[Command]
name = "b"
command = y
time = 1
buffer.time = 2

[Command]
name = "c"
command = z
time = 1
buffer.time = 2

[Command]
name = "x"
command = a
time = 1
buffer.time = 2

[Command]
name = "y"
command = b
time = 1
buffer.time = 2

[Command]
name = "z"
command = c
time = 1
buffer.time = 2
[Command]
name = "x2"
command = a
time = 1
buffer.time = 1
[Command]
name = "y2"
command = b
time = 1
buffer.time = 1
[Command]
name = "z2"
command = c
time = 1
buffer.time = 1

[Command]
name = "U"
command = U
time = 1
[Command]
name = "U"
command = UF
time = 1
[Command]
name = "U"
command = UB
time = 1

[Command]
name = "start"
command = s
time = 1
buffer.time = 2

;-| Hold Dir |--------------------------------------------------------------
[Command]
name = "holdfwd";Required (do not remove)
command = /$F
time = 1

[Command]
name = "holdback";Required (do not remove)
command = /$B
time = 1

[Command]
name = "holdup" ;Required (do not remove)
command = /$U
time = 1

[Command]
name = "holddown";Required (do not remove)
command = /$D
time = 1

[Command]
name = "fwd";Required (do not remove)
command = F
time = 1

[Command]
name = "back";Required (do not remove)
command = B
time = 1

[Command]
name = "up" ;Required (do not remove)
command = U
time = 1

[Command]
name = "down";Required (do not remove)
command = D
time = 1

;-| Hold Button |----------------------------------------------------------
; Please define Anim 74140108 in your AIR file if AND ONLY IF you place these
; 7 Hold Button commands immediately after the 11 Single Button and Hold Dir
; commands at the very top of your CMD list, as demonstrated here.
; In this version of the AI code, these commands are only used by the XOR
; method, and thus are optional.  But there remains a possibility that a
; future version of the helper method might be helped by having these
; commands placed here, and Anim 74140108 would then be used to indicate
; that a partner character has a compatible CMD.

[Command]
name = "holda"
command = /x
time = 1

[Command]
name = "holdb"
command = /y
time = 1

[Command]
name = "holdc"
command = /z
time = 1

[Command]
name = "holdx"
command = /a
time = 1

[Command]
name = "holdy"
command = /b
time = 1

[Command]
name = "holdz"
command = /c
time = 1

[Command]
name = "holdstart"
command = /s
time = 1

