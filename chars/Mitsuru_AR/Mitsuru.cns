[Data]
life               = 950 ;Abstract Reordered: roster standard
power              = 5000
attack             = 90 ;Abstract Reordered
defence            = 100
fall.defence_up    = 50
liedown.time       = 60
airjuggle          = 30
sparkno            = 2
guard.sparkno      = 40
KO.echo            = 0
volume             = 255
volumescale        = 255
IntPersistIndex    = 37
FloatPersistIndex  = 31

[Size]
xscale             = .335
yscale             = .335
ground.back        = 18
ground.front       = 18
air.back           = 18
air.front          = 18
height             = 70
attack.dist        = 155
proj.attack.dist   = 60
proj.doscale       = 0
head.pos           = 5,-127
mid.pos            = 5,-59
shadowoffset       = 0
draw.offset        = 0,0

[Velocity]
walk.fwd           = 2
walk.back          = -1.6
run.fwd            = 7.5,0
run.back           = 0,0
jump.neu           = 0,-9.8
jump.back          = -4.5
jump.fwd           = 4.0
runjump.back       = -5,-10.8
runjump.fwd        = 6.2,-10.8
airjump.neu        = 0,-9.1
airjump.back       = -3.5
airjump.fwd        = 4.1

[Movement]
airjump.num        = 1
airjump.height     = 35
yaccel             = .49
stand.friction     = .72
crouch.friction    = .78

[Quotes]
victory1 = "C'est magnifique! A perfect victory!"
victory2 = "I'm sorry, but I cannot stop now. I'm on a mission."
victory3 = "I hope you don't think ill of me. I cannot lose, for the sake of my burden..."
victory4 = "No matter how many times you come at me, I will continue to strike you down... None shall stand in my way!"
victory5 = "No matter what the circumstances, I cannot afford to lose. If you'll still come at me knowing this, then I'll show no mercy!"
victory6 = "The execution queen, hm...? Not an honorable nickname by most perspectives, but it's not all bad. I will strike down all that stand in my way!"
victory7 = "There's no need to be frustrated. It just happened that I was a little stronger than you."

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0]
type = varset
trigger1 = AnimTime = 0
var(20) = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 95
value = S0,random %4
volume = 355
channel = 8
[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 97
value = S1,10
volumescale = 355

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 20
value = 22

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 21
value = 23

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && anim != [20,23]
trigger2 = Anim = 5 && AnimTime = 0
trigger3 = (anim = 22 || anim = 23)
trigger3 = animtime = 0
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, DestroySelf]
type = DestroySelf
trigger1 = IsHelper

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

