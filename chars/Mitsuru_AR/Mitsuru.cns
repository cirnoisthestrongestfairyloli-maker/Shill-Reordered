;-------------------------------------------------------------------------------------
;Abstract Reordered: her burst meter var(50) is now the AR burst: ready (100) when the 75 second cooldown var(24) is 0.
;var(24) = cooldown ticks (4500 = just used, 0 = ready).
[State -3, AR burst spent]
type = VarSet
triggerall = !ishelper
triggerall = var(24) = 0
trigger1 = StateNo = [6000,6002]
var(24) = 4500
ignorehitpause = 1

[State -3, AR burst gauge sync]
type = VarSet
triggerall = !ishelper
trigger1 = 1
var(50) = ifelse(var(24) = 0, 100, 0)
ignorehitpause = 1

