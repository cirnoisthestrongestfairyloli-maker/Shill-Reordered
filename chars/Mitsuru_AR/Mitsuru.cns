;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State Distance, Inaccurate P2 Locater]
type=null
trigger1=numenemy
trigger1=var(0):=(ceil(enemynear,pos x-pos x)*facing)

[State 0, StopSnd]
type = StopSnd
trigger1 = StateNo != 250
channel = 3

[State -2]
type = Helper
TriggerAll = TeamMode = Simul
trigger1 = roundstate = 3
trigger1 = numhelper(8000) = 0
trigger1 = Partner,NumHelper(8000) = 0
trigger1 = Enemy,NumHelper(8000) = 0
trigger1 = !Enemy,Alive
helpertype = normal
ID = 8000
stateno = 8000
pos = 0,0
postype = back
ownpal = 1
ignorehitpause = 1
persistent = 0
[State -2]
type = Helper
TriggerAll = TeamMode = Single || TeamMode = Turns
trigger1 = roundstate = 3
trigger1 = numhelper(8000) = 0
trigger1 = Enemy,NumHelper(8000) = 0
trigger1 = !Enemy,Alive
helpertype = normal
ID = 8000
stateno = 8000
pos = 0,0
postype = back
ownpal = 1
ignorehitpause = 1
persistent = 0

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noKOslow
ignorehitpause = 1
persistent = 0

