add = 40,40,40
mul = 256,256,256
sinadd = 20,20,20,30
invertall = 0
color = 256
ignorehitpause = 1
[State 0, PalFXWiz]
type = PalFX
TriggerAll = Alive
TriggerAll = var(49) > 3
trigger1   = gametime%17 = 0
time = 17
add = -40,-40,-40
mul = 230,230,230
sinadd = 40,40,40,17
invertall = 0
color = 256
ignorehitpause = 1

