; AOA BOING!
[Statedef 630]
type    = L
movetype= H
physics = N
velset = 0,0
ctrl = 0

[State 606, 1]
type = VelSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
trigger1 = vel x > 1
x = 1

[State 606, EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State 606, Var] ;Save fall velocity
type = VarSet
trigger1 = Time = 0
sysvar(1) = floor(vel y)

[State 606, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = (anim != [5051,5059]) && (anim != [5061,5069])
trigger2 = !SelfAnimExist(5100 + (anim % 10))
value = 5100

[State 606, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
trigger1 = time = 0
trigger1 = (anim = [5051,5059]) || (anim = [5061,5069])
trigger1 = SelfAnimExist(5100 + (anim % 10))
value = 5100 + (anim % 10)

[State 606, 4]
type = PosSet
trigger1 = Time = 0
y = 0

[State 606, 5]
type = VelSet
trigger1 = Time = 0
y = 0

[State 606, 6] ;Reduce speed
type = VelMul
trigger1 = Time = 0
x = 0.4

[State 606, 5]
type = VelSet
trigger1 = AnimTime = 0
y = -6.3
x = -1

[State 606, 1]
type = StateTypeSet
trigger1 = AnimTime = 0
physics = A

[State 606, 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 631

