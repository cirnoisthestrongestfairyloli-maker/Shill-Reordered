[State 7741, Freeze]
type = Pause
trigger1 = Time = 0
time = 15
movetime = 15
ignorehitpause = 1
persistent = 1

[State 7741, Flash]
type = EnvColor
trigger1 = Time = 0
value = 200, 230, 255
time = 1

[State 7741, Hold pose]
type = ChangeAnim
trigger1 = AnimTime = 0
