;--------------------- Variable List ----------------------

; var(0) - Turn var for normal throws, holding back while pressing forward to perform the throw backwards.
; var(10) - Used for stronger variants of certain specials so there's no separate states for them.
; var(20) - Language setting for dialogue intro against Applejack (English and Spanish)

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S170,random%3

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

