;---------------------------------------------------------------------------
; Face Sitting - Attempt
[Statedef 800]
type    = S
movetype= A
physics = S
juggle  = 0
velset = 0,0
ctrl = 0
anim = 800
sprpriority = 2
facep2 = 1

; Notes: The '-' symbol in the hitflag field means that it only affects
;   players who are not in a hit state. This prevents Panty from combo-ing
;   into the throw. The priority should be set to a low number, such as
;   1 or 2, so that the throw does not take precedence over normal attacks.
;   The type of priority must always be set to "Miss" or "Dodge" for throws,
;   otherwise strange behavior can result.
[State 800, 1]
type = HitDef
Trigger1 = Time = 0
trigger1 = var(30) = 0
attr = S, NT          ;Attributes: Standing, Normal Throw
hitflag = M-          ;Affect only ground people who are not being hit
priority = 1, Miss    ;Throw has low priority, must be miss or dodge type.
sparkno = -1          ;No spark
p1sprpriority = 1     ;Draw p1's sprite in front of p2
                      ;p2's sprite priority is set to 0 by default
hitsound = s1,1
p1facing = 1
p2facing = 1          ;Force p2 to face Panty
p1stateno = 810       ;On success, Panty changes to state 810
;p2stateno = 820       ;If hit, p2 changes to state 820 in Panty's cns
guard.dist = 0        ;This prevents p2 from going into a guard state if close
fall = 1              ;Force p2 into falling down

[State 800, PlaySnd]
type = PlaySnd
trigger1 = AnimElemTime(3) = 0
value = S5000,(random%4)

[State 800, Explod]
type = Explod
trigger1 = AnimElemTime(3) = 0
anim = 822
pos = 45,-87
sprpriority = 3
removetime = 15
ownpal = 1
facing = facing
bindtime = -1
supermovetime = 999999
pausemovetime = 999999

[State 800, 2]
type = ChangeState
Trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Face Sitting - Shoving to the opponent
[Statedef 810]
type    = S
movetype= A
physics = N
anim = 810
poweradd = 25

[State 810, Throw]
type= targetstate
trigger1 = !time && numtarget
value= 820

[State 810, Throw Sound]
type = PlaySnd
trigger1 = AnimElemTime(2) = 0
value = 800, 0

[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(1) = 0
pos = 18, 0

[State 810, Bind 2-4]
type = TargetBind
trigger1 = AnimElemTime(2) = 0
pos = 28, -54

[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(3) = 0
pos = 0, 0

[State 810, VelAdd]
type = velset
trigger1 = AnimElemTime(2) = 0
x = 4.8
y = -6

[State 810, 1] ;Gravity
type = VelSet
Trigger1 = time = 23
y = 8

[State 810, VelAdd]
type = targetvelset
trigger1 = AnimElemTime(2) = 0
x = 4.8
y = -6

[State 810, TargetVelSet]
type = TargetVelSet
Trigger1 = time = 23
y = 8

[State 810, ScreenBound]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 0,0

[State 3005, Explod]
type = Explod
trigger1 = AnimElemTime(2) = 0
anim = 801+random%2
pos = 0,-10
removetime = 15
sprpriority = -1
ownpal = 1
facing = facing
vel = 2,-.8

[State 810, Turn Var]
type = varset
trigger1 = !time
var(0) = 0

[State 810, Turn Var]
type = varset
trigger1 = !time
trigger1 = command = "holdback"
var(0) = 1

[State 810, Turn]
type = turn
trigger1 = !time && var(0)

[State 810, Throw]
type = targetfacing
trigger1 = time <= 1
value = -1

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = AnimElemTime(2) >= 0
statetype = A

[State 810, State End]
type = ChangeState
trigger1 = vel y > 0
trigger1 = pos y > 0
value = 822

