triggerall = var(20) = 0
triggerall = !NumHelper(17014) && (prevstateno = [191,199])
triggerall = (roundstate < 2)
triggerall = TeamSide = 1
trigger1 = enemy, name = "Applejack"
name = "Intro quotes"
stateno = 17014
postype = p1
