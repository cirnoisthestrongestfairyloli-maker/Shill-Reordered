;---------------------------------------------------------------------------
; Reload (X): all 6 rounds come back near the end; hit out of it = no reload
[Statedef 7730]
type     = S
movetype = I
physics  = S
ctrl     = 0
velset   = 0, 0
anim     = 7730
sprpriority = 2

[State 7730, Start]
type = PlaySnd
trigger1 = Time = 0
value = S1000, 11

[State 7730, Loaded]
type = VarSet
trigger1 = AnimElemTime(5) = 0
var(44) = 6

[State 7730, Click]
type = PlaySnd
trigger1 = AnimElemTime(5) = 0
value = S1000, 2

[State 7730, Done]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

