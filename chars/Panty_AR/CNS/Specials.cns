;---------------------------------------------------------------------------
; Backlace
[Statedef 1000]
type    = S
movetype= A
physics = S
juggle  = 4
poweradd= 100+10*(var(10)=2)
velset = 0,0
anim = 1000+3*(var(10)=2)
ctrl = 0
sprpriority = 2
facep2 = 1

[State 1000, AR ammo spent]
type = VarAdd
trigger1 = Time = 0
var(44) = -1

[State 1000, AR quick-draw shot]
type = VarSet
trigger1 = Time = 0
var(46) = var(45)

[State 1000, AR quick-draw used]
type = VarSet
trigger1 = Time = 0
var(45) = 0

[State 1000, PlaySnd]
type = PlaySnd
trigger1 = AnimElemTime(6) = 0
value = S1000,0

[State 1000, Helper]
type = Helper
trigger1 = AnimElemTime(6) = 1
pos = 51,-79
postype = p1
ID = 1001
stateno = 1001
name = "Bullet"
keyctrl = 0
ownpal = 1
ignorehitpause=1

[State 1000, AR quick-draw extra bullet]
type = Helper
trigger1 = AnimElemTime(6) = 7
trigger1 = var(46) = 1
pos = 51,-79
postype = p1
ID = 1001
stateno = 1001
name = "Bullet"
keyctrl = 0
ownpal = 1
ignorehitpause=1

[State 1000, AR quick-draw extra shot sound]
type = PlaySnd
trigger1 = AnimElemTime(6) = 7
trigger1 = var(46) = 1
value = S1000, 0

[State 1000, BLAM!]
type = Explod
trigger1 = AnimElemTime(6) = 0
anim = 1004
postype = p1
pos = 62,-93
removetime = -2
sprpriority = 3
facing = facing
ownpal = 1
ontop = 1

[State 210, Flag Recovery Frames]
type = statetypeset
trigger1 = animelemtime(6) = 0
trigger2 = movecontact || movereversed
movetype = I
persistent = 0
ignorehitpause = 1

[State 1000, Width]
type = Width
trigger1 = time = [3,28] 
value = 30,0

[State 1000, PlaySnd]
type = PlaySnd
trigger1 = AnimElemTime(3) = 0
value = S1000,11

[State 1000, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Backlace - Bullet
; CNS difficulty: medium
[Statedef 1001]
type    = A
movetype= A
physics = S
juggle  = 4
velset = 0,0
anim = 1002
ctrl = 0
sprpriority = 1

[State 1001, VelSet]
type = VelSet
trigger1 = 1
x = 13+3*(root,var(10)=2)
y = .8+.2*(root,var(10)=2)

[State 1001, 5]
type = HitDef
trigger1 = Time = 0
attr = S, SP
animtype = medium
damage = 45+25*(root,var(10)=2),9+3*(root,var(10)=2)
guardflag = MA
hitflag = MAF
priority = 4, Hit
pausetime = 0,6+4*((root,var(10)>=1))
hitsound = s1000, 1
guardsound = S1000,2+random%9
sparkno = -1
getpower = 15+5*(root,var(10)=2),15+5*(root,var(10)=2)
givepower = 16,16
guard.dist = 120
ground.slidetime = 15+2*((root,var(10)>=2))
ground.hittime = 15+2*((root,var(10)>=2))
guard.hittime = 9+2*((root,var(10)>=2))
ground.velocity = -3.2+-1*((root,var(10)>=2))
air.velocity = -3.2+-1*((root,var(10)>=2)),-2
airguard.velocity = -2.9+-1*((root,var(10)>=2)),-.8
yaccel = 0.5-.1*((root,var(10)>=2))
air.hittime = 12
fall.recovertime = 6
ground.cornerpush.veloff = 0
envshake.time = 5+5*(root,var(10)=2)

[State 1001, ChangeState]
type = ChangeState
trigger1 = movecontact && NumTarget
value = 1004

[State 1001, HitOverride]
type = hitoverride
trigger1 = 1
time = -1
attr = SCA, SP, HP, AP
stateno = 1002
ignorehitpause = 1

[State 1001, HitBy]
type = nothitby
trigger1 = 1
time = -1
value = , NA, NP, NT, HT, SA, HA, AA
ignorehitpause = 1

[State 1001, 7]
type = DestroySelf
trigger1 = movecontact && NumTarget

[State 1001, DestroySelf]
type = DestroySelf
trigger1 = frontedgedist < -50

[State 1001, ChangeState]
type = ChangeState
trigger1 = vel y > 0
trigger1 = pos y > 0
value = 1003

