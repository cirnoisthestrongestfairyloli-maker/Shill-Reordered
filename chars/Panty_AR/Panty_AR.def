; Definition file for Panty
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Panty Anarchy"        ;Name of character
displayname = "Panty Anarchy" ;Name of character to display
versiondate = 08,05,2018    ;Version date of character (MM-DD-YYYY)
mugenversion = 1.0   ;Version of M.U.G.E.N character works on
author = "Shimmering Brony"         ;Character author name
pal.defaults = 1,2,3;Default palettes in order of preference

; Files for the player
[Files]
cmd     = Coding/Panty.cmd   ;Command set
cns     = CNS/Panty.cns   ;Constants
stcommon = CNS/pantycommon.cns ;Common states
st      = CNS/Panty.cns   ;States
st2     = CNS/Specials.cns
st3     = CNS/Hypers.cns
st4     = CNS/Intro-dialogue.cns
st5     = Options.txt
st6     = CNS/Panty_AR.cns
sprite  = Coding/Panty.sff   ;Sprite
anim    = Coding/Panty.air   ;Animation
movelist = panty_movelist.dat
sound   = Coding/Panty.snd   ;Sound
Pal1 = ACT/ar_01_default.act	;Default
Pal2 = ACT/ar_02_stocking.act	;2 Stocking Anarchy
Pal3 = ACT/ar_03_sunset.act	;3 Sunset
Pal4 = ACT/ar_04_azure.act	;4 Azure
Pal5 = ACT/ar_05_jade.act	;5 Jade
Pal6 = ACT/ar_06_orchid.act	;6 Orchid
Pal7 = ACT/ar_07_rose.act	;7 Rose
Pal8 = ACT/ar_08_pastel.act	;8 Pastel
Pal9 = ACT/ar_09_ice.act	;9 Ice
Pal10 = ACT/ar_10_noir.act	;10 Noir
Pal11 = ACT/ar_11_gold.act	;11 Gold
Pal12 = ACT/ar_12_ember.act	;12 Ember
Pal13 = ACT/ar_13_jupiter.act	;13 Sailor Jupiter
Pal14 = ACT/bossrush.act   ;Abstract Reordered: boss rush colour (locked until this character clears boss rush)

; Arcade mode
[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
