trigger1 = MoveHit
trigger1 = NumTarget(7761)
var(8) = 1
ignorehitpause = 1

[State 7761, Hop (the one re-jump)]
type = VelSet
trigger1 = NumTarget(7761)
trigger1 = MoveHit
trigger1 = Time >= 16
y = -4

