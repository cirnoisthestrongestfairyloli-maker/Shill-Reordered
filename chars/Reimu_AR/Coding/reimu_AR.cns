;---------------------------------------------------------------------------
; Charged 6j.C (hold C): released early = normal j.C kick (650).
; Full charge: the first one in a combo spikes them into a ground bounce (7765/7766) and gives
; Reimu one hop with control (a re-jump). A second one in the same combo (var(8)) has no bounce
; and they can tech out at once, so the combo drops.

[Statedef 7760]
type     = A
movetype = A
physics  = N
ctrl     = 0
anim     = 650
sprpriority = 2

[State 7760, Windup pose]
type = ChangeAnim
trigger1 = 1
value = 650
elem = 1

[State 7760, Hover]
type = VelSet
trigger1 = Time = 0
x = vel x * 0.3
y = 0

[State 7760, Drift]
type = VelAdd
trigger1 = 1
y = 0.05

[State 7760, Charging flash]
type = PalFX
trigger1 = Time % 8 = 0
trigger1 = Time < 22
time = 4
add = 200, 60, 70

[State 7760, Fully charged]
type = PalFX
trigger1 = Time = 22
time = 8
add = 255, 120, 140

[State 7760, Land]
type = ChangeState
trigger1 = Pos Y >= 0
trigger1 = Vel Y > 0
value = 52

[State 7760, Early release]
type = ChangeState
trigger1 = command != "hold_c"
trigger1 = Time < 22
value = 650

[State 7760, Release]
type = ChangeState
trigger1 = Time >= 22
value = 7761

