;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0]
type = ChangeAnim
triggerall = var(1) = 10000
trigger1 = (anim = 5) && (anim != [10000,10005])
value = 10005

[State 0]
type = ChangeAnim
trigger1 = ifelse(var(1)=10000,(Anim != [10000,10005]),(Anim != [0,5]))
trigger2 = ifelse(var(1)=10000,(Anim = [10001,10005]),(Anim = [1,5]))
trigger2 = AnimTime = 0
value = var(1)

[State 0]
type = ChangeAnim
triggerall = roundstate <= 2
trigger1 = (Anim = var(1)) && AnimTime = 0
trigger1 = random <= 234
value = 1 + var(1)

[State 0]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0]
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0]
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10+var(1)

[State 10]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11+var(1)
sprpriority = 0

[State 11]
type = ChangeAnim
trigger1 = Anim = 6+var(1) && AnimTime = 0
value = 11+var(1)

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12+var(1)

[State 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20]
type = VelSet
trigger1 = command = "holdfwd" && Time < 10
x = const(velocity.walk.fwd.x)

[State 20]
type = VelSet
trigger1 = command = "holdfwd" && AnimElemTime(4) >= 0 && AnimElemTime(6) < 0
x = 1.35
[State 20]
type = VelSet
trigger1 = command = "holdfwd" && AnimElemTime(6) >= 0 && AnimElemTime(8) < 0
x = 0.9
[State 20]
type = VelSet
trigger1 = command = "holdfwd" && AnimElemTime(8) >= 0 && AnimElemTime(11) < 10
x = 0.5

[State 20]
type = VelSet
trigger1 = command = "holdback" && Time < 7
x = const(velocity.walk.back.x)

[State 20]
type = VelSet
trigger1 = command = "holdback" && AnimElemTime(3) >= 0 && AnimElemTime(5) < 0
x = -1.35
[State 20]
type = VelSet
trigger1 = command = "holdback" && AnimElemTime(5) >= 0 && AnimElemTime(7) < 0
x = -0.9
[State 20]
type = VelSet
trigger1 = command = "holdback" && AnimElemTime(7) >= 0 && AnimElemTime(10) < 7
x = -0.5

[State 20]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20+var(1) && Anim != 5+var(1)
trigger2 = Anim = 5+var(1) && AnimTime = 0
value = 20+var(1)

[State 20]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21+var(1) && Anim != 5+var(1)
trigger2 = Anim = 5+var(1) && AnimTime = 0
value = 21+var(1)

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40+var(1)
ctrl = 0
sprpriority = 1

[State 40]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------
; 飛び
[Statedef 45]
type = A
movetype = I
physics = N
anim = 70
velset = 0, 0
ctrl = 0

[State 45]
type = ScreenBound
trigger1 = AnimElemNo(0) = 1
value = 0
movecamera = 1, 1

[State 45]
type = PlayerPush
trigger1 = AnimElemNo(0) = 1
value = 0

[State 45]
type = PosSet
trigger1 = Time = 0
x = IfElse(Facing = 1,-135,135)

[State 45]
type = PosFreeze
trigger1 = Time > 0 && AnimElemNo(0) = 2

[State 45]
type = VelSet
trigger1 = AnimTime = 0
x = Const(velocity.jump.fwd.x)
y = Const(velocity.jump.y)

[State 45]
type = ChangeState
trigger1 = AnimTime = 0
value = 47

;-----------------------------
; 飛び
[Statedef 47]
type    = A
physics = A
ctrl = 0

[State 47]
type = PlaySnd
trigger1 = Time = 0
value = 6, 3

[State 47]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 47]
type = ChangeAnim
trigger1 = Time = 0
value = 41+var(1)

[State 47]
type = CtrlSet
trigger1 = time = 2
value = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50]
type = PlaySnd
trigger1 = time = 0
value = 6,1

[State 50]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0,(41+var(1)),ifelse((vel x)>0,(42+var(1)),(43+var(1))))

[State 50]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

