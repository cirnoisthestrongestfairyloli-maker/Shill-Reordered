;-----------------------------------------------------------------------------
; スーパージャンプ
[Statedef 95]
type    = S
physics = S
anim = 40+var(1)
ctrl = 0
sprpriority = 1

[State 95]
type = VarSet
trigger1 = time = 0
v = 3
value = 1

[State 95]
Type = AfterImage
Trigger1 = Time = 0
Time = 60
FrameGap = 3
Length = 9
PalBright   =  10,10,10
PalContrast =  80, 80, 100
Trans = Add1

[State 95]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 95]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 95]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 95]
type = VelSet
trigger1 = prevstateno = 420
trigger1 = AnimTime = 0
x = 4
y = -15

[State 95]
type = VelSet
trigger1 = prevstateno != 420
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))*0.8
y = -17

[State 95]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 95]
type = ChangeState
trigger1 = AnimTime = 0
value = 99
ctrl = 1

[Statedef 99]
type    = A
physics = A
anim = 95+var(1)
ctrl = 1

[State 99]
type = PlaySnd
trigger1 = Time = 0
trigger1 = PrevStateNo = 95
value = 6,5

[State 99]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 99]
Type = Veladd
trigger1 = command = "holdfwd"
trigger1 = Vel X < 2
X = 0.3

[State 99]
Type = Veladd
trigger1 = command = "holdback"
trigger1 = Vel X > -2
X = -0.3

[State 99]
type = Turn
trigger1 = P2Dist X < 0

