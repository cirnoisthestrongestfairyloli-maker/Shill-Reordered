type    = A
movetype= H
physics = N
velset = 0
ctrl = 0
anim = 5200+var(1)

[State Snd]
type = PlaySnd
trigger1 = AnimElemTime(3) = 0
value = 10,1

[State 5201]
type = Turn
trigger1 = Time = 0
trigger1 = p2dist X < -5

[State 5201]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5201]
type = VelSet
trigger1 = AnimElemTime(3) = 0
x = -3
y = -3.2
[State 5201]
type = VelAdd
trigger1 = AnimElemTime(3) >= 0
y = .3

[State 5201]
type = NotHitBy
trigger1 = AnimElemTime(5) < 0
value = SCA
time = 1

[State 5210]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52
ctrl = 1

