trigger1 = Time = 0
trigger1 = p2dist X < -20

[State 5210] 
type = VelMul
trigger1 = Time = 4
x = .8
y = .8

[State 5210]
type = VelAdd
trigger1 = Time = 4
y = -4.5

[State 5210] 
