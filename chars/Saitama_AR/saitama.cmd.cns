[State -1, AR burst]
type = ChangeState
value = ifelse(StateType = A, 7751, 7750)
triggerall = !ishelper
triggerall = command = "ar_burst"
triggerall = fvar(30) = 0
triggerall = RoundState = 2
triggerall = Alive
trigger1 = (stateno = 5000 || stateno = 5010 || stateno = 5020 || stateno = 5070) && Time > 0
trigger2 = stateno = [5001, 5099]
trigger2 = stateno != 5000 && stateno != 5010 && stateno != 5020 && stateno != 5070

;=== END AR BURST ===

;Abstract Reordered: parry on Z
[State -1, AR Parry]
type = ChangeState
value = 7740
triggerall = command = "ar_parry"
trigger1 = ctrl

;Abstract Reordered: X arms one Serious stock (no animation). The next special or super is Serious.
[State -1, AR serious arm sound]
type = PlaySnd
triggerall = !IsHelper
triggerall = command = "ar_serious"
triggerall = RoundState = 2 && Alive && MoveType != H
triggerall = fvar(21) = 0 && fvar(22) = 0 && fvar(20) >= 1000
trigger1 = 1
value = 190, 0
channel = 0

[State -1, AR serious arm flash]
type = PalFX
triggerall = !IsHelper
triggerall = command = "ar_serious"
triggerall = RoundState = 2 && Alive && MoveType != H
triggerall = fvar(21) = 0 && fvar(22) = 0 && fvar(20) >= 1000
trigger1 = 1
time = 10
add = 160, 60, 40

[State -1, AR serious arm]
type = VarSet
triggerall = !IsHelper
triggerall = command = "ar_serious"
triggerall = RoundState = 2 && Alive && MoveType != H
triggerall = fvar(21) = 0 && fvar(22) = 0 && fvar(20) >= 1000
trigger1 = 1
fvar(21) = 1

;--- supers
[State -1, AR Serious Punch (Lv3)]
type = ChangeState
value = 3100
triggerall = command = "ar_lv3"
triggerall = power >= 3000
triggerall = StateType != A
trigger1 = ctrl
trigger2 = (StateNo = [200, 250] || StateNo = [400, 440]) && var(44)

[State -1, AR Serious Table Flip (Lv2)]
type = ChangeState
value = 1600
triggerall = command = "ar_22x"
triggerall = power >= 2000
triggerall = StateType != A
trigger1 = ctrl
trigger2 = (StateNo = [200, 250] || StateNo = [400, 440]) && var(44)

[State -1, AR Serious Consecutive Normal Punches (Lv2)]
type = ChangeState
value = 1700
triggerall = command = "ar_214214"
triggerall = power >= 2000
triggerall = StateType != A
trigger1 = ctrl
trigger2 = (StateNo = [200, 250] || StateNo = [400, 440]) && var(44)

[State -1, AR Consecutive Normal Punches (Lv1)]
type = ChangeState
value = 1400
triggerall = command = "ar_236236"
triggerall = power >= 1000
triggerall = StateType != A
trigger1 = ctrl
trigger2 = (StateNo = [200, 250] || StateNo = [400, 440]) && var(44)

;--- specials
[State -1, AR Normal Punches]
