;commands edited by EstebanG18
;===================< BUTTON REMAPPING >===================
[Remap]
x = x
y = y
z = z
a = a
b = b
c = c
s = s



;===================< DEFAULT VALUES >===================
[Defaults]
command.time = 30
command.buffer.time = 1


;-| Killer Moves|--------------------------------------------------------

[command]
name = "Killer_Move_Serious_Table_Flip"
command = ~D,DB,B,x+y
time = 30

[command]
name = "S-Side Hops"
command = ~D,DF,F,a+b
time = 30

[command]
name = "S-Serious_Punch"
command = ~D,D,c+z
time = 30



;-| Super Motions |--------------------------------------------------------

[Command]
name = "CN-punches";"cnpx"
command = ~D,DF,F,x+y
time = 30

[command]
name = "LV2_CN-Punches"
command = ~D,DF,F,b+c
time = 15

;-| Special Motions |------------------------------------------------------

[Command]
name = "cnpx"
command = ~D,DF,F,x
time = 30

[Command]
name = "cnpy"
command = ~D,DF,F,y
time = 30

[Command]
name = "cnpz"
command = ~D,DF,F,z
time = 30



[Command]
name = "cnpa"
command = ~D,DF,F,a
time = 30

[Command]
name = "cnpb"
command = ~D,DF,F,b
time = 30

[Command]
name = "cnpc"
command = ~D,DF,F,c
time = 30
