;--- system
[State -1, AR Grab]
type = ChangeState
value = 800
triggerall = command = "ar_grab"
triggerall = StateType = S || StateType = C
trigger1 = ctrl

[State -1, Run Fwd]
type = ChangeState
value = 100
triggerall = command = "FF"
triggerall = StateType = S
trigger1 = ctrl

[State -1, Run Back]
type = ChangeState
value = 105
triggerall = command = "BB"
triggerall = StateType = S
trigger1 = ctrl

[State -1, Taunt]
type = ChangeState
value = 195
triggerall = command = "start"
triggerall = StateType != A
trigger1 = ctrl

;--- normals: Light -> Medium -> Heavy on contact (hit or block), standing into crouching
[State -1, 5C]
type = ChangeState
value = 220
triggerall = command = "c"
triggerall = command != "holddown"
triggerall = command != "holdfwd"
triggerall = StateType != A
trigger1 = ctrl
trigger2 = StateNo = [200, 215] && var(44)
trigger3 = StateNo = [400, 440] && StateNo != 420 && var(44)

[State -1, 6C]
type = ChangeState
value = 250
triggerall = command = "c"
triggerall = command != "holddown"
triggerall = command = "holdfwd"
triggerall = StateType != A
