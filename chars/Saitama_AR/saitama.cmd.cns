;---------------------------------------------------------------------------
; 2. State entry


; Don't remove the following line. It's required by the CMD standard.
[Statedef -1]

;===========================================================================
[State -1, No Push]
type = PlayerPush
trigger1 = 1
value = 0
ignorehitpause = 1

[State -1, No Push Dummy]		; Allows player to be able to push opponent withput opponent being able to push player
type = Helper
trigger1 = Var(50) = [0, 1]
trigger1 = StateNo != 5150
trigger1 = !NumHelper(10003 + IsHelper(13210))
trigger1 = Life
trigger1 = !Lose
trigger1 = RoundState > 0
name = "No Push"
id = 10003 + IsHelper(13210)
stateno = 10002
size.ground.back = Const(size.ground.back) * !Var(50) + 20 * (Var(50) = 1)
size.ground.front = Const(size.ground.front) * !Var(50) + 20 * (Var(50) = 1)
size.height = Const(size.height) * !Var(50) + 60 * (Var(50) = 1)

[State -1, Clone - ScreenBound]
type = ScreenBound
trigger1 = NumHelper(13210)
value = 1

[State -1, Clone - Life < 0]
type = VarSet
triggerall = IsHelper(13210)
trigger1 = Var(21) < 0
var(21) = 0

[State -1, Clone - Reduce Red Bar]
type = VarAdd
triggerall = IsHelper(13210)
triggerall = Var(30) > Var(21)
trigger1 = MoveType != H
trigger2 = StateNo = 5150
var(30) = -1 * 5	; Speed of reduction

;===========================================================================
;---------------------------------------------------------------------------
;Run Fwd
[State -1, Run Fwd]
type = ChangeState
value = 100
trigger1 = command = "FF"
trigger1 = statetype = S
trigger1 = ctrl

;---------------------------------------------------------------------------
;Run Back
[State -1, Run Back]
type = ChangeState
value = 105
trigger1 = command = "BB"
trigger1 = statetype = S
trigger1 = ctrl

;===========================================================================
;Taunt
[State -1, Taunt]
type = ChangeState
value = 195
triggerall = command = "start"
trigger1 = statetype != A
trigger1 = ctrl
;---------------------------------------------------------------------------

;Teleport near
[State -1,Teleport-1]
type = ChangeState
value = 1040
triggerall = command = "Teleport-1"
triggerall = StateType = S
trigger1 = Ctrl || (var(40)=[1,3])
trigger2 = var(30) = 2 && var(40) = 4 && (StateNo != [1200,1299])
trigger3 = (stateno = 220) && time > 6
trigger4 = (stateno = 250) && time > 6
ignorehitpause = (var(40) = 4)
triggerall = var(50) = 0
