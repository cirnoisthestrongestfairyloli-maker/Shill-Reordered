;commands edited by EstebanG18
;===================< BUTTON REMAPPING >===================
[Remap]
x = x
y = y
z = z
a = a
b = b
c = c
s = s



;===================< DEFAULT VALUES >===================
[Defaults]
command.time = 30
command.buffer.time = 1


;Abstract Reordered: A/B/C = light/medium/heavy, X = Serious, Y = grab, Z = parry, A+B+C = burst
