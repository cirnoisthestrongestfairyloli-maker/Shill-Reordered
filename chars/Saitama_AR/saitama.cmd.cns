; 2. State entry
[Statedef -1]

[State -1, No Push]
type = PlayerPush
trigger1 = 1
value = 0
ignorehitpause = 1

[State -1, No Push Dummy]		; Allows player to be able to push opponent withput opponent being able to push player
type = Helper
trigger1 = Var(50) = [0, 1]
trigger1 = StateNo != 5150
trigger1 = !NumHelper(10003 + IsHelper(13210))
trigger1 = Life
trigger1 = !Lose
trigger1 = RoundState > 0
name = "No Push"
id = 10003 + IsHelper(13210)
stateno = 10002
size.ground.back = Const(size.ground.back) * !Var(50) + 20 * (Var(50) = 1)
size.ground.front = Const(size.ground.front) * !Var(50) + 20 * (Var(50) = 1)
size.height = Const(size.height) * !Var(50) + 60 * (Var(50) = 1)

;---------------------------------------------------------------------------
;Abstract Reordered: burst (Kamijo's) - A+B+C while being hit, recharges in 75 s (fvar(30))
[State -1, AR burst round reset]
type = VarSet
triggerall = !ishelper
trigger1 = RoundState < 2
fvar(30) = 0

[State -1, AR burst recharge]
type = VarAdd
triggerall = !ishelper
trigger1 = RoundState = 2
trigger1 = fvar(30) > 0
fvar(30) = -1
ignorehitpause = 1

;Abstract Reordered: comeback - once a combo has done more than 15% of max life, every further hit
;knocks half a second (30 ticks) off the burst cooldown. fvar(31) = life when the combo started, fvar(33) = life last tick
[State -1, AR burst comeback]
type = VarAdd
triggerall = !ishelper
triggerall = fvar(30) > 0
trigger1 = movetype = H
trigger1 = Life < fvar(33)
trigger1 = fvar(31) - Life > LifeMax * 0.15
fvar(30) = -30
ignorehitpause = 1

[State -1, AR burst comeback clamp]
type = VarSet
triggerall = !ishelper
trigger1 = fvar(30) < 0
fvar(30) = 0
ignorehitpause = 1

[State -1, AR burst combo start]
type = VarSet
triggerall = !ishelper
trigger1 = movetype != H
fvar(31) = Life
ignorehitpause = 1

[State -1, AR burst last life]
type = VarSet
triggerall = !ishelper
trigger1 = 1
fvar(33) = Life
ignorehitpause = 1

;Abstract Reordered: burst HUD - Touma's BURST gauge, recoloured, just under the lifebar.
