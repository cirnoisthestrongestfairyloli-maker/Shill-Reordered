;------------------------------------------------------------------------
; No Push - Dummy
[Statedef 10002]
ctrl = 0

[State 10002, ChangeAnim]
type = ChangeAnim
trigger1 = 1
value = Parent, Anim
elem = Parent, AnimElemNo(0)

[State 10002, PlayerPush]
type = PlayerPush
trigger1 = Parent, StateNo != [13201, 13210]	; Abyss 1 - Clone Hyper
trigger1 = Parent, StateNo != [21401, 21402]	; Abyss 2 - Bubble Trap
trigger1 = Parent, StateNo != 21501				; Abyss 2 - Teleport
trigger1 = Parent, StateNo != 21511				; Abyss 2 - Teleport
trigger1 = Parent, StateNo != 21521				; Abyss 2 - Teleport
trigger1 = Parent, StateNo != [21601, 21602]	; Abyss 2 - Teleport 2
trigger1 = Parent, StateNo != [21611, 21612]	; Abyss 2 - Teleport 2
trigger1 = Parent, StateNo != [21621, 21622]	; Abyss 2 - Teleport 2
value = 1

[State 10002, BindToParent]
type = BindToParent
trigger1 = !Time
time = -1
facing = 1

[State 10002, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoShadow
flag2 = Invisible

[State 10002, NotHitBy]
type = NotHitBy
trigger1 = !Time
value = SCA
time = -1

[State 10002, Remove]
type = DestroySelf
trigger1 = Parent, Var(50) = 2
trigger2 = Parent, StateNo = 5150
