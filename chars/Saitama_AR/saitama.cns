[Statedef 5999]
type = S
movetype = I
physics = N
anim = 6000
ctrl = 0
sprpriority = -9
velset = 0,Parent,Vel Y


[State 6003]
type = Varset
trigger1 = Time = 0
var(3) = parent,id

[State 6003]
type = Turn
trigger1 = parent,facing != facing

[State 6003]
type = DestroySelf
trigger1 = !PlayerIDExist(var(3))


[State 6003]
type = BindToParent
trigger1 = PlayerIDExist(var(3))

;------------------------------------------------------------------------------------------------------------
;Cape
[Statedef 6000]
type = S
movetype = I
physics =N
anim = 6000
ctrl = 0
sprpriority = -2
velset = 0,0

[State 6000, hitby]
type = nothitby
trigger1 = 1
time = -1
value = SCA
ignorehitpause = 1

;this is the cape animation on the state 0
[State 6000]
type = VarSet
trigger1 = Time = 0
var(2) = Parent,anim

[State 6000]
type = Turn
trigger1 = Parent,Facing != Facing

[State 6000]
type = DestroySelf
trigger1 = parent,anim != var(2)

[State 6000]
type = BindToParent
trigger1 = 1

