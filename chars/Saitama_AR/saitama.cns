[Data]
life = 1000
power = 5000
attack = 100
defence = 100
fall.defence_up = 30
liedown.time = 30
airjuggle = 15
sparkno = -1
guard.sparkno = -1
KO.echo = 0
volume = 290
IntPersistIndex = 0
FloatPersistIndex = 0

;-------------------------------------------------------------------------------
[Size]
xscale = 1
yscale = 1;.9
ground.back = 16
ground.front = 16
air.back = 16
air.front = 16
height = 114
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -90
mid.pos = -5, -60
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 2.20
walk.back = -2.20
run.fwd  = 7.87, 0
run.back = -5.8,-4.5
jump.neu = 0,-10.35
jump.back = -3.87
jump.fwd = 3.87
runjump.back = -5.81,-9.4
runjump.fwd = 5.04,-9.4
airjump.neu = 0,-6.5
airjump.back = -2.8
airjump.fwd = 2.8

[Movement]
airjump.num = 0
airjump.height = 38
yaccel = .53
stand.friction = .85
crouch.friction = .82

[Quotes]
; Up to 100 victory quotes can be specified per language (victory0 - victory99)
victory1 = "OK."
victory2 = "One punch again..."
victory3 = "You were really strong."
victory4 = "Well...that was lame."
victory5 = "Nice fight."
victory6 = "I hope we fight again soon."
victory7 = "I kinda had my hopes up too."
Victory8 = "That...wasn't one punch but okay"
Vicotry9 = "That weird spinach mascot can't beat me in this world"
Victory10 = "Im just a cheap character for fun"
;-------------------------------------------------------------------------------
;==============================================================================================
;=======================================<SYSTEM STATES>========================================
;==============================================================================================

;STANDING>====================
[StateDef 0]
type = S
physics = S
moveType = I
velSet = 0,0
sprPriority = 2

[State 0, 2]
type = Helper
trigger1 = NumHelper(6000) = 0
stateno = 6000
id = 6000

[State 0, Remove Explods]
type = RemoveExplod
trigger1 = IsHelper

[State 0, Destroy Helpers]
type = DestroySelf
trigger1 = IsHelper

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && !AnimTime
value = 0

[State 0, Dead]
type = ChangeState
trigger1 = !Alive
value = 5050
;======================<RUN>===========================
;RUN
[StateDef 100]
type = S
physics = N
moveType = I
anim = 100
ctrl = 0
sprPriority = 1

[State explod, Dust1]
type = Explod
trigger1 = Time = 1
anim = 6010
id = 6010
postype = p1
pos = 0,0
bindtime = 1
; persistent = 9
ownpal = 1
scale = 0.3,0.3
facing = 1
vfacing = 1
removetime = -2
sprpriority = -9
;ontop = 1

[State explod, Dust2]
type = Explod
trigger1 = Time = 1
anim = 6020
id = 6020
postype = p1
pos = -20,0
bindtime = 1
; persistent = 9
ownpal = 1
scale = 0.3,0.3
facing = 1
vfacing = 1
removetime = -2
sprpriority = -9
;ontop = 1

[State 100, VelSet]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, Step Sound]
type = PlaySnd
trigger1 = (AnimElem = 2 || AnimElem = 5)
value = 100, ifElse((AnimElem = 2), 0, 1)

[State 100, Jump]
type = ChangeState
trigger1 = !AILevel
trigger1 = command = "holdfwd" && command = "holdup"
value = 40

[State 100, Jump (AI)]
type = ChangeState
trigger1 = AILevel && Random < 25
value = 40

[State 100, End]
type = ChangeState
trigger1 = !AILevel && command != "holdfwd"
trigger2 = AILevel && P2BodyDist x <= 90
value = 101


;Stop Running
[StateDef 101]
type = S
physics = S
moveType = I
anim = 101
ctrl = 0
sprPriority = 1

[State 101, Stopping Sound]
type = PlaySnd
trigger1 = !Time
value = 101,0

; [State 101, Skid Dust]
; type = Explod
; trigger1 = !Time
; anim = 8104
; sprPriority=3
; posType = P1
; pos = 0,0
; vel = 0,0
; scale = 0.5,0.5
; pauseMovetime = -1
; superMoveTime = -1
; ownpal = 1

[State 101, Jump]
type = ChangeState
trigger1 = !AILevel && command = "holdup"
value = 40

[State 101, End]
type = ChangeState
trigger1 = !AnimTime
value = ifElse(command = "holddown", 10, 0)
ctrl = 1



