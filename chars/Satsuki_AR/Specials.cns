;Life Fiber Blast
[StateDef 1000]
type = S
physics = S
moveType = A
anim = 1000
ctrl = 0
velset = 0,0
sprPriority = 1
poweradd = 70 * !var(20)
faceP2 = 1

[State 1000, Button Detect]
type = VarSet
trigger1 = !Time && !AILevel
var(10) = ifElse((command = "a" || command = "rlsa"), 0, ifElse((command = "b" || command = "rlsb"), 1, 2))   ;AR: A = light, B = medium

[State 1000, Button Detect (AI)]
type = VarSet
trigger1 = !Time && AILevel
var(10) = ifElse((P2MoveType = H || PrevStateNo = 750 || Random < 333), 2, ifElse(Random < 500, 1, 0))

[State 1000, Voice]
type = PlaySnd
trigger1 = AnimElem = 4 || AnimElem = 8
value = 0,(Random % 13)
channel = 0

[State 1000, snd]
type = PlaySnd
trigger1 = AnimElem = 4 || AnimElem = 8
value = 1,12
channel = 1

[State 1000, snd]
type = PlaySnd
trigger1 = AnimElem = 4 || AnimElem = 8
value = 1,6
channel = 2

[State 1000, Width]
type = Width
trigger1 = AnimElemTime(4) < 0
player = 50,0

[State 1000, Projectile]
type = Helper
trigger1 = AnimElem = 4
helperType = Normal
stateNo = 2010
ID = 2010
name = "Life Fiber Blast"
posType = P1
pos = -30,0
keyctrl = 1
ownpal = 1
facing = 1
persistent = 0
ignorehitpause = 1
size.xScale = .8
size.yScale = .8

[State 1000, Projectile]
type = Helper
trigger1 = AnimElem = 8
helperType = Normal
stateNo = 2010
ID = 2010
name = "Life Fiber Blast"
posType = P1
pos = -30,0
keyctrl = 1
ownpal = 1
facing = 1
persistent = 0
ignorehitpause = 1
size.xScale = .8
size.yScale = .8

[State 1000, End]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

;Life Fiber Blast Ex
