pauseMoveTime = -1
superMoveTime = -1
ownPal = 1

[State 1030, Voice]
type = PlaySnd
trigger1 = AnimElem = 4 || AnimElem = 8
value = 0,(Random % 13)
channel = 0

[State 1030, snd]
type = PlaySnd
trigger1 = AnimElem = 4 || AnimElem = 8
value = 1,12
channel = 1

[State 1030, snd]
type = PlaySnd
trigger1 = AnimElem = 4 || AnimElem = 8
value = 1,6
channel = 2

[State 1030, Width]
type = Width
trigger1 = AnimElemTime(4) < 0
player = 50,0

[State 1030, Projectile]
type = Helper
trigger1 = AnimElem = 4
helperType = Normal
stateNo = 2030
ID = 2030
name = "Life Fiber Blast Ex"
posType = P1
pos = -30,0
keyctrl = 1
ownpal = 1
facing = 1
persistent = 0
ignorehitpause = 1
size.xScale = .8
size.yScale = .8

[State 1030, Projectile]
type = Helper
trigger1 = AnimElem = 8
helperType = Normal
stateNo = 2030
ID = 2030
name = "Life Fiber Blast Ex"
