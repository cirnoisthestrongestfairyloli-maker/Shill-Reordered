[State 3200, StateTypeSet: Idle]
type = StateTypeSet
trigger1 = AnimElemTime(4) >= 0
movetype = I

[State 3200, End]
type = ChangeState
trigger1 = !AnimTime 
value = 0
ctrl = 1

;Gut Sniper Hit
[Statedef 3150]
type = S
movetype = A
physics = S
ctrl = 0
poweradd = 0
velset = 0,0
anim = 3150
facep2 = 1
sprpriority = 2

[State 3201, Voice]
type = PlaySnd
trigger1 = AnimElem = 1
value = 580,0
channel = 0

[State 3201, Snd]
type = PlaySnd
trigger1 = AnimElem = 2
value = 1,20
channel = 2

[State 0, FX]
type = Explod
trigger1 = AnimElem = 2
anim = 3112
ID = 3112
postype = p1
pos = 0,0
bindtime = -1
sprpriority = 2
ownpal = 1
removeongethit = 1
ignorehitpause = 0
persistent = 0
ontop = 1
scale = .9,.9

[State 3201, HitDef] 
type = HitDef
trigger1 = !var(16) && var(15) < 100
trigger1 = AnimElem = 2
attr = S, SA
damage = ceil(ifElse(fvar(11) * 200 < 7, 7, fvar(11) * 200)), 10
priority = 4, hit
animtype = Hard
getpower = 0, 0
givepower = 35, 35
guardflag = MA
hitflag = MAF
hitsound = S2,6
guardsound = S130, 0
pausetime = 5,5
guard.pausetime = 5,5
sparkNo = -1 + 0 * (var(33) := 8014)
guard.sparkNo = -1 + 0 * (var(34) := 8001)
sparkXY = -10 + 0 * (var(35) := 46), var(36) := -72
air.animtype = Back
fall.animtype = Back
ground.type = High
air.type = High
ground.slidetime = 18
ground.hittime  = 18
guard.hittime = 18
ground.velocity = -10, -15
air.velocity = -10, -15
guard.velocity = -5
airguard.velocity = -5, -5
airguard.ctrlTime = 16
ground.cornerPush.velOff = 0
guard.cornerPush.velOff = 0
air.cornerPush.velOff = 0
yaccel = .5
fall = 1
fall.recover = 0
forcestand = 0
palFX.time = 12 * var(9)
palFX.add = 255,255,255
palFX.sinAdd= -255,-255,-255,48
envshake.time = 16
envshake.ampl = 6
envShake.freq = 160
id = 3150

[State 1330, TargetState];hits foe into wall
type = TargetState
trigger1 = MoveHit && NumTarget(3150)
trigger1 = (Target(3150), StateNo = 5000) || (Target(3150), StateNo = 5010) || (Target(3150), StateNo = 5020)
value = 1031
ID = 3150
ignoreHitPause = 1

[State 3201, StateTypeSet: Idle]
type = StateTypeSet
trigger1 = AnimElemTime(3) >= 0
movetype = I

[State 3201, End]
type = ChangeState
trigger1 = !AnimTime 
value = 0
ctrl = 1

