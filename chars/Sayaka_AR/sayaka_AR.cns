trigger1 = Time = 0
time = 20
ampl = 4

[State 7780, Hold the pose]
type = ChangeAnim
trigger1 = AnimElemNo(0) >= 5
trigger1 = AnimElemTime(5) >= 40
value = 1500
elem = 5

[State 7780, End]
type = ChangeState
trigger1 = Time >= 40
value = 0
ctrl = 1

