;---------------------------------------------------------------------------
; Regeneration (hold X): turns meter into life, but only up to her red (recoverable) life.
; 4 meter per point of life, 1 life per frame. She can be hit the whole time.
[Statedef 7770]
type     = S
movetype = I
physics  = S
ctrl     = 0
velset   = 0, 0
anim     = 1500
sprpriority = 2

[State 7770, Hold the pose]
type = ChangeAnim
trigger1 = AnimElemNo(0) >= 5
trigger1 = AnimElemTime(5) >= 40
value = 1500
elem = 5

[State 7770, Sound]
type = PlaySnd
trigger1 = Time = 8
value = 3, 2

[State 7770, Magic circle]
type = Explod
trigger1 = Time = 8
anim = 21510
ID = 7770
pos = -15, -60
postype = p1
bindtime = -1
removetime = -1
scale = 0.45, 0.45
sprpriority = -3
ownpal = 1
removeongethit = 1
trans = add

[State 7770, Heal]
type = LifeAdd
trigger1 = Time >= 10
trigger1 = RedLife > Life
trigger1 = Power >= 4
value = 1
absolute = 1

[State 7770, Cost]
type = PowerAdd
trigger1 = Time >= 10
trigger1 = RedLife > Life
trigger1 = Power >= 4
value = -4

[State 7770, Sparkles]
type = Explod
trigger1 = Time >= 10
trigger1 = Time % 20 = 0
anim = 25500
ID = 25500
pos = 0, -30
random = 30, 30
postype = p1
bindtime = 1
removetime = -2
ontop = 1
ownpal = 1

[State 7770, Glow]
type = PalFX
trigger1 = Time % 30 = 10
time = 30
add = 20, 60, 30
sinadd = 20, 40, 20, 30

[State 7770, Circle off]
type = RemoveExplod
trigger1 = command != "hold_x"
trigger2 = Time >= 10
trigger2 = RedLife <= Life || Power < 4
ID = 7770

[State 7770, Let go]
type = ChangeState
trigger1 = Time >= 6
trigger1 = command != "hold_x"
trigger2 = Time >= 10
trigger2 = RedLife <= Life || Power < 4
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Despair install (X with a full Despair gauge): her original dark awakening (helper 15000 sets var(40) = 2)
