;---------------------------------------------------------------------------
; Abstract Reordered: blade-clash intro, Sayaka side (states 8950-8954). GENERATED by gen_intro.py (scratchpad) - edit that, not this.
; Round 1 of a 1-on-1 Shiki vs Sayaka match. Both run the same Time script:
;   dash in -> ground clash -> three teleport clashes (mid-air, low, high) -> final clash -> skid home ->
;   hold a pose for the voice lines.  fvar(30) = start x, fvar(31) = clash midpoint x.  Sister file: Shiki_AR/shiki_intro_sayaka.cns
;---------------------------------------------------------------------------
[Statedef 8950]
type = S
movetype = I
physics = N
ctrl = 0
anim = 0
velset = 0,0

[State 8950, Intro]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 8950, Go]
type = ChangeState
trigger1 = RoundState >= 1
value = 8951

;--------------------------------------------------------------------------- dash in
[Statedef 8951]
