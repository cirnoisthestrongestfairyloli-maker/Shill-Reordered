;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 190, PlaySnd]
type = PlaySnd
trigger1 = Anim = 190
trigger1 = Time = 1
value = S190,0+Random%3
Channel = 0

[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, ChangeState]
type = ChangeState
trigger1 = Time >= 180
trigger1 = Anim = 190
value = 191
ctrl = 0

[State 190, ChangeState]
type = ChangeState
triggerall = Enemy,AuthorName = "Kohaku" && Enemy,Name = "Taiga_K"
trigger1 = Time = 0
value = 192

[State 190, ChangeState]
type = ChangeState
triggerall = Enemy,AuthorName = "Kohaku" && Enemy,Name = "Miyuki_K"
trigger1 = Time = 0
value = 193

[State 190, ChangeState]
