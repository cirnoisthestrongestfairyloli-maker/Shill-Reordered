triggerall = teamside = 1
trigger1 = NumExplod(9613) = 0
anim = 6013
ID = 9613
pos = 39, GameHeight - (8.5)
postype = left
facing = 1
scale = .5, .5
bindtime = -1
removetime = -1
supermovetime = 99999
pausemovetime = 99999
sprpriority = 10
ontop = 1
ownpal = 1
removeongethit = 0
ignorehitpause = 1

