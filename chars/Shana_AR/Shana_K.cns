triggerall = Enemy,AuthorName = "Sennou-Room" && Enemy,Name = "Kirito"
trigger1 = Time = 0
value = 196

[State 190, ChangeState]
type = ChangeState
triggerall = Enemy,AuthorName = "Kohaku" && Enemy,Name = "Kirino_K"
trigger1 = Time = 0
value = 198

