[StateDef -2]
;=== AR MECHANIC METER: Wilhelmina gauge (explods 9611/9613; anim 9611 = sprite 9610,8, the assist portrait
;frame cut from the original HUD sprite 6010,0; fill = original anim 6013 / sprite 6111,1) ===
;var(48) = assist gauge, 0-300. X calls the assist when it is ready.
[State -2, AR assist HUD frame P1]
type = Explod
triggerall = !ishelper
triggerall = teamside = 1
trigger1 = NumExplod(9611) = 0
anim = 9611
ID = 9611
pos = 8, GameHeight - (14)
postype = left
facing = 1
scale = .5, .5
bindtime = -1
removetime = -1
supermovetime = 99999
pausemovetime = 99999
sprpriority = 10
ontop = 1
ownpal = 1
removeongethit = 0
ignorehitpause = 1

[State -2, AR assist HUD fill P1]
