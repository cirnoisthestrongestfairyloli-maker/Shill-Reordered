;---------------------------------------------------------------------------
; Super FX
[StateDef 30000]
type = S
movetype = I
physics = S
velset = 0,0
ctrl = 0
anim = 9000;IfElse(IsHelper(30000), 30000, IfElse(IsHelper(30001), 30001, 30002))
poweradd = IfElse(IsHelper(30000), -1000, IfElse(IsHelper(30001), -2000, -3000))
sprpriority = IfElse(!IsHelper(30002), 5, 1)

[State 30000, Helper]
type = Helper
trigger1 = !Time && Root, Facing = 1
name = "Portrait"
ID = 30005 
stateno = 30005
pos = -150,-140
postype = left    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 1
pausemovetime = 999
size.xscale = 0.5
size.yscale = 0.5

[State 30000, Helper]
type = Helper
trigger1 = !Time && Root, Facing = -1
name = "Portrait"
ID = 30006 
stateno = 30005
pos = 150,-140
postype = right    ;p2,front,back,left,right
facing = -1
keyctrl = 0
ownpal = 1
pausemovetime = 999
size.xscale = 0.5
size.yscale = 0.5

[State 30000, VarSet]
type = VarSet
trigger1 = !Time
var(0) = 256

[State 30000, ParentVarSet]
type = ParentVarSet
trigger1 = 1
var(17) = 0

[State 30000, AssertSpecial]
type = AssertSpecial
trigger1 = Time < 32
flag = globalnoshadow
flag2 = nobardisplay
flag3 = nofg

[State 30000, PlaySnd]
type = PlaySnd
trigger1 = !Time
value = S30000,0
volumescale = 100

[State 30000, VarAdd]
type = VarAdd
trigger1 = Time < 8
var(0) = -32

[State 30000, VarAdd]
type = VarAdd
triggerall = Var(0) < 256
trigger1 = IfElse(!IsHelper(30001), Time > 32, Time > IfElse((Root, StateNo = [3011,3012]), 125, 150))
trigger2 = Root, MoveType = H
var(0) = 16

[State 30000, BGPalFX]
type = BGPalFX
trigger1 = 1
time = 1
add = 0,0,0
mul = var(0), var(0), var(0) 
sinadd = 0,0,0,10
color = 256
invertall = 0
persistent = 1

[State 30000, AssertSpecial]
type = AssertSpecial
trigger1 = Time < 32
flag = noFG
flag2 = nobardisplay

[State 30000, end]
type = DestroySelf
trigger1 = IsHelper(30000) && Time > 32 && var(0) = 256
trigger2 = IsHelper(30001) && Time > IfElse((Root, StateNo = [3011,3012]), 125, 150) && var(0) = 256
trigger3 = IsHelper(30002) && Time > 32 && var(0) = 256
;---------------------------------------------------------------------------
; Super Portrait
[StateDef 30005]
type = S
movetype = I
physics = N
velset = 2,0
ctrl = 0
anim = 30005
poweradd = 0
sprpriority = 1

[State 30005, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 30005, VarAdd]
type = VarAdd
trigger1 = Time > 24
trigger1 = var(0) < 256
var(0) = 16

[State 30005, VarSet]
type = VarSet
trigger1 = !Time
fvar(0) = 0.1

[State 30005, VarAdd]
type = VarAdd
trigger1 = Time < 8
trigger1 = fvar(0) < 1.0
trigger2 = Time > 24
trigger2 = fvar(0) < 2.0
fvar(0) = 0.1

[State 30005, Trans]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256-var(0), var(0)

[State 30005, AngleDraw]
type = AngleDraw
trigger1 = 1
scale = fvar(0), fvar(0)

[State 30005, end]
type = DestroySelf
trigger1 = Time = 48

;---------------------------------------------------------------------------
; Blackout
[StateDef 33020]
type = S
movetype = I
physics = N
velset = 0,0
ctrl = 0
anim = 9000
poweradd = 0
sprpriority = 1

[State 33020, AssertSpecial]
type = AssertSpecial
trigger1 = Root, var(56)
flag = nomusic 

[State 33020, PlaySnd]
type = PlaySnd
trigger1 = Root, var(56)
value = S30000, IfElse(Root,PalNo != 10, 1, random%2+2)
volumescale = 100
channel = 5
freqmul = 1.0
persistent = 0 

[State 33020, VarSet]
type = VarSet
trigger1 = !Time
var(0) = 256

[State 33020, VarAdd]
type = VarAdd
triggerall = Time < 32
trigger1 = var(0) > 0
var(0) = -8

[State 33020, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = nofg
flag2 = nobardisplay
flag3 = globalnoshadow

[State 33020, BGPalFX]
type = BGPalFX
trigger1 = 1
time = 1
add = 0,0,0
mul = var(0), var(0), var(0)

[State 33020, VarAdd]
type = VarAdd
triggerall = var(0) < 256
trigger1 = Time > 180
trigger2 = Root, MoveType = H
var(0) = 8

[State 33020, StopSnd]
type = StopSnd
triggerall = Time = 210
trigger1 = RoundState = 2 
channel = 5

[State 33020, end]
type = DestroySelf
trigger1 = Time > 180 && var(0) = 256
