;---------------------------------------------------------------------------
; Burst Mode 
[StateDef 10700]
type = S
movetype = I
physics = N
velset = 0,0
ctrl = 0
anim = 9000
poweradd = 0
sprpriority = 4
movehitpersist = 1

[State 10700, VarSet]
type = VarSet
trigger1 = !Time
var(1) = Power

[State 10700, PowerAdd]
type = PowerAdd
triggerall = Root,var(59) = 1
trigger1 = Root,StateNo != 700
value = -5
ignorehitpause = 1
persistent = 1

[State 10700, PowerSet]
type = PowerSet
triggerall = Root,var(59) = 1
trigger1 = Power > var(1) + (-5*Time) 
value = var(1) + (-5*Time) 
ignorehitpause = 1
persistent = 1

[State 10700, PowerSet]
type = PowerSet
trigger1 = Root, Var(59) = 1
trigger1 = Root, StateNo = [3015,3021]
trigger2 = Root,var(59) = 2
value = 0
ignorehitpause = 1
persistent = 1

[State 10700, BindToRoot]
type = BindToRoot
trigger1 = 1
time = 1
pos = 0,0

[State 10700, VarSet]
type = VarSet
triggerall = var(0) = 0
trigger1 = Root, Var(59) = 2
var(0) = 1

[State 10700, VarAdd]
type = VarAdd
triggerall = var(0) < 601
trigger1 = Root, Var(59) = 2
var(0) = 1

[State 10700, ParentVarSet]
type = ParentVarSet
triggerall = Var(0) = 600
trigger1 = Root, Var(59) = 2
var(59) = 0

[State 10700, ParentVarSet]
type = ParentVarSet
trigger1 = 1
var(58) = var(0)

[State 10700, DestroySelf]
type = DestroySelf
triggerall = Var(0) = 600
trigger1 = Root, Var(59) = 0

