poweradd = 0
sprpriority = 4
movehitpersist = 1

[State 10191, VarSet]
type = VarSet
trigger1 = !Time
var(0) = 0

[State 10191, VarAdd]
type = VarAdd
triggerall = var(0) < 256
trigger1 = Time > 10
var(0) = 16

[State 10191, Trans]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256 - var(0), var(0) 

[State 10191, DestroySelf]
type = DestroySelf
trigger1 = AnimTime = 0


;---------------------------------------------------------------------------
; God Speed Dash Helper 
[StateDef 10230]
type = S
movetype = I
physics = N
ctrl = 0
anim = 9000
sprpriority = 4
velset = 0,0

[State -2, Debug]
type = DisplayToClipboard
trigger1 = 1
text = "var(0) = %d, MoveHit = %d"
params = var(0), var(1)

[State 10230, VarSet]
type = VarSet
triggerall = Root, Var(25) > 0
trigger1 = Root, StateNo < 200
var(0) = 1

[State 10230, VarAdd]
type = VarAdd
triggerall = var(0) = 1
triggerall = P2MoveType != H
trigger1 = var(1) < 75
var(1) = 1

[State 10230, ParentVarSet]
type = ParentVarSet
trigger1 = var(1) = 75
var(25) = 0

[State 10230, Explod]
