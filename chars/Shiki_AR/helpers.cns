ID = 10230
pos = 10, GameHeight - (30)
postype = left 
facing = 1
vfacing = 1
bindtime = -1
random = 0,0
removetime = -2
pausemovetime = 999
scale = 0.25,0.25
sprpriority = 3
ontop = 1
shadow = 0,0,0
ownpal = 1
ignorehitpause = 1

