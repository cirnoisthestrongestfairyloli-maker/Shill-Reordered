;---------------------------------------------------------------------------
; Abstract Reordered: blade-clash intro, Shiki side (states 196-199, 189). GENERATED by gen_intro.py (scratchpad) - edit that, not this.
; Round 1 of a 1-on-1 Shiki vs Sayaka match. Both run the same Time script:
;   dash in -> ground clash -> three teleport clashes (mid-air, low, high) -> final clash -> skid home ->
;   hold a pose for the voice lines.  fvar(30) = start x, fvar(31) = clash midpoint x.  Sister file: Sayaka_AR/sayaka_intro_shiki.cns
;---------------------------------------------------------------------------
[Statedef 196]
type = S
movetype = I
physics = N
ctrl = 0
anim = 0
velset = 0,0

[State 196, Intro]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 196, Go]
type = ChangeState
trigger1 = RoundState >= 1
value = 197

;--------------------------------------------------------------------------- dash in
[Statedef 197]
type = S
movetype = I
physics = N
ctrl = 0
velset = 0,0

[State 197, Intro]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 197, Start x]
type = VarSet
trigger1 = Time = 0
fvar(30) = Pos X

[State 197, Run anim]
type = ChangeAnim
trigger1 = Time = 20
value = 100

[State 197, Run]
type = VelSet
trigger1 = Time >= 20
x = 6

[State 197, Clash]
type = ChangeState
trigger1 = Time >= 20 && P2Dist X <= 105
trigger2 = Time >= 90
value = 198

