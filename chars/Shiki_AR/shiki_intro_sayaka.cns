[Statedef 189]
type = S
movetype = I
physics = N
ctrl = 0

[State 189, Intro]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 189, Home]
type = VelSet
trigger1 = Time < 45
x = (fvar(30) - Pos X) * Facing * 0.15
y = 0

[State 189, Stop]
type = VelSet
trigger1 = Time >= 45
x = 0

[State 189, Pose]
