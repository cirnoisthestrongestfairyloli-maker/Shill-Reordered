sprpriority = 2			
facep2 = 1

[State 221, VarSet]
type = VarSet
trigger1 = !Time
var(2) = 0

[State 221, VarSet]
type = VarAdd
triggerall = var(2) < 30 && AnimElemTime(3) >= 0
trigger1 = AILevel = 0 && command = "hold_z"
trigger2 = AILevel != 0 && EnemyNear, StateNo = [150,155]
var(2) = 1

[State 221, end]
type = ChangeState
triggerall = Time >= 10
trigger1 = AILevel = 0  && var(2) < 30 && command != "hold_z"
trigger2 = var(2) = 30
trigger3 = AILevel != 0 && (var(2) = [0,28]) && (EnemyNear, StateNo != [150,155])
value = 222
ctrl = 0

