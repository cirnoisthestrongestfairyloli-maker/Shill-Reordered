;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, Debug]
type = DisplayToClipboard
trigger1 = 1
text = "var(15) = %d, var(17) = %d"
params = var(15), var(17)

[State -2, P2 Facing]
type = targetfacing
trigger1 = movecontact = 1 && numtarget = 1
trigger1 = !(target,hitshakeover) && !(target,hitfall) && (target,time <= 1)
value = ifelse(p2dist x>= 0, -1, 1)
ignorehitpause = 1

[State -2, Throws Disallowed]; Resets condition every tick to check again
type = VarSet
trigger1 = 1
var(0) = 0

[State -2, Throws Disallowed]
type = VarSet
triggerall = NumEnemy
triggerall = RoundState = 2
trigger1 = (enemynear,stateno = [150,155])
trigger2 = EnemyNear,MoveType = H 
trigger3 = (enemynear,stateno = [5020,5040]) && !(enemynear,hitfall)
trigger4 = ((enemynear,stateno = 0) || (enemynear,stateno = 52)) && (enemynear,prevstateno = [5000,5040]) && ((enemynear,time <= 0) || !(enemynear,ctrl))
trigger5 = (enemynear,stateno = 0) && (enemynear,prevstateno = 52) && ((enemynear,time <= 0) || !(enemynear,ctrl))
trigger6 = (enemynear,stateno = 40) && (enemynear,time>= 1 || enemynear,prevstateno = 0 || enemynear,prevstateno = 52)
trigger7 = MoveType = H
trigger8 = StateType = L
trigger9 = EnemyNear,StateType = L
trigger10 = P2BodyDist X > 40
var(0) = 1

[State -2, Throws Disallowed]; Resets condition every tick to check again
type = VarSet
trigger1 = 1
var(1) = 0

[State -2, Throws Disallowed]
type = VarSet
triggerall = NumEnemy
triggerall = RoundState = 2
trigger1 = (enemynear,stateno = [150,155])
trigger2 = EnemyNear, StateType != A 
trigger3 = (enemynear,stateno = [5020,5040]) && !(enemynear,hitfall)
trigger4 = ((enemynear,stateno = 0) || (enemynear,stateno = 52)) && (enemynear,prevstateno = [5000,5040]) && ((enemynear,time <= 0) || !(enemynear,ctrl))
trigger5 = (enemynear,stateno = 0) && (enemynear,prevstateno = 52) && ((enemynear,time <= 0) || !(enemynear,ctrl))
trigger6 = (enemynear,stateno = 40) && (enemynear,time>= 1 || enemynear,prevstateno = 0 || enemynear,prevstateno = 52)
trigger7 = MoveType = H
trigger8 = StateType = L
trigger9 = EnemyNear,StateType = L
trigger10 = P2BodyDist X > 40
var(1) = 1

[State -2, Prevent Underground Juggles]
type = targetbind
trigger1 = movehit = 1
trigger1 = numtarget = 1 && numenemy
trigger1 = (target,time <= 1) && (target,ID = enemynear,ID); this is just to prevent Simul issues as usual
trigger1 = !(target,hitshakeover) && (target, hitfall) && (target, pos y>0)
pos = ceil(p2dist x), ceil(-pos y); keeps P2 at the same horizontal distance, but resets his Y position
ignorehitpause = 1


;================================================================================
; ------- KOF Cornerpush System by Vans --------
;===============================================================================
[State -2, Superpause Check]
type = VarAdd
trigger1 = var(10)
var(10) = -1

[State -2, Reset Time counter]
type = VarSet
trigger1 = movecontact = 1
var(11) = 0

[State -2, Accel]
type = VarSet
triggerall = roundstate = 2
triggerall = var(10) <=  0
triggerall = numtarget >= 1
trigger1 = target, hitshakeover
fvar(10) = (target, gethitvar(xvel)*exp((-0.25)*((var(11)))));exp((-0.1886)*((var(11)))))

[State -2, Push]
type = PosAdd
triggerall = roundstate = 2
triggerall = !var(10)
triggerall = numtarget >= 1
triggerall = (target, BackEdgeBodyDist <=  0) || (target, FrontEdgeBodyDist <=  0)
triggerall = target,statetype != L
triggerall = target,statetype != A
trigger1 = Statetype != A
x = ifelse(facing = -1,fvar(10),-fvar(10))

[State -2, Increase]
type = VarSet
triggerall = numtarget >= 1
triggerall = target, hitshakeover
trigger1 = var(10) <=  0
trigger1 = var(11)
var(11) = var(11)+1

[State -2, Time counter]
type = VarSet
trigger1 = !var(11)
trigger1 = fvar(10)
var(11) = 1

[State -2, Freeze Pos During Superpause]
type = PosFreeze
trigger1 = var(10)
value = 1

[State -2, Drop]
type = VarSet
triggerall = fvar(10)
trigger1 = !numtarget
trigger2 = projcontact = 1
trigger3 = movecontact = 1
fvar(10) = 0
ignorehitpause = 1

;================================================================================
; ------- COUNTER HIT by Vans (Based on Sander's Method) --------
;===============================================================================
[State -2, VarSet];Checks if opponent is in attack state
type = VarSet
triggerall = numenemy
trigger1 = enemy, movetype = a
var(21) = 1
ignorehitpause = 1

[State -2, VarSet];This resets the condition if counter not succesful and succesful
type = VarSet
triggerall = numenemy
trigger1 = enemy, movetype = i || var(22) >= 1 ;Enemy is Idle | Counter was Succesful
trigger2 = var(22) > 10 && enemy, movetype = h ;10 ticks passed & enemy is on gethit state
trigger3 = MoveType = I
var(21) = 0
ignorehitpause = 1

[State -2, VarSet];Counter Hit Succesful
type = VarSet
trigger1 = var(21) = 1 && var(16) = 1 ;Counter Check Ok, Move Hit Succesfully.
trigger1 = StateNo != [190,199] ;Does not activate during intros.
trigger1 = StateNo != [800,899]
var(22) = 1
ignorehitpause = 1

[State -2, VarAdd];Counter Hit Timer
type = VarAdd
trigger1 = var(22) >= 1 ;Counter was succesful
var(22) = 1
ignorehitpause = 1

[State -2, VarSet];Counter Hit Reset
type = VarSet
trigger1 = StateNo < 3000 && var(22) >= 30 && var(16) = 1;Reset if 22 ticks passed and move hit
trigger2 = (StateNo = [3000,3999]) && var(22) >= 60 && var(16) = 1;Reset if 22 ticks passed and move hit
trigger3 = p2movetype != h ;Reset if P2 is no longer in gethit state
trigger4 = movetype = h ;Reset if P1 is getting hit
var(22) = 0
ignorehitpause = 1

;[State -2, EnvColor];This will produce a flash a la KOF2K2
;type = EnvColor
;triggerall = MoveType != H
;triggerall = numenemy
;triggerall = var(21)
;triggerall = StateNo != [190,199] ;Does not activate during intros.
;triggerall = StateNo != [800,899] ;Does not activate during throws.
;trigger1 = var(21) = 1 && Var(16) = 1 ;Move hit, Ok
;value = 255,255,255
;time = 1
;under = 1
;ignorehitpause = 1
;persistent = 0

[State -2, Air Jump Install Var Reset]
type = VarSet
trigger1 = Anim = 47
trigger2 = MoveType = H
var(6) = 0

[State -2, Air Dash Install Var Reset]
type = VarSet
trigger1 = Anim = 47
trigger2 = MoveType = H
var(7) = 0

;== Hitstun/Untech Scaling

[State -2, Hitstun Scaling - Air]
type = VarAdd
triggerall = NumEnemy
triggerall = MoveHit = 1
triggerall = Var(30) < 15
trigger1 = P2StateType = A && (enemy,gethitvar(hitcount)%6)
var(30) = 1
persistent = 0

[State -2, Hitstun Scaling - Ground]
type = VarAdd
triggerall = NumEnemy
triggerall = MoveHit = 1
triggerall = Var(30) < 15
trigger1 = P2StateType != A  && (enemy,gethitvar(hitcount)%6)
var(31) = 1
persistent = 0

[State -2, VarSet]
type = VarSet
trigger1 = P2StateType != A && var(31) != 0
var(32) = 1

[State -2, VarSet]
type = VarSet
trigger1 = Var(32) = 1 && GameTime % 1 = 0
var(32) = 2

[State -2, Apply Half of Ground Hitstun Scaling to Air Hitstun Scaling]
type = VarSet
trigger1 = P2StateType = A && Var(32) = 1
var(30) = var(30) - floor((var(31)/2))

[State -2, Hitstun Scaling Var Reset]
type = VarSet
triggerall = NumEnemy
trigger1 = P2MoveType != H
var(30) = 0
ignorehitpause = 1
;==

[State -2, Untech Proration (Normal Moves)]
type = VarAdd
triggerall = Var(18) = [1,4]
triggerall = MoveHit = 1
triggerall = NumEnemy
triggerall = Enemy, HitFall = 1
trigger1 = Enemy, GetHitVar(HitCount) > 1
var(35) = 2
persistent = 0

[State -2, Untech Proration Reset]
type = VarSet
triggerall = Var(35)
triggerall = NumEnemy
trigger1 = Enemy, MoveType != H
var(35) = 0
ignorehitpause = 1

[State -3, var(15) = 0 (Enemy Recovers)]
type = VarSet
trigger1 = NumEnemy
trigger1 = EnemyNear, MoveType != H
trigger2 = NumEnemy
trigger2 = (EnemyNear, StateNo != [5110,5210])
trigger3 = NumEnemy
trigger3 = (EnemyNear, PrevStateNo != [5110,5210])
trigger4 = MoveType = H
trigger5 = StateType = L
trigger6 = EnemyNear, MoveType = A
trigger7 = EnemyNear, StateType = L
var(15) = 0
ignorehitpause = 1
persistent = 0

[State -3, var(15) = 1 (Full Reset)]
type = VarSet
trigger1 = HitDefAttr = SCA, AT
;==
trigger2 = NumEnemy
trigger2 = (EnemyNear, StateNo = [5110,5120]) || (EnemyNear, StateNo = [5200,5210])
;==
trigger3 = NumEnemy
trigger3 = (EnemyNear, PrevStateNo = [5110,5120]) || (EnemyNear, PrevStateNo = [5200,5210])
trigger3 = StateNo != 0
;==
trigger4 = RoundState != 2
;==
trigger5 = NumEnemy
trigger5 = EnemyNear, StateNo = [15000,59999]
;==
trigger6 = NumEnemy
trigger6 = EnemyNear, HitFall = 1 && EnemyNear, Vel Y > 0 && EnemyNear, Pos Y >= -5
;==
trigger7 = PrevStateNo = [800,899]
;==
trigger8 = P2StateType = L
var(15) = 1
ignorehitpause = 1

[State -2, Custom State]
type = TargetState
triggerall = StateNo != [3020,3025]
triggerall = MoveType = A && NumTarget(StateNo)
trigger1 = P2StateType = A && movehit = 1 && (P2StateNo!=[55020,55035])
value = 55020
ID = StateNo
ignorehitpause = 1 

[State -2, Custom State 2]
type = TargetState
triggerall = MoveType = A && NumTarget(55050)
triggerall = Target, HitShakeOver = 1
trigger1 = P2StateType = A && movehit = 1 && (P2StateNo!=[55020,55035])
value = 55050
id = 55050
ignorehitpause = 1 

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, PowerSet]
type = PowerSet
trigger1 = 0   ;Abstract Reordered: palette 12 infinite meter off
value = 3000
ignorehitpause = 1
persistent = 1

[State -3, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noairguard

[State -3, AssertSpecial]
type = AssertSpecial
triggerall = RoundState > 2
trigger1 = var(56)
flag = nomusic 

[State -3, ScreenBound]
type = ScreenBound
triggerall = RoundState > 2
trigger1 = var(56)
value = 1
movecamera = 0,0

[State -3, Var(16) Reset]
type = VarSet
triggerall = var(56)
trigger1 = PrevStateNo = 3021 && RoundState < 3
var(56) = 0
ignorehitpause = 1

[State -3, Superjump VarSet]
type = VarSet
triggerall = StateNo != 45
triggerall = PrevStateNo != 45
triggerall = StateType != A
trigger1 = command = "highjump"
var(5) = 1
ignorehitpause = 1
persistent = 1

[State -3, Dust]
type = Helper
triggerall = NumHelper(10040) = 0
trigger1 = StateNo = 50 && Time = 1 && PrevStateNo != 45
trigger2 = StateNo = 52 && Time = 1
trigger3 = (StateNo = [100,106]) && Time = 1
trigger4 = Anim = [1005,1007]
trigger4 = Time = 1
trigger5 = Anim = 3002 && Time = 1
name = "Dust"
ID = 10040
stateno = 10040
pos = 0,0
