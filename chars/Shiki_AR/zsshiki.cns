;== Burst Mode Effects

[State -3, Burst Mode FX]
type = PalFX
triggerall = Var(59) = 1
trigger1 = GameTime % 20 = 0
time = 20
add = 0,0,0
mul = 256,256,256
sinadd = 43,43,43,20
invertall = 0
color = 256
persistent = 1
ignorehitpause = 1

[State -3, AfterImage]
type = AfterImage
triggerall = Var(59) = 1
trigger1 = GameTime % 20 = 0
time = 20
length = 20
palcolor = 256
palinvertall = 0
palbright = 30,30,30
palcontrast = 120,120,220
palpostbright = 0,0,0
paladd = 10,10,25
palmul = .65,.65,.75
timegap = 1
framegap = 4
trans = none

[State -3, Burst Cooldown FX]
type = PalFX
trigger1 = Var(59) = 2
time = 20
add = 0,0,0
mul = 256, var(57), var(57)
sinadd = 0,0,0,0
invertall = 0
color = 256
persistent = 1
ignorehitpause = 1

[State -3, Cooldown Control Var Reset]
type = VarSet
trigger1 = Var(59) = 0 ; Set to 0 when Burst Mode is off
var(57) = 0
persistent = 1

[State -3, Cooldown Control Var Set]
type = VarSet
trigger1 = Var(59) = 1 ; Set to 112 when Burst Mode is on
var(57) = 160

[State -3, Cooldown Control Var Add]
type = VarAdd
triggerall = Var(59) = 2
triggerall = NumHelper(10700) = 1
triggerall = var(58) % 100 = 0
trigger1 = var(57) < 256
var(57) = 16 ; Slowly decrease the amount of red in the PalFX as the mode timer decreases

[State -3, Burst Mode End]
type = VarSet
triggerall = var(59) = 1
trigger1 = 0   ;Abstract Reordered: the timer ends it (State -1), no Break afterwards
trigger2 = StateNo = 3011 || StateNo = 3016
trigger2 = AnimTime = 0
trigger3 = StateNo = 3021
trigger3 = AnimTime = 0
var(59) = 0