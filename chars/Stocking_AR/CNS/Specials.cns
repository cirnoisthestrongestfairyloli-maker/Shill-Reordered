; Cutting Air
[Statedef 1000]
type    = S
movetype= A
physics = S
juggle  = 4
poweradd= 100+10*(var(10)=2)
velset = 0,0
anim = 1000+3*(var(10)=2)
ctrl = 0
sprpriority = 2
facep2 = 1

[State 1000, Helper]
type = Helper
trigger1 = AnimElemTime(4) = 1
pos = 60,0
postype = p1
ID = 1001
stateno = 1001
name = "Beam"
keyctrl = 0
ownpal = 1
ignorehitpause=1

[State 1000, Sugar Rush extra wind]
