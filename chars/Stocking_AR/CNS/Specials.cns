trigger1 = AnimElemTime(4) = 9
trigger1 = var(44) > 0
pos = 60,0
postype = p1
ID = 1001
stateno = 1001
name = "Beam"
keyctrl = 0
ownpal = 1
ignorehitpause=1

[State 210, 2]
type = null;HitDef
trigger1 = time = 0
attr = S, NA
animtype  = Medium
damage    = 27+10*(var(10)=2)
guardflag = MA
hitflag = MAF
priority = 5, Hit
pausetime = 5,5+2*(root,var(10)=2)
sparkno = 1+1*(root,var(10)=2)
sparkxy = -10,-48
hitsound   = s5,1+1*(root,var(10)=2)
guardsound = 6, 0
ground.type = High
getpower = 15+5*(root,var(10)=2),15+5*(root,var(10)=2)
givepower = 16,16
ground.slidetime = 15+2*((root,var(10)>=2))
ground.hittime  = 15+2*((root,var(10)>=2))
guard.hittime = 12+2*((root,var(10)>=2))
ground.velocity = -3.2+-1*((root,var(10)>=2))
air.velocity = -3.2+-1*((root,var(10)>=2)),-2
