;---------------------------------------------------------------------------
; Abstract Reordered additions for Stocking: Sugar meter (X), parry (Z), burst (A+B+C)
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; Eat a candy (X): the candy is spent right away; the Sugar Rush only starts if she finishes the bite
[Statedef 7760]
type     = S
movetype = I
physics  = S
ctrl     = 0
velset   = 0, 0
anim     = 7760
sprpriority = 2

[State 7760, Candy out of the bag]
type = VarAdd
trigger1 = Time = 0
var(43) = -100

[State 7760, Munch]
type = PlaySnd
trigger1 = AnimElemTime(4) = 0
value = S3020, 1
channel = 0

[State 7760, Sugar Rush (6 seconds, eating again adds more)]
type = VarSet
trigger1 = AnimElemTime(8) = 0
var(44) = ifelse(var(44) + 360 > 720, 720, var(44) + 360)

[State 7760, No crash while rushing]
type = VarSet
trigger1 = AnimElemTime(8) = 0
var(45) = 0

[State 7760, Sugar!]
type = PalFX
trigger1 = AnimElemTime(8) = 0
time = 12
add = 120, 40, 90

[State 7760, Done]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Blocked super: stuck in her last pose for 24 frames (clearly minus)
[Statedef 7780]
type     = S
movetype = I
physics  = S
ctrl     = 0
velset   = 0, 0

[State 7780, Hold pose]
type = ChangeAnim
trigger1 = AnimTime = 0
value = Anim
elem = AnimElemNo(0)

[State 7780, Recover]
type = ChangeState
trigger1 = Time >= 24
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Sugar crash: dazed for 50 frames when the rush runs out (can be hit, can't act)
[Statedef 7790]
type     = S
movetype = I
physics  = S
ctrl     = 0
velset   = 0, 0
anim     = 5300

[State 7790, Handled]
type = VarSet
trigger1 = Time = 0
var(19) = 0

[State 7790, Dazed look]
type = PalFX
trigger1 = Time % 20 = 0
time = 10
add = 40, 40, 0
sinadd = 40, 40, 0, 10

[State 7790, Recover]
type = ChangeState
trigger1 = Time >= 50
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Sweet Healing from the sugar meter (2+X with 3 candies): +100 life, no meter cost
[Statedef 7770]
type = S
movetype = I
physics = S
velset = 0,0
ctrl = 0
anim = 3070
sprpriority = 2
facep2 = 1

[State 7770, Eats the whole bag]
type = VarSet
trigger1 = Time = 0
var(43) = 0

[State 7770, Super A]
type = SuperPause
trigger1 = AnimElemTime(7) = 0
anim = 102
time = 38
sound = F20,0
poweradd = 0
movetime = 38
unhittable = 1
pos = 2,-70

[State 7770, LifeAdd]
type = LifeAdd
trigger1 = AnimElemTime(17) = 0
value = 100

[State 7770, Life Up!!]
type = Explod
trigger1 = AnimElemTime(17) = 0
anim = 3071
postype = p1
pos = 0,-120
removetime = -2
sprpriority = 3
facing = facing
ownpal = 1
bindtime = -1

[State 7770, PlaySnd]
type = PlaySnd
trigger1 = AnimElemTime(8) = 0
value = S3020,0
channel = 0

[State 7770, PlaySnd]
type = PlaySnd
trigger1 = AnimElemTime(10) = 0
value = S3020,1
channel = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElemTime(17) = 0
value = S3020,2

[State 0, ChangeState]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

[Statedef 7740]
type     = U
movetype = I
physics  = N
ctrl     = 0
anim     = ifelse(StateType = C, 131, ifelse(StateType = A, 132, 130))
sprpriority = 2

[State 7740, Air physics]
type = StateTypeSet
trigger1 = StateType = A
physics = A
ignorehitpause = 1
persistent = 1

[State 7740, Catch]
type = ReversalDef
trigger1 = Time = 0
reversal.attr = SCA, NA, SA, HA, NP, SP, HP, AA, AP
pausetime = 0, 13
numhits = 0
sparkno = -1
sparkxy = 0, 0
hitsound = -1, -1
p1stateno = 7741

[State 7740, Catch window]
type = HitOverride
trigger1 = Time = [3, 12]
time = 1
attr = SCA, NA, SA, HA, NP, SP, HP, AA, AP
stateno = 7741
ignorehitpause = 1

[State 7740, Flash]
type = PalFX
trigger1 = Time = 3
time = 9
add = 190, 60, 130
sinadd = 64, 32, 5, 31

[State 7740, Hold pose]
type = ChangeAnim
trigger1 = AnimTime = 0
value = Anim
elem = AnimElemNo(0)

[State 7740, Stay put]
type = VelSet
trigger1 = StateType != A
x = 0
y = 0

[State 7740, Ground whiff]
;window passed without catching anything
type = ChangeState
trigger1 = StateType != A
trigger1 = Time >= 13
value = 7748

[State 7740, Air whiff]
type = ChangeState
trigger1 = StateType = A
trigger1 = Time >= 20
value = 7749

