movetype = I
physics  = A
ctrl     = 0

[State 7749, Cost]
type = PowerAdd
trigger1 = Time = 0
value = -80

[State 7749, Failed]
type = PalFX
trigger1 = Time = 0
time = 18
add = -40, -40, -40
mul = 200, 200, 200

[State 7749, Hold pose]
type = ChangeAnim
trigger1 = AnimTime = 0
value = Anim
elem = AnimElemNo(0)

; Ground bounce for 623B (from Ichigo): the opponent runs these with their own hit anims
[Statedef 7715]
type     = A
movetype = H
physics  = N
ctrl     = 0
velset   = 0, 0

[State 7715, Anim]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(SelfAnimExist(5060), 5060, 5050)

[State 7715, Spike]
type = VelSet
trigger1 = Time = 0
x = -2
y = 10

[State 7715, Hit the floor]
type = ChangeState
trigger1 = Pos Y >= 0
trigger1 = Vel Y > 0
value = 7716

[State 7715, Safety]
type = SelfState
trigger1 = Time >= 60
value = 5050

[Statedef 7716]
type     = A
movetype = H
physics  = N
ctrl     = 0

[State 7716, Floor]
type = PosSet
trigger1 = Time = 0
y = 0

[State 7716, Bounce]
type = VelSet
trigger1 = Time = 0
x = -1.5
y = -9

[State 7716, Anim]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(SelfAnimExist(5160), 5160, 5050)

[State 7716, Shake]
type = EnvShake
trigger1 = Time = 0
time = 12
ampl = 5

[State 7716, Thud]
type = PlaySnd
trigger1 = Time = 0
value = F7, 0

[State 7716, Back to their own fall]
;their own fall state keeps the bounce velocity; they can be hit again (juggled) on the way up and down
type = SelfState
trigger1 = Time >= 1
value = 5050

;---------------------------------------------------------------------------
; Burst (from Kamijo): A+B+C while being hit. Invincible, blows the opponent away, no damage.
; Recharges in 75 seconds (var(40), counted down in State -1), fresh every round.

