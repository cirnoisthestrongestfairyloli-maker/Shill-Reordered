anim = 4040
postype = p1
pos = 0, 0
removetime = -2
sprpriority = 0
bindtime = -1

[State 0, PosAdd]
type = PosAdd
trigger1 = time = 0
x = 75

[State 0, PlaySnd]
type = PlaySnd
trigger1 = anim = 196 && AnimElemTime(4) = 0 
value = S199,0

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = time = 164 
value = 41

[State 0, VelSet]
type = VelSet
trigger1 = time = 164
y = -10

[State 0, PosAdd]
type = PosAdd
trigger1 = time = 164
x = -21

[State 0, Gravity]
type = VelSet
trigger1 = time = 190
y = 10

[State 0, PosAdd]
