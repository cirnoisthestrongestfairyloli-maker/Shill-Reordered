; Stocking's constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

; これはKFMの定数と状態のファイルです。
; このファイルの中には注釈が散らされているので、CNSを習いたいお方は
; 読んでみたらいいです。

[Data]
;Amount of life to start with
;体力ゲージの初期値
;Abstract Reordered: glass cannon (less life, takes more), 5 bars of meter
life = 850
power = 5000
;attack power (more is stronger)
;攻撃ダメージ
attack = 85   ;Abstract Reordered: was 100
;defensive power (more is stronger)
;体力パワー
defence = 85   ;Abstract Reordered: was 100
;Percentage to increase defense everytime player is knocked down
fall.defence_up = 50
;Time which player lies down for, before getting up
liedown.time = 9
;Number of points for juggling
airjuggle = 1
;Default hit spark number for HitDefs
sparkno = 2
;Default guard spark number
guard.sparkno = 40
;1 to enable echo on KO
KO.echo = 0
;Volume offset (negative for softer)
;volume = 255
;Variables with this index and above will not have their values
;reset to 0 between rounds or matches. There are 60 int variables,
;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
;If omitted, then it defaults to 60 and 40 for integer and float
;variables repectively, meaning that none are persistent, i.e. all
;are reset. If you want your variables to persist between matches,
;you need to override state 5900 from common1.cns.
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 13     ;Player width (back, ground)
ground.front = 16    ;Player width (front, ground)
air.back = 15        ;Player width (back, air)
air.front = 15       ;Player width (front, air)
height = 95          ;Height of player (for opponent to jump over)
attack.dist = 87    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = 1, -85   ;Approximate position of head
mid.pos = 7, -53    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 3.6      ;Walk forward
walk.back = -2.4     ;Walk backward
run.fwd  = 7, 0    ;Run forward (x, y)
run.back = -5.9,-4 ;Hop backward (x, y)
jump.neu = 0,-11;-8.4    ;Neutral jumping velocity (x, y)
jump.back = -3.5    ;Jump back Speed (x, y)
jump.fwd = 3.5       ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 5,-12.1      ;.
airjump.neu = 0,-9.1      ;.
airjump.back = -2.57      ;Air jump speeds (opt)
airjump.fwd = 2.7         ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .60         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;--------------------- Variable List ----------------------

; var(0) - Turn var for normal throws, holding back while pressing forward to perform the throw backwards.
; var(10) - Used for stronger variants of certain specials so there's no separate states for them.
; var(20) - Language setting for dialogue intro against Panty and Twilight Sparkle (English and Spanish)

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, PlaySnd]
type = PlaySnd
trigger1 = AnimElemTime(2) = 0
value = S170,0

[State 170, PlaySnd]
type = PlaySnd
trigger1 = AnimElemTime(5) = 0
value = S5000,(random%8)

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 180]
type = S

[State 190, 1]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 0,5

[State 180, 1]
type = ChangeState
trigger1 = Var(1) = [0,1]
value = 181

[State 180, 2]
type = ChangeState
trigger1 = Var(1) = [2,3]
value = 182

[State 180, 2]
type = ChangeState
trigger1 = Var(1) = [4,5]
value = 183

;---------------------------------------------------------------------------
; Win pose 1 - Pose for the commercial
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = time = [0,150]
flag = roundnotover

[State 181, PlaySnd]
type = PlaySnd
trigger1 = time = 0 
value = S181,random%3

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

