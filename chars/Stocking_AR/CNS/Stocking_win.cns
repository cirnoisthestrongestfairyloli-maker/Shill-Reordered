value = S3040,2

[State 10000, Explod]
type = Explod
trigger1 = time = 0
anim = 4044
id = 4044
pos = GameWidth/2 + (0), GameHeight/2 + (-1)
postype = left
facing = facing
vfacing = 1
removetime = -2
scale = 6,6.06
sprpriority = 50
ontop = 1
ownpal = 1
supermovetime = -1

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

