;=== AR MECHANIC METER: Ryuji gauge (restyle here: explods 9611/9613; anim 9611 = sprite 9610,8, the Ryuji
;portrait frame cut from her original HUD; fill = her original anim 6013 / sprite 6111,1) ===
;var(48) = Ryuji gauge, 0-360 (fills 1 per tick while he is not out; X calls him when it is 360).
;When it fills, her original "ready" speech bubble + voice play (helper 6004).
[State -2, AR ryuji HUD frame P1]
type = Explod
triggerall = !ishelper
triggerall = teamside = 1
trigger1 = NumExplod(9611) = 0
anim = 9611
ID = 9611
pos = 8, GameHeight - (14)
postype = left
facing = 1
scale = .5, .5
bindtime = -1
removetime = -1
supermovetime = 99999
pausemovetime = 99999
sprpriority = 10
ontop = 1
ownpal = 1
removeongethit = 0
ignorehitpause = 1

[State -2, AR ryuji HUD fill P1]
type = Explod
triggerall = !ishelper
triggerall = teamside = 1
trigger1 = NumExplod(9613) = 0
anim = 6013
ID = 9613
pos = 39, GameHeight - (8.5)
postype = left
facing = 1
scale = .5, .5
bindtime = -1
removetime = -1
supermovetime = 99999
pausemovetime = 99999
sprpriority = 10
ontop = 1
ownpal = 1
removeongethit = 0
ignorehitpause = 1

[State -2, AR ryuji HUD frame P2]
type = Explod
triggerall = !ishelper
triggerall = teamside = 2
trigger1 = NumExplod(9611) = 0
anim = 9611
ID = 9611
pos = -8, GameHeight - (14)
postype = right
facing = -1
scale = .5, .5
bindtime = -1
removetime = -1
supermovetime = 99999
pausemovetime = 99999
sprpriority = 10
ontop = 1
ownpal = 1
removeongethit = 0
ignorehitpause = 1

[State -2, AR ryuji HUD fill P2]
type = Explod
triggerall = !ishelper
triggerall = teamside = 2
trigger1 = NumExplod(9613) = 0
anim = 6013
ID = 9613
pos = -39, GameHeight - (8.5)
postype = right
facing = -1
scale = .5, .5
bindtime = -1
removetime = -1
supermovetime = 99999
pausemovetime = 99999
sprpriority = 10
ontop = 1
ownpal = 1
removeongethit = 0
ignorehitpause = 1

[State -2, AR ryuji HUD fill]
type = ModifyExplod
trigger1 = !ishelper
trigger1 = NumExplod(9613)
ID = 9613
scale = .5 * (var(48) + 0.0001) / 360.0, .5
ignorehitpause = 1
;=== END AR MECHANIC METER ===

[State -2, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "Striker = %d"
params = var(48)

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, VarSet]
type = VarSet
trigger1 = 1
var(20) = 0

[State -3, VarSet]
type = VarSet
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,299]) || (stateno = [400,499])
trigger2 = movecontact
trigger3 = Statetype = A
trigger3 = (Stateno = [600,699])
trigger3 = MoveContact
var(20) = 1

[State -3, VarSet]
type = VarSet
trigger1 = 1
var(21) = 0

[State -3, VarSet]
type = VarSet
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [1000,1999])
trigger2 = MoveContact
var(21) = 1

[State -3, VarSet]
type = VarSet
trigger1 = 1
var(22) = 0

[State -3, VarSet]
type = VarSet
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [2000,3999])
trigger2 = stateno != [4000,4999]
trigger2 = MoveContact
var(22) = 1

[State -3, VarSet]
type = VarSet
trigger1 = 1
var(23) = 0

[State -3, VarSet]
type = VarSet
triggerall = Var(46) = 1
triggerall = Var(47) >= 1
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = StateNo = [2100,2102]
trigger2 = MoveContact
var(23) = 1

[State -3, VarSet]
type = VarSet
trigger1 = 1
var(24) = 0

[State -3, VarSet]
type = VarSet
triggerall = Var(46) = 1
triggerall = Var(47) >= 2
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = StateNo = [2100,2102]
trigger2 = MoveContact
var(24) = 1

[State -3, ChangeState]
type = ChangeState
trigger1 = !alive && (stateno = [5000,5010])
trigger1 = (prevstateno = [120,121]) || (prevstateno = [130,131]) || (prevstateno = [140,141]) || (prevstateno = [150,153])
value = 5950
ignorehitpause = 1

[State -3, AssertSpecial]
type = AssertSpecial
trigger1 = (stateno = [5000,5010])
trigger1 = (prevstateno = [120,121]) || (prevstateno = [130,131]) || (prevstateno = [140,141]) || (prevstateno = [150,153])
flag = nokosnd
ignorehitpause = 1

[State -3, Width]
type = Width
trigger1 = 1
edge = 4,0
ignorehitpause = 1

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0
