ID = 193
pos = 0,0
postype = p1
scale = 0.335,0.335
sprpriority = -1
bindtime = -1
ownpal = 1
removeongethit = 1
ignorehitpause = 1

[State 191, ChangeState]
type = ChangeState
trigger1 = Animtime = 0
value = 0

[StateDef 192]
type = S
ctrl = 0
anim = 194
velset = 0,0
sprpriority = 2

[State 192, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = intro

[State 192, ChangeState]
type = ChangeState
trigger1 = Animtime = 0
value = 0

[StateDef 193]
type = S
ctrl = 0
anim = 191
velset = 0,0
sprpriority = 2

[State 193, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = intro

[State 193, PlaySnd]
type = PlaySnd
trigger1 = Time = 0
value = S190,4

[State 193, ChangeState]
type = ChangeState
triggerall = Time >= 250
triggerall = Anim = 191
trigger1 = p2stateno = 0 || enemy,anim = 0
trigger2 = Enemy,Name = "Shana_K"
trigger2 = Enemy,AuthorName = "Kohaku"
trigger2 = Time >= 250
value = 192
ctrl = 0

[StateDef 194]
type = S
ctrl = 0
anim = 196
velset = 0,0
sprpriority = 2

[State 194, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = intro

[State 194, PlaySnd]
type = PlaySnd
trigger1 = Anim = 196
trigger1 = Time = 0
value = S191,0
Channel = 0

[State 194, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 196
trigger1 = Time >= 380 
value = 197

[State 194, ChangeState]
