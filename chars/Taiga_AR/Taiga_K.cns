; Constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

[Data]
life = 1000			;Amount of life to start with
power = 5000		;Amount of maximum power (Abstract Reordered: 5 bars)
attack = 100		;attack power (more is stronger)
defence = 100		;defensive power (more is stronger)
fall.defence_up = 50	;Percentage to increase defense everytime player is knocked down
liedown.time = 60		;Time which player lies down for, before getting up
airjuggle = 15		;Number of points for juggling
sparkno = 2			;Default hit spark number for HitDefs
guard.sparkno = 40	;Default guard spark number
KO.echo = 0			;1 to enable echo on KO
volume = 0			;Volume offset (negative for softer)
IntPersistIndex = 45,47	;Variables with this index and above will not have their values
FloatPersistIndex = 40  ;reset to 0 between rounds or matches. There are 60 int variables,
  				;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
  				;If omitted, then it defaults to 60 and 40 for integer and float
  				;variables repectively, meaning that none are persistent, i.e. all
  				;are reset. If you want your variables to persist between matches,
  				;you need to override state 5900 from common1.cns.


[Size]
xscale = 0.335			;Horizontal scaling factor.
yscale = 0.335			;Vertical scaling factor.
ground.back = 15		;Player width (back, ground)
ground.front = 16		;Player width (front, ground)
air.back = 12		;Player width (back, air)
air.front = 12		;Player width (front, air)
height = 60			;Height of player (for opponent to jump over)
attack.dist = 160		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 0		;Set to 1 to scale projectiles too   
head.pos = -5, -90	;Approximate position of head
mid.pos = -5, -60		;Approximate position of midsection
shadowoffset = 0		;Number of pixels to vertically offset the shadow
draw.offset = 0,0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2	;Walk forward
walk.back = -1.3		;Walk backward
run.fwd  = 8, 0		;Run forward (x, y)
run.back = -4.5,-3.8	;Hop backward (x, y)
jump.neu = 0,-9.18		;Neutral jumping velocity (x, y)
jump.back = -1.9		;Jump back Speed (x, y)
jump.fwd = 2.6		;Jump forward Speed (x, y)
runjump.back = -2.2,-9.1;Running jump speeds (opt)
runjump.fwd = 2.2,-9.1	;.
airjump.neu = 0,-9.41	;.
airjump.back = -1.9	;Air jump speeds (opt)
airjump.fwd = 2.6		;.

[Movement]
airjump.num = 0		;Number of air jumps allowed (opt)
airjump.height = 35	;Minimum distance from ground before you can air jump (opt)
yaccel = .44		;Vertical acceleration
stand.friction = .85	;Friction coefficient when standing
crouch.friction = .82	;Friction coefficient when crouching

[Quotes]
Victory1 = "Geez now I'm hungry... Ryuji! Make me something!"
Victory2 = "Why's everyone trying to pick a fight with me?!"
Victory3 = "This would have ended a lot worse if Ryuji wasn't here to stop me!"
Victory4 = "Who're these people...? Did Denshin summon me to fight those bad guys again?"
Victory5 = "Today I'll teach y'all the true meaning of fear!"
Victory6 = "Everytime you get reincarnated, I'll be right there to knock ya straight back to hell!"
Victory7 = "Hey, how about some sashimi tonight? Kinda random, but it just came to me!"
Victory8 = "Shut it, ya worthless pond scum! You're a just a bug to be squashed. Don't try to mess with my head, chump!"

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 170, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S170,0+Random%2
Channel = 0

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = 181

;---------------------------------------------------------------------------
; Win pose 1
; CNS difficulty: basic
[Statedef 181]
type = S
ctrl = 0
anim = 180+Random%2
velset = 0,0

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = Time <= 180
flag = roundnotover

[State 181, PlaySnd]
type = PlaySnd
trigger1 = Anim = 180
trigger1 = AnimElem = 1
value = S180,0+Random%4
Channel = 0

[State 181, PlaySnd]
type = PlaySnd
trigger1 = Anim = 181
trigger1 = AnimElem = 2
value = S180,4+Random%2
Channel = 0

[State 181, PlaySnd]
type = PlaySnd
trigger1 = Anim = 181
trigger1 = AnimElem = 1
value = S180,6
Channel = 0

[State 181, Helper]
type = Helper
trigger1 = AnimElem = 1
stateno = 6004
ID = 181
Name = "Speech"
postype = left
facing = 1
sprpriority = 5
ownpal = 1
ignorehitpause = 1
persistent = 0
Helpertype = Normal
pausemovetime=-2**31-1
supermovetime=-2**31-1

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
[Statedef 190]
type = S
ctrl = 0
anim = 190+Random%2
velset = 0,0

[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, PlaySnd]
type = PlaySnd
trigger1 = Anim = 190
trigger1 = time = 1
value = S190,0+Random%3
Channel = 0

[State 190, PlaySnd]
type = PlaySnd
trigger1 = Anim = 191
trigger1 = time = 1
value = S190,3
Channel = 0

[State 190, ChangeState]
type = ChangeState
triggerall = Enemy,AuthorName = "Kohaku" && Enemy,Name = "Shana_K"
trigger1 = Time = 0
value = 193

[State 190, ChangeState]
type = ChangeState
triggerall = Enemy,AuthorName = "Kohaku" && Enemy,Name = "Emi_K"
trigger1 = Time = 0
value = 194

[State 190, ChangeState]
type = ChangeState
trigger1 = Time >= 180
trigger1 = Anim = 190
value = 191
ctrl = 0

[State 190, ChangeState]
type = ChangeState
trigger1 = Time >= 180
trigger1 = Anim = 191
value = 192
ctrl = 0

[StateDef 191]
