triggerall = Enemy,AuthorName = "Kohaku" && Enemy,Name = "Emi_K"
triggerall = Enemy,StateNo = 4108 
triggerall = MoveType = H
trigger1 = Enemy,Time = 4
trigger2 = Enemy,Time = 9
trigger3 = Enemy,Time = 14
trigger4 = Enemy,Time = 19
trigger5 = Enemy,Time = 24
trigger6 = Enemy,Time = 29
trigger7 = Enemy,Time = 34
trigger8 = Enemy,Time = 39
trigger9 = Enemy,Time = 44
trigger10 = Enemy,Time = 49
trigger11 = Enemy,Time = 52
trigger12 = Enemy,Time = 55
trigger13 = Enemy,Time = 58
trigger14 = Enemy,Time = 61
trigger15 = Enemy,Time = 64
trigger16 = Enemy,Time = 67
trigger17 = Enemy,Time = 70
trigger18 = Enemy,Time = 73
trigger19 = Enemy,Time = 74
trigger20 = Enemy,Time = 75
trigger21 = Enemy,Time = 76
trigger21 = Enemy,Time = 77
trigger22 = Enemy,Time = 78
trigger23 = Enemy,Time = 79
trigger24 = Enemy,Time = 80
trigger25 = Enemy,Time = 81
trigger26 = Enemy,Time = 104
v = 45
