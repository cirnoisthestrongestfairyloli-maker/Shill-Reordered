;---------------------------------------------------------------------------
;Abstract Reordered: PRIDE (X). fvar(26) = gauge 0-1000, fvar(27) = a Pride-powered move is running,
;fvar(28) = the power-up in state 900 is a Pride charge (hold X), fvar(23) = hit count seen, fvar(22) = 22 God Fist pending
[State -1, AR pride round reset]
type = VarSet
triggerall = !IsHelper
trigger1 = RoundState < 2
fvar(26) = 0
ignorehitpause = 1

[State -1, AR pride active off]
type = VarSet
triggerall = !IsHelper
triggerall = fvar(27)
trigger1 = !(stateno = [1000,4999]) || stateno = 1100 || MoveType = H
trigger2 = RoundState != 2
fvar(27) = 0
ignorehitpause = 1

[State -1, AR pride charge flag off]
type = VarSet
triggerall = !IsHelper
trigger1 = stateno != 900 && stateno != 195
fvar(28) = 0
ignorehitpause = 1

[State -1, AR god fist flag off]
type = VarSet
triggerall = !IsHelper
trigger1 = stateno != 1100
fvar(22) = 0
ignorehitpause = 1

[State -1, AR pride from taunt]
type = VarAdd
triggerall = !IsHelper
trigger1 = stateno = 195 && AnimElemTime(7) = 0
fvar(26) = 250
ignorehitpause = 1

[State -1, AR pride taunt shake]
type = EnvShake
triggerall = !IsHelper
trigger1 = stateno = 195 && AnimElemTime(7) = 0
time = 6
freq = 100
ampl = -4

[State -1, AR pride from power up]
type = VarAdd
triggerall = !IsHelper
triggerall = stateno = 900 && fvar(28) = 1
triggerall = anim = 900 || anim = 902 || anim = 911
trigger1 = AnimElemTime(5) >= 0
trigger1 = RoundState = 2
fvar(26) = 5
ignorehitpause = 1

[State -1, AR pride from hits]
type = VarAdd
triggerall = !IsHelper
trigger1 = HitCount > fvar(23)
fvar(26) = 15 * (HitCount - fvar(23))
ignorehitpause = 1

[State -1, AR pride hit count]
type = VarSet
triggerall = !IsHelper
trigger1 = HitCount != fvar(23)
fvar(23) = HitCount
ignorehitpause = 1

[State -1, AR pride clamp]
type = VarSet
triggerall = !IsHelper
trigger1 = fvar(26) > 1000
fvar(26) = 1000
ignorehitpause = 1

;a full gauge powers up the next special or super it sees start
[State -1, AR pride spend]
type = VarSet
triggerall = !IsHelper
triggerall = fvar(26) >= 1000 && fvar(27) = 0
triggerall = MoveType = A && Time <= 1
trigger1 = (stateno = [1000,1050]) || (stateno = [1200,1204]) || (stateno = [1400,1422]) || (stateno = [1500,1520]) || stateno = 2000 || (stateno = [2400,2425]) || stateno = 3000 || stateno = 3200 || (stateno = [3400,3420]) || stateno = 3610 || stateno = 4000
fvar(27) = 1
ignorehitpause = 1

[State -1, AR pride empty]
type = VarSet
triggerall = !IsHelper
trigger1 = fvar(27) = 1 && fvar(26) > 0
fvar(26) = 0
ignorehitpause = 1

[State -1, AR pride flash on spend]
type = PalFX
triggerall = !IsHelper
trigger1 = fvar(27) = 1 && Time <= 1
time = 12
add = 255, 220, 80
mul = 256, 256, 256
ignorehitpause = 1

[State -1, AR pride glow]
type = PalFX
triggerall = !IsHelper
trigger1 = fvar(27) = 1 && GameTime % 8 = 0
time = 6
add = 90, 70, 0
ignorehitpause = 1

[State -1, AR pride ready glint]
type = PalFX
triggerall = !IsHelper
trigger1 = fvar(26) >= 1000 && fvar(27) = 0 && GameTime % 40 = 0
time = 10
add = 70, 55, 0
ignorehitpause = 1

[State -1, AR pride damage]
type = AttackMulSet
trigger1 = !IsHelper
value = ifelse(fvar(27), 1.25, 1)
ignorehitpause = 1

;super armour: hits are taken (damage applies) but he keeps going. Throws still work.
[State -1, AR pride armour]
type = HitOverride
triggerall = !IsHelper
trigger1 = fvar(27) = 1
attr = SCA, NA, SA, HA, NP, SP, HP
stateno = 0
keepstate = 1
slot = 0
time = 2
ignorehitpause = 1

;Elite Assault: ender tier by Vegeta's life when it starts (1 = Spirit Breaking Cannon, 2 = Big Bang Attack
;at 50% or less, 3 = Falling Empire at 25% or less) and a damage cap of 350 / 400 / 450 for the whole super
[State -1, AR elite tier]
type = VarSet
triggerall = !IsHelper
trigger1 = stateno = 4000 && Time <= 1
fvar(25) = cond(Life > LifeMax * 0.5, 1, cond(Life > LifeMax * 0.25, 2, 3))
ignorehitpause = 1

[State -1, AR elite start life]
type = VarSet
triggerall = !IsHelper
trigger1 = stateno = 4000 && Time <= 1
trigger1 = NumEnemy
fvar(29) = EnemyNear, Life
ignorehitpause = 1

[State -1, AR elite cap]
type = TargetLifeAdd
triggerall = !IsHelper
triggerall = stateno = [4000,4499]
triggerall = NumTarget && NumEnemy
trigger1 = EnemyNear, Alive
trigger1 = fvar(29) - (EnemyNear, Life) > 300 + 50 * fvar(25)
value = ceil(fvar(29) - (EnemyNear, Life) - (300 + 50 * fvar(25)))
absolute = 1
ignorehitpause = 1

;Final Flash: remember the opponent's life so the beam stops adding damage near 350
[State -1, AR final flash start life]
type = VarSet
triggerall = !IsHelper
trigger1 = (stateno = 3600 || stateno = 3610) && Time <= 1
trigger1 = NumEnemy
fvar(24) = EnemyNear, Life
ignorehitpause = 1


