[Data]
life = 1000
power = 5000   ;Abstract Reordered: 5 bars
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 999
sparkno = 2
guard.sparkno = 40
KO.echo = -1
volumescale = 100
IntPersistIndex = 55
FloatPersistIndex = 40

[Size]
xscale = 0.22
yscale = 0.22
ground.back = 12
ground.front = 12
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 0, -105
mid.pos = -2, -75
shadowoffset = 2
draw.offset = -3,2

[Velocity]
walk.fwd  = 2
walk.back = -2
run.fwd  = 7, 0
run.back = -5.5,-3.5
jump.neu = 0,-8.4
jump.back = -2.55
jump.fwd = 2.5
runjump.back = -2.55,-8.1
runjump.fwd = 4,-8.1
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.5
air.gethit.groundrecover = -.15,-6
air.gethit.airrecover.mul = .5,.2
air.gethit.airrecover.add = 0,-6.5
air.gethit.airrecover.back = -3.5
air.gethit.airrecover.fwd = 3.5
air.gethit.airrecover.up = -3.5
air.gethit.airrecover.down = 3.5

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .38
stand.friction = .85
crouch.friction = .82
stand.friction.threshold = 2
crouch.friction.threshold = .05
air.gethit.groundlevel = 25
air.gethit.groundrecover.ground.threshold = -20
air.gethit.groundrecover.groundlevel = 10
air.gethit.airrecover.threshold = -1
air.gethit.airrecover.yaccel = .35
air.gethit.trip.groundlevel = 15
down.bounce.offset = 0, 20
down.bounce.yaccel = .4
down.bounce.groundlevel = 12
down.friction.threshold = .05

[Quotes]
victory1 = "I am the creme de la creme of Team RWBY. I have no time for losing here."
victory2 = "No matter who I face, I shall always fight with all that I have. Isn't that the proper etiquette?"
victory3 = "You are quite strong, but lack the proper experience. I will neither run nor hide. Should you wish to take your training seriously, I await your rematch."

