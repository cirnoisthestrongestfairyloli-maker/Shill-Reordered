;--------------------------------------------------------------------------
;Ice Shard
[Statedef 80300]
type    = U
movetype = A
physics = N
anim = 90300
ctrl = 0
sprpriority = 2

[State 1010, Helper Attack Scale]
type = AttackMulSet
trigger1 = ishelper
value = root,fvar(5)
ignorehitpause = 1

[State ]
type = Angleadd
Trigger1 = 1
value = 0

[State ]
type = AngleDraw
trigger1 = 1
scale = 1,1

[State ]
type = VarSet
trigger1 = time = 0
fvar(7) = ifelse((P2dist x=[0,1]),1,ifelse((P2dist x=[-1,0]),-1,P2dist x))

[State ]
type = VarSet
trigger1 = time = 0
fvar(8) = ifelse((P2dist y=[0,1]),1,ifelse((P2dist y=[-1,0]),-1,P2dist y))-40

[State ]
type = VarSet
trigger1 = time = 0
fvar(6) = atan(fvar(7)/fvar(8))-(.5*pi*ifelse(P2dist Y <20,-1,1))

[State ]
type = Veladd
trigger1 = time = 0
trigger1 = root,var(3) = 0
x = abs(10*cos(fvar(6)))
y = -10*sin(fvar(6))

[State ]
type = Veladd
trigger1 = time = 0
trigger1 = root,var(3) > 0
x = abs(15*cos(fvar(6)))
y = -15*sin(fvar(6))

[State ]
type = AngleSet
Trigger1 = 1
value = ATan(Vel Y/Vel X)*(-180.0/Pi)+((Vel X<0)*180)

[State 0,]
type = Assertspecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1
persistent = 1

[State 0, Explod]
type = Explod
trigger1 = timemod = 4,0
anim = 10006
ID = 10006
pos = -20+random%40,-20+random%40
postype = p1
facing = 1
vfacing = 1
bindtime = 0
removetime = 27
pausemovetime = 0
scale = const(size.xscale),const(size.yscale)
sprpriority = 1
ontop = 1
shadow = 0,0,0
ownpal = 0
removeongethit = 1
ignorehitpause = 1

[State 200, 1]
type = HitDef
trigger1 = !movecontact
attr = , SP
damage = 12, 3
animtype = Medium
guardflag = MA                   
priority = 3, Hit                
pausetime = 0, 8+(P2MoveType=A*2)
getpower = 0,11
sparkno = 0                      
sparkxy = 0, -67
hitsound = S1, 5
guardsound = S5, 0+random%3                
ground.type = Low
ground.slidetime = 17+((P2MoveType=A)*4)+((P2StateType=C)*2)           
ground.hittime  = 17+((P2MoveType=A)*4)+((P2StateType=C)*2)
guard.hittime  = 16+((P2MoveType=A)*4)+((P2StateType=C)*2) 
air.hittime  = 40+((P2MoveType=A)*5)
ground.velocity = -2.5
air.velocity = -2,-5
air.fall = 1
fall.recover = 1   
fall.recovertime = 60+((P2MoveType=A)*12)
palfx.time = 17
palfx.add = 184,184,200
Palfx.mul = 220,220,255
palfx.invertall = 1

[State 0, DestroySelf]
type = DestroySelf
trigger1 = frontedgebodydist < -50
trigger2 = backedgebodydist < -50
