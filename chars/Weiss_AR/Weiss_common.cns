;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = !AIlevel
trigger1 = statetype = C && command != "holddown"
trigger2 = AIlevel && random < 600 && numenemy
trigger2 = statetype = C && enemynear,statetype = A || statetype = C && enemynear,pos y < 0
statetype = S
physics = S

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = !AIlevel
trigger1 = statetype = S && command = "holddown"
trigger2 = AIlevel && random >= 600 && numenemy
trigger2 = statetype = S && enemynear,statetype != A
statetype = C
physics = C

[State 120, Stop Guarding]
type = ChangeState
trigger1 = !AIlevel && command != "holdback"
trigger2 = AIlevel && enemynear,movetype != A
trigger3 = !inguarddist
value = 140
;---------------------------------------------------------------------------
; Stand guard (guarding)
[Statedef 130]
type    = S
physics = S

[State 130, 1]
type = ChangeAnim
trigger1 = Anim != 130
value = 130

[State 152, 3]
type = ChangeState
trigger1 = !AIlevel
trigger1 = statetype = S && command = "holddown"
trigger2 = AIlevel && random >= 600 && numenemy
trigger2 = statetype = S && enemynear,statetype != A
value = 131

[State 130, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; Crouch guard (guarding)
[Statedef 131]
type    = C
physics = C

[State 131, 1]
type = ChangeAnim
trigger1 = Anim != 131
value = 131

[State 152, 3]
type = ChangeState
trigger1 = !AIlevel
trigger1 = statetype = C && command != "holddown"
trigger2 = AIlevel && random < 600 && numenemy
trigger2 = statetype = C && enemynear,statetype = A || statetype = C && enemynear,pos y < 0
value = 130

[State 131, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; Air guard (guarding)
[Statedef 132]
type    = A
physics = N

[State 132, 1]
type = ChangeAnim
trigger1 = Anim != 132
value = 132

[State 132, 2]
type = VelAdd
trigger1 = 1
y = Const(movement.yaccel)

[State 132, 3]
type = VarSet
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 132, 4]
type = VelSet
trigger1 = sysvar(0)
y = 0

[State 132, 5]
type = PosSet
trigger1 = sysvar(0)
y = 0

[State 132, 6]
type = ChangeState
trigger1 = sysvar(0)
trigger1 = command = "holdback"
trigger1 = inguarddist
value = 130

[State 132, 7]
type = ChangeState
trigger1 = sysvar(0)
value = 52

[State 132, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

