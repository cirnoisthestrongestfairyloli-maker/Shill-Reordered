trigger1 = HitShakeOver
value = 5411

;Down-bounce get-hit (falling)
[Statedef 5411]
type    = A
movetype = H
physics = N

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = time = 0
value = 5070
ignorehitpause = 1
persistent = 1

[State 5030, 2]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5030, 3]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 1403, 3]
type = ChangeState
triggerall = Pos Y >= 0
trigger1 = GetHitVar(fall.yvel) < 0
value = 5412

[State 1403, 3]
type = ChangeState
triggerall = Pos Y >= 0
trigger1 = GetHitVar(fall.yvel) >= 0
value = 5413

;Down-bounce get-hit (bounce up)
[Statedef 5412]
type    = A
movetype = H
physics = N
velset = 0,0

[State 0, Turn]
type = null;Turn
trigger1 = time = 0
trigger1 = P2dist X < 0

[State 0, ChangeAnim]
type = ChangeAnim
triggerall = time = 0
trigger1 = SelfAnimExist(5411)
value = 5411

[State 0, ChangeAnim]
type = ChangeAnim
triggerall = time = 0
trigger1 = !SelfAnimExist(5411)
value = 5100

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = anim = 5411
trigger1 = animtime = 0
trigger2 = anim = 5100
trigger2 = time > 5
value = 5090

[State 0, VelSet]
type = VelSet
trigger1 = anim = 5090
trigger1 = animelemtime(1) = 0
x = gethitvar(fall.xvel)
y = gethitvar(fall.yvel)

[State 1405,2]
type = VelAdd
trigger1 = anim = 5090
y = const(movement.down.bounce.yaccel)

[State 5050, 4] ;Recover near ground
type = SelfState
triggerall = anim = 5090 && CanRecover && alive
triggerall = Vel Y > Const(movement.air.gethit.airrecover.threshold)
triggerall = Pos Y >= Const(movement.air.gethit.groundrecover.ground.threshold)
trigger1 = Command = "recovery"
value = 5201 ;Air get-hit (fall recovery on ground)

[State 5050, 5]; Recover in mid air
type = SelfState
triggerall = anim = 5090 && CanRecover && alive
triggerall = Vel Y > Const(movement.air.gethit.airrecover.threshold)
triggerall = Pos Y < Const(movement.air.gethit.groundrecover.ground.threshold)
trigger1 = Command = "recovery"
value = 5210 ;Air get-hit (fall recovery in air)

[State 1405, ChangeState]
type = selfstate
triggerall = anim = 5090 && CanRecover && alive
trigger1 = Vel Y > Const(movement.air.gethit.airrecover.threshold)
trigger1 = Pos Y >= 0
value = 5110

[State 1405, ChangeState]
type = ChangeState
triggerall = anim = 5090
triggerall = Vel Y > Const(movement.air.gethit.airrecover.threshold)
triggerall = Pos Y >= 0
trigger1 = gethitvar(chainid) = 320
trigger2 = gethitvar(chainid) = 321
trigger3 = gethitvar(chainid) = 500
trigger4 = gethitvar(chainid) = 630
value = 5413

[State 1405, ChangeState]
type = null;ChangeState
triggerall = anim = 5090 && !CanRecover
trigger1 = Vel Y > Const(movement.air.gethit.airrecover.threshold)
trigger1 = Pos Y >= 0
value = 5413

;Down-bounce get-hit (downed)
[Statedef 5413]
type    = A
movetype = H
physics = N
anim = 5170
velset = 0,0

[State 0, VarSet]
type = null;VarSet
triggerall = !time
trigger1 = gethitvar(chainid) = 630
trigger2 = gethitvar(chainid) = 320
trigger3 = gethitvar(chainid) = 321
fvar(11) = 23

[State 0, NotHitBy]
type = null;NotHitBy
trigger1 = time > fvar(11)
value = SCA

[State 0, NotHitBy]
type = NotHitBy
triggerall = time > 23
trigger1 = gethitvar(chainid) = 630
trigger2 = gethitvar(chainid) = 320
trigger3 = gethitvar(chainid) = 321
value = SCA

[State 0, ChangeAnim]
