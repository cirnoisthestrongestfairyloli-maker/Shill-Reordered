trigger1 = Command = "recovery"
value = 5201

[State 1405, ChangeState]
type = selfstate
triggerall = alive && anim = 5110
trigger1 = gethitvar(chainid) = 320 && time > 23+const(data.liedown.time)
trigger2 = gethitvar(chainid) = 321 && time > 23+const(data.liedown.time)
trigger3 = gethitvar(chainid) = 500 && time > 23+const(data.liedown.time)
trigger4 = gethitvar(chainid) = 630 && time > 23+const(data.liedown.time)
value = 5120

[State 1405, ChangeState]
