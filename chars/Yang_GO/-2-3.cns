[statedef -2]
  

[State -2, Reset]
type = varset
trigger1 = numenemy = 1
trigger1 = (enemynear,movetype!=H)
trigger2 = !numenemy
trigger3 = numenemy = 2
trigger3 = (enemy(0),movetype!=H)
trigger3 = (enemy(1),movetype!=H)
var(8) = 0
 

[State -2]
type = Helper
trigger1 = numhelper(100000) = 0
stateno = 100000
ID = 100000
scale = 0.22,0.22
postype = left
pos = 8,38
sprpriority = -3
pausemovetime = 9999999999
supermovetime = 99999999
ignorehitpause = 1
ownpal = 1

[State HitSpark]
Type=Helper
TriggerAll=(NumTarget)
TriggerAll=(Target,StateNo=5814)&&(Target,Time=1)
Trigger1=!(NumHelper(102))
Trigger2=(NumHelper(102))
Trigger2=!(Helper(102),StateNo=7000)
HelperType=Normal
ID=102
Pos=0,0
OwnPal=1
PosType=P2
StateNo=7000
IgnoreHitPause=1
PauseMoveTime=0


[State HitSpark]
Type=Helper
TriggerAll=(NumTarget)
TriggerAll=(Target,StateNo=1405)&&(Target,Time=1)
Trigger1=!(NumHelper(101))
Trigger2=(NumHelper(101))
Trigger2=!(Helper(101),StateNo=7000)
HelperType=Normal
ID=101
Pos=-12,-45
OwnPal=1
PosType=P2
StateNo=7000
IgnoreHitPause=1
PauseMoveTime=0

[state 0]
type = Helper
triggerall = stateno != [3900,3957]
trigger1 = var(13)
trigger1 = numhelper(8002) = 0
name = "SHANA, NO, I MEAN YANG HAIR GLOW"
id = 8002
pos = 0,0
postype = p1
stateno = 8002
helpertype = normal
sprpriority = -5
ownpal = 1
supermovetime = 9999999
pausemovetime = 9999999

[State -2, EXPLODsive Buffering Helper]
type = Helper
triggerall = stateno != [1251112,1251114]
trigger1 = !NumHelper(90000005)
helpertype = Normal
stateNo = 90000005
ID = 90000005
name = "EXPLODsive Buffering helper"
posType = P1
facing = ifElse(Facing = 1, 1, -1)
keyCtrl = 1
ignoreHitPause = 1

[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "Damage Dampen = %f"
params = fvar(11)

[State 190,Random for FX]
type = VarRandom
trigger1 = 1
V = 9
range = 0,2   


[State -2, P2 Facing]
type= targetfacing
trigger1= movecontact=1 && numtarget=1
trigger1= !(target,hitshakeover) && !(target,hitfall) && (target,time<=1)
value= ifelse(p2dist x>=0, -1, 1)
ignorehitpause= 1

[State -3, Prevent Crossup]
type = width
trigger1 = movetype != H
edge = 8, 0
ignorehitpause = 1

[State -3, Prevent Undergound Juggles by POTS]
type= targetbind
trigger1= movehit=1
trigger1= numtarget=1 && numenemy
trigger1= (target,time<=1) && (target,ID=enemynear,ID)
trigger1= !(target,hitshakeover) && (target, hitfall) && (target, pos y>0)
pos= ceil(p2dist x), ceil(-pos y)
ignorehitpause= 1

[State -3, Corner Push Reset]
type= varset
trigger1= fvar(5)
trigger1= numtarget
trigger1= (target, hitover) || (target, gethitvar(hitshaketime) > 0 && target, time <= 0)
fvar(5)= 0

[State -3, Corner Push Initial Vel]
type= varset
trigger1= movecontact=1 && numtarget
fvar(5) = (target, gethitvar(xvel))
ignorehitpause= 1

[State -3, Corner Push Apply]
type= posadd
triggerall = stateno != [3900,3950]
triggerall = fvar(5)
triggerall = (statetype = S || statetype = C) && numtarget
triggerall = !hitpausetime && (target, gethitvar(hitshaketime) <= 0)
triggerall = (target, statetype = S || target, statetype = C) && !(target, gethitvar(yvel)) && !(target, hitfall)
trigger1 = target, frontedgebodydist <= abs(target, vel x)
trigger1 = (target, gethitvar(xvel) * target, facing) > 0
trigger2 = target, backedgebodydist <= abs(target, vel x)
trigger2 = (target, gethitvar(xvel) * target, facing) < 0
x = ifelse(target, frontedgebodydist <= 0, -1, 1) * (target, facing) * fvar(5)

[State -3, Corner Push Friction]
type= varset
trigger1= numtarget
trigger1= target, gethitvar(hitshaketime) <= 0
fvar(5) = fvar(5)*0.85

[State HitSpark]
Type=VarSet
Trigger1=(MoveContact=1)&&(var(41)<0)
var(41)=HitPauseTime
IgnoreHitPause=1

[State HitSpark]
Type=Helper
Trigger1=(var(41)=HitPauseTime)
Trigger1=((var(42)>0)||(var(43)>0))
Trigger1=(MoveContact=1)
HelperType=Normal
ID=IfElse(MoveHit,var(42),var(43))
Pos=Ceil(IfElse(P2Dist X<var(44),P2Dist X,var(44))),Ceil(var(45))
OwnPal=1
PosType=P1
StateNo=7100
IgnoreHitPause=1

[State HitSpark]
Type=VarSet
Trigger1=1
var(41)=-1

[State HitSpark]
Type=VarRangeSet
Trigger1=(MoveType=I)
Trigger2=(MoveType=H)&&(Time>0)
Trigger3=(MoveContact=1)&&((var(42)>0)||(var(43)>0))
First=41
Last=45
Value=-1
IgnoreHitPause=1

[State HitSpark]
Type=VarSet
Trigger1= numenemy = 1
var(46)=(EnemyNear,MoveType=A)

[State HitSpark]
Type=VarSet
Trigger1= numenemy = 2
var(46)=(enemy(0),MoveType=A || enemy(1),MoveType=A)



