trigger1 = 1
;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, PlaySnd]
type = PlaySnd
trigger1 = Timemod = 10, 0
value = S0,0
volume = 255

[State 100, Explod]
type = Explod
trigger1 = Timemod = 3, 0
pos = 6,0
scale = 1,1
ownpal = 1
random = 30,0
sprpriority = ifelse(var(25),-4,4)
vel = -4, 0
anim = 7012
ignorehitpause = 1
persistent = 1
trans = addalpha
alpha = 256,128

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd"
trigger1 = time > 35
value = 0
ctrl = 1
;---------------------------------------------------------------------------
; RUN_BACK
