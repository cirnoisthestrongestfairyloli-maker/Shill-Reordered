[State 100, PlaySnd]
type = PlaySnd
trigger1 = Timemod = 10, 0
value = S0,0
volume = 255

[State 100, Explod]
type = Explod
trigger1 = Timemod = 3, 0
pos = 6,0
scale = 1,1
ownpal = 1
random = 30,0
sprpriority = ifelse(var(25),-4,4)
vel = 4, 0
anim = 7012
ignorehitpause = 1
persistent = 1
