;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2, Debug Info]
Type = Displaytoclipboard
Trigger1 = 1
text = "pos y:%d,Yoruichi BY Alchemist"
params =ceil(pos y)

;System config
[State -2, System config]
type = Helper
trigger1 = roundsexisted <= 0
trigger1 = roundstate = 0
id = 96443
name = "System config"
pos = 99999,99999
postype = right
stateno = 96443
helpertype = normal
keyctrl = 0
ownpal = 1
ignorehitpause = 1
pausemovetime = 999999
supermovetime = 999999

[State -2, VarSet]
type = VarSet
trigger1 = 1
fvar(8) = Const(size.xscale)

[State -2, VarSet]
type = VarSet
trigger1 = 1
fvar(9) = Const(size.yscale)

[State -2, Helper]
type = Helper
trigger1 = numhelper(25000) < 1
id = 25000
name = "Flash_Bar"
postype = p1
pos = -99999999999,-99999999999
stateno = 25000
helpertype = normal
keyctrl = 0
ownpal = 1
ontop = 1
facing = facing*ifelse(teamside=1,1,-1)
sprpriority = 7

[State -2, Countup]
type = VarAdd
trigger1 = fvar(5) >= 0 && fvar(5) < 120
fvar(5) = ifelse(stateno >= 45, 0.10, 1)
ignorehitpause = 1

[State -2, Countup]
type = Varset
trigger1 = fvar(5) > 120
fvar(5) = 120
ignorehitpause = 1

[State -2]
Type = VarSet
Trigger1 = StateNo = 52
var(16) = 0

[State -2]
Type = VarSet
Trigger1 = StateNo = 52
var(17) = 0

[State 0, VarSet]
type = VarSet
trigger1 = roundstate = 0
var(30) = 1

[State -2, VarSet]
type = VarSet
trigger1 = (P2MoveType != H) && (Var(30) > 1)
var(30) = 1

[State -2, RemoveExplod]
type = RemoveExplod
trigger1 = stateno != 200
id = 201

[State -2, RemoveExplod]
type = RemoveExplod
trigger1 = stateno != 210
id = 211

[State -2, RemoveExplod]
type = RemoveExplod
trigger1 = stateno != 220
id = 221

[State -2, RemoveExplod]
type = RemoveExplod
trigger1 = stateno != 410
id = 411

[State -2, RemoveExplod]
type = RemoveExplod
trigger1 = stateno != 610
id = 611

[State -2, RemoveExplod]
type = RemoveExplod
trigger1 = stateno != 620
id = 621

[State -2, AssertSpecial]
type = AssertSpecial
trigger1 = 0   ;Abstract Reordered: she guards by holding back now
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard

[State -2, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noautoturn

