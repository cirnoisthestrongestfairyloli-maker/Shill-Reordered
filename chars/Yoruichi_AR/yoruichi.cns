;---------------------------------------------------------------------------
; Standing Light Punch
[Statedef 200]
type    = S
movetype= A
physics = N
ctrl = 0
anim = 200

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S2,12 + var(48)
volume = 255
channel = 0

[State 200, 0]
type = Turn
triggerall = time = 0
trigger1 = PrevStateNo = 20001
trigger1 = p2dist x <= -5
trigger2 = ifelse(!facing,command = "holdfwd",command = "holdback")
trigger3 = ifelse(facing,command = "holdback",command = "holdfwd")

[State 200,Velset]
Type = Velset
Trigger1 = PrevStateNo = 20001
Trigger1 = Time >= 0
X = 0

[State 200,Velset]
Type = Velset
Trigger1 = PrevStateNo != 20001
Trigger1 = Time >= 0
X = IfElse(PrevStateNo = 20,0,Vel X)

[State 200,Velmul]
Type = Velmul
Trigger1 = PrevStateNo != 20001
Trigger1 = Time >= 0
X = IfElse(PrevStateNo = 20,0,0.9)

[state 200, varadd]
type = varadd
triggerall = (NumTarget(200)) && movehit
trigger1 = var(30) <= 15
var(30) = 1
persistent = 0
ignorehitpause = 1

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 =  var(25) = 1
statetype = C
movetype = A
physics = N

[State 200, 1]
type = HitDef
triggerall = var(25) = 0
trigger1 = animelem = 2
attr = S, NA
damage =floor(ifelse((var(30))<= 3,23,ifelse((var(30)) <= 15,floor(23/var(30)),1)))
ID = 200
animtype = Light
air.animtype = Light
guardflag = MA
hitflag = MAFDLH
priority = 3, Hit
pausetime = 9,9
sparkno = S7000
guard.sparkno = S7008
sparkxy = -10, -80
hitsound = S1, 4
guardsound = S1, 3
ground.type = High
ground.slidetime = 12
ground.hittime  = 12
ground.velocity = -5.3
airguard.velocity = -1.9,-.8
air.type = High
air.velocity = -1.4,ifelse(p2stateno=5050,0,-3)
air.hittime = 10
ground.cornerpush.veloff = -9
yaccel = .5

[State 200, 1]
type = HitDef
triggerall = var(25) = 1
trigger1 = animelem = 2
attr = C, NA
damage =floor(ifelse((var(30))<= 3,23,ifelse((var(30)) <= 15,floor(23/var(30)),1)))
