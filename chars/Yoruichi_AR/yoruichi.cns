triggerall = RoundState = [0,4]
triggerall = var(25) = 0
triggerall = time = 1
trigger1 = 1
time = -1
add = 0, 0, 0
mul = 256, 256, 256
sinadd = 10,10,10,255
invertall = 0
color = 256
persistent = 1
ignorehitpause = 1

[state -2, bglesserprior];char sprite lesser priority for background
