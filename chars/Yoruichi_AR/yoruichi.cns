[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = S0, 3

[State -3, Whoosh1 Sounds]
type = PlaySnd
triggerall = animelem = 2
trigger1 = stateno = 200
trigger2 = stateno = 400
trigger3 = stateno = 600
value = S1, 0
channel = 2
volume = 255

[State -3, Whoosh2 Sounds]
type = PlaySnd
triggerall = animelem = 2
trigger1 = stateno = 210
trigger2 = stateno = 410
trigger3 = stateno = 610
value = S1, 1
channel = 2
volume = 255

[State -3, Whoosh3 Sounds]
type = PlaySnd
triggerall = animelem = 2
trigger1 = stateno = 220
trigger2 = stateno = 420
trigger3 = stateno = 620
value = S1, 2
channel = 2
volume = 255

[State -3, NotHitBy]
type = NotHitBy
Trigger1 = StateNo = 20001
value = SCA,AA,AP,AT
time = 1

[State -3, Explod]
type = Explod
triggerall = Time = 1
trigger1 = stateno = 52
pos = 0,0
scale = 1,1
ownpal = 1
sprpriority = ifelse(var(25),-3,4)
anim = 7013
ignorehitpause = 1
persistent = 1
trans = addalpha
alpha = 256,128

[State -3, VarSet]
type = VarSet
triggerall = Time = 1
trigger1 = stateno = 52
var(4) = 0

