[Statedef 1011]
type    = S
movetype= A
physics = N
velset = 0,0
ctrl = 0
HitCountpersist = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S1,15
volume = 255
channel = 2

[State 0, Turn]
type = Turn
triggerall = !movecontact
trigger1 = enemynear(0),pos x < pos x && facing = 1
trigger2 = enemynear(0),pos x > pos x && facing = -1

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 =  parent,var(28) = 0
statetype = S       ;S,A,C,L
movetype = A        ;I,A,H
physics = N         ;A,C,S,N

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 =  parent,var(28) = 1
statetype = C       ;S,A,C,L
movetype = A        ;I,A,H
physics = N         ;A,C,S,N

[state 1011, 0]
type = playerpush
trigger1 = 1
time = -1
ignorehitpause = 1
persistent = 1
value = 0

;Finds the X component of the vector Player, EnemyNear
;Formula to find the components of a given vector AB
;V(x) = B(x) - A(x)
;V(y) = B(y) - A(y)
[State 1011, X]
Type = VarSet
Trigger1 = 1
fvar(13) = (EnemyNear(0), Pos X - Pos X) * Facing;Adjust the direction towards player facing

;Finds the Y component of the vector Player, EnemyNear
[State 1011, Y]
Type = VarSet
trigger1 = 1
fvar(14) = (EnemyNear(0), pos Y - Pos Y) - 45

;Finds the vector length
;Formula of the length of a given vector AB
;|AB| = (AB(x)^2  + AB(y)^2)^1/2
[State 1011, Vector Length]
Type = VarSet
trigger1 = 1
fvar(15) = Exp(0.5*ln((fvar(13) * fvar(13))+(fvar(14) * fvar(14))))

[State 1011, VelSet]
type = VelSet
trigger1 = time = 0
x = (Fvar(13)/fvar(15)) * 12.0
y = (FVar(14)/fvar(15)) * 12.0

[State -3, M]
Type = VarSet
trigger1 = EnemyNear(0), Pos X != Pos X
trigger1 = time = 0
fvar(11) = -((EnemyNear(0), Pos Y - Pos Y)/(EnemyNear(0), Pos X - Pos X))

[State -3, M] ;There can be no triangle if both points share the same X cord
Type = VarSet
trigger1 = EnemyNear(0), Pos X = Pos X
trigger1 = time = 0
fvar(11) = 0

[State -3, Angle]
Type = VarSet
trigger1 = vel x != 0
fvar(12) = Atan(fvar(11)) * (180.0/Pi)*facing + 22.5  ;Angle given in degrees.

[State -3, Angle]
Type = AngleDraw
trigger1 = 1
value = fvar(12)
