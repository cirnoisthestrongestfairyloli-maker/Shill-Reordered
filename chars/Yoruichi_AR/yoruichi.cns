;I AM P1
;========
[state 191, varset]
type = varset
triggerall = teamside = 1
triggerall = numenemy
triggerall = screenpos x < 160
trigger1 = time = 0
trigger1 = numpartner
trigger1 = ID < partner, ID
trigger2 = time = 0
trigger2 = !numpartner
var(22) = 1

;I AM P2
;========
[state 191, varset]
type = varset
triggerall = teamside = 1
triggerall = numenemy
triggerall = screenpos x < 160
trigger1 = time = 0
trigger1 = numpartner
trigger1 = ID > partner, ID
var(22) = 2

