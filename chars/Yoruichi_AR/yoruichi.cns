hitsound = S1, 6
guardsound = S1, 3			;Sound to play on guard
ground.type = High		;Type: High, Low, Trip (def: Normal)
ground.slidetime = 30		;Time that the opponent slides back
ground.hittime  = 70		;Time opponent is in hit state
ground.velocity = -.5,-9	;Velocity at which opponent is pushed
airguard.velocity = -1.9,-.8	;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))			;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -.5,-9		;X-velocity at which opponent is pushed,					;Y-velocity at which opponent is pushed
air.hittime = 30
yaccel=0.4
ground.cornerpush.veloff = 0

