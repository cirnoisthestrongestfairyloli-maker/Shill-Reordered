trigger1 = ifelse((anim=[5,6]),command="623_Z",command="421_Z")
trigger1 = (var(10):=3)||1
trigger2 = AILevel <= 0 ;AI Off
trigger2 = ifelse((anim=[5,6]),command="623_Y",command="421_Y")
trigger2 = (var(10):=2)||1
trigger3 = AILevel <= 0 ;AI Off
trigger3 = ifelse((anim=[5,6]),command="623_X",command="421_X")
trigger3 = (var(10):=1)||1

