;===========================================================================
; Basics
;===========================================================================

;---------------------------------------------------------------------------
;Run Fwd
[State -1, Run Fwd]
type = ChangeState
value = 100+10*(statetype=A)
triggerall = !ishelper
triggerall = (stateno!=[100,101]) && stateno!=110
triggerall = ctrl
triggerall = cond(statetype!=A,1,cond(vel y < 0,pos y <= -35,1))
triggerall = var(8)=0
trigger1 = AILevel <= 0 ;AI Off
trigger1 = command = "FF" || (command = "holdfwd" && command!="holdback" && (command="a"))
trigger1 = var(8):=(var(8)+1)
;AI
trigger2 = AILevel > 0
trigger2 = statetype != A
trigger2 = var(58) = 100
trigger2 = (var(58):=0)||1
trigger2 = var(8):=(var(8)+1)
trigger3 = AILevel > 0
trigger3 = statetype = A
trigger3 = var(58) = 110
trigger3 = (var(58):=0)||1
trigger3 = var(8):=(var(8)+1)

;---------------------------------------------------------------------------
;Run Back
[State -1, Run Back]
type = ChangeState
value = 105+10*(statetype=A)
triggerall = !ishelper
triggerall = (stateno!=[105,106]) && stateno!=115
triggerall = ctrl
triggerall = cond(statetype!=A,1,cond(vel y < 0,pos y <= -35,1))
triggerall = var(8)=0
trigger1 = AILevel <= 0 ;AI Off
trigger1 = command = "BB" || (command = "holdback" && command!="holdfwd" && (command="a"))
trigger1 = var(8):=(var(8)+1)
;AI
trigger2 = AILevel > 0
trigger2 = statetype != A
trigger2 = var(58) = 105
trigger2 = (var(58):=0)||1
trigger2 = var(8):=(var(8)+1)
trigger3 = AILevel > 0
trigger3 = statetype = A
trigger3 = var(58) = 115
trigger3 = (var(58):=0)||1
trigger3 = var(8):=(var(8)+1)

