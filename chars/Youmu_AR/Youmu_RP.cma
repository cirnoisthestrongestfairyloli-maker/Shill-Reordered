;---------------------------------------------------------------------------
; 2. State entry
; --------------
; Don't remove the following line. It's required by the CMD standard.
;Abstract Reordered: A/B/C = light/medium/heavy (swapped above: her own x/y/z), X = Half-Ghost (Myon), Y = grab, Z = parry, A+B+C = burst
[Command]
name = "ar_x"
command = x
time = 1

[Command]
name = "ar_parry"
command = z
time = 1

[Command]
name = "ar_burst"
command = a+b+c
time = 1

[Statedef -1]
;Abstract Reordered: burst gauge (var(35)) HUD
;Abstract Reordered: burst HUD - Touma's BURST gauge, recoloured, just under the lifebar.
;var(35) = cooldown ticks (4500 = just used, 0 = ready). Anims 9660-9668, explod IDs = anims.
[State -1, AR burst gauge 9668 P1]
type = Explod
triggerall = !ishelper
triggerall = TeamSide = 1
trigger1 = NumExplod(9668) = 0
trigger1 = var(35) = 0
anim = 9668
ID = 9668
pos = (GameWidth - 320) / 2 + 52, 43
postype = left
facing = 1
scale = .5, .5
bindtime = -1
removetime = -1
supermovetime = 99999
pausemovetime = 99999
sprpriority = 9
ontop = 1
ownpal = 1
removeongethit = 0
ignorehitpause = 1

