[State -1, 236xyz: Slash of Life & Death]
type = ChangeState
value = 1200
triggerall = !ishelper
triggerall = statetype != A
triggerall = ctrl || stateno=40 || stateno=52 || stateno=101 || stateno=106 || ((stateno=100||stateno=105) && animelemtime(3)>1) || ((stateno=[200,629]) && (movecontact||var(1)))
trigger1 = AILevel <= 0 ;AI Off
trigger1 = ifelse((anim!=[5,6]),command="236_Z",command="214_Z")
trigger1 = power >= 500   ;AR: C = EX, 500 meter
trigger1 = (var(10):=3)||1
trigger1 = (var(38):=1)||1
trigger2 = AILevel <= 0 ;AI Off
trigger2 = ifelse((anim!=[5,6]),command="236_Y",command="214_Y")
trigger2 = (var(10):=2)||1
trigger3 = AILevel <= 0 ;AI Off
trigger3 = ifelse((anim!=[5,6]),command="236_X",command="214_X")
trigger3 = (var(10):=1)||1
;AI
trigger4 = AILevel > 0
