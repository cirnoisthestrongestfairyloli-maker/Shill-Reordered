;---------------------------------------------------------------------------
;=== AR BURST LOGIC (HUD blocks are added by hud_youmu.py: Touma style, anims/sprites 9660-9668) ===
;Abstract Reordered: burst (Kamijo's) - A+B+C while being hit, recharges in 75 s (var(35) counts down from 4500)
[State -1, AR burst round reset]
type = VarSet
triggerall = !ishelper
trigger1 = RoundState < 2
var(35) = 0

[State -1, AR burst recharge]
type = VarAdd
triggerall = !ishelper
trigger1 = RoundState = 2
trigger1 = var(35) > 0
var(35) = -1
ignorehitpause = 1

;Abstract Reordered: comeback - once a combo has done more than 15% of max life, every further hit
;knocks half a second (30 ticks) off the burst cooldown. fvar(31) = life when the combo started, fvar(33) = life last tick
[State -1, AR burst comeback]
type = VarAdd
triggerall = !ishelper
triggerall = var(35) > 0
trigger1 = movetype = H
trigger1 = Life < fvar(33)
trigger1 = fvar(31) - Life > LifeMax * 0.15
var(35) = -30
ignorehitpause = 1

[State -1, AR burst comeback clamp]
type = VarSet
triggerall = !ishelper
trigger1 = var(35) < 0
var(35) = 0
ignorehitpause = 1

[State -1, AR burst combo start]
type = VarSet
triggerall = !ishelper
trigger1 = movetype != H
fvar(31) = Life
ignorehitpause = 1

[State -1, AR burst last life]
type = VarSet
triggerall = !ishelper
trigger1 = 1
fvar(33) = Life
ignorehitpause = 1

[State -1, AR burst]
type = ChangeState
value = ifelse(StateType = A, 7751, 7750)
triggerall = !ishelper
triggerall = command = "ar_burst"
triggerall = var(35) = 0
triggerall = RoundState = 2
triggerall = Alive
trigger1 = (stateno = 5000 || stateno = 5010 || stateno = 5020 || stateno = 5070) && Time > 0
trigger2 = stateno = [5001, 5099]
trigger2 = stateno != 5000 && stateno != 5010 && stateno != 5020 && stateno != 5070

;=== END AR BURST ===

;Abstract Reordered: parry on Z
[State -1, AR Parry]
type = ChangeState
value = 7740
triggerall = !ishelper
triggerall = command = "ar_parry"
triggerall = RoundState = 2
trigger1 = ctrl

;Abstract Reordered: X = Half-Ghost (Myon joins in for 4-10 s, her hits repeat). Costs 400 spirit (needs 500+), state 4100.
[State -1, AR Half-Ghost]
type = ChangeState
value = 4100
triggerall = !ishelper
triggerall = RoundState = 2
triggerall = statetype != A
triggerall = var(54) = 0
triggerall = var(50) >= 950   ;MAX Spirit Level = the "bankai" input
triggerall = ctrl
trigger1 = AILevel <= 0
trigger1 = command = "ar_x"
trigger1 = command != "holdfwd" && command != "holdback" && command != "holdup"
trigger2 = AILevel > 0
trigger2 = Random < 12
trigger2 = P2BodyDist X < 120

[State -1, Negative Edge] ;- Reset // Release // Hold
type = null
triggerall = !ishelper
trigger1 = var(40)&4032
trigger1 = (var(40):=0)||1
trigger2 = var(40)
trigger2 = (var(40):=var(40) +64*(var(40)&1 && command != "holda") +128*(var(40)&2 && command != "holdb") +256*(var(40)&4 && command != "holdc") +512*(var(40)&8 && command != "holdx") +1024*(var(40)&16 && command != "holdy") +2048*(var(40)&32 && command != "holdz")) - var(40)
trigger3 = var(40):=var(40)-(var(40)&63) + 1*(command = "holda") + 2*(command = "holdb") + 4*(command = "holdc") + 8*(command = "holdx") + 16*(command = "holdy") + 32*(command = "holdz")

[State -1, Tick Fix]
type = CtrlSet
triggerall = !ishelper
triggerall = !ctrl
trigger1 = (stateno=52 || stateno=101 || stateno=5120 || stateno=5201) && !animtime
trigger2 = ((stateno=[200,499]) || stateno=626) && !animtime
trigger3 = (stateno=800 || stateno=810) && !animtime
trigger4 = (stateno=1000 || stateno=1001 || stateno=1020 || stateno=1101 || stateno=1200 || stateno=1201) && !animtime
trigger5 = (stateno=1203 || stateno=1300 || stateno=1400 || stateno=2000 || stateno=2100 || stateno=4000) && !animtime
trigger6 = (stateno=4003 || stateno=4100 || stateno=4200 || stateno=4202) && !animtime
trigger7 = (stateno=5001 || stateno=5011 || stateno=151 || stateno=153) && hitover
value = 1

[State -1, Hello Training I have ctrl please cease your 1f buggery]
type = Null
triggerall = numenemy
triggerall = enemy,numhelper(20000)
triggerall = enemy,name="Training"
trigger1 = ctrl && enemy,cond(numhelper(20000),helper(20000),cond(1,var(31)>0,0),0)
trigger1 = enemy,cond(numhelper(20000),helper(20000),cond(1,var(31):=0,0),0)||1

;======================
; Myon Proration Stuff
[State -2, Reset var when the opponent recovers]
type = Varset
triggerall = ishelper(30100)
trigger1 = numenemy
trigger1 = (enemynear,movetype!=H)
trigger2 = !numenemy
fvar(10) = 1.0

[State -2, Final Dampen]
type = null
triggerall = ishelper(30100)
trigger1 = (stateno!=[2000,4999])
trigger1 = (fvar(11):=ifelse(root,fvar(9)>fvar(10),root,fvar(9),fvar(10))*ifelse(root,var(4)>0,0.5,1.0)*0.6) || 1
ignorehitpause = 1

;===========================================================================
[State -1, Combo condition Reset]
type = VarSet
triggerall = !ishelper
trigger1 = var(1)!=0
trigger1 = !ctrl
trigger1 = stateno != [1001,1005]
var(1) = 0
ignorehitpause = 1

[State -1, Combo condition Check]
type = VarSet
triggerall = !ishelper
trigger1 = var(1)!=1
trigger1 = movetype != A
trigger1 = ctrl
trigger2 = ((stateno=[200,299]) || (stateno=[400,499]) || (stateno=[600,699])) && movecontact
trigger3 = (stateno = [1100,1105]) && movecontact
trigger4 = (stateno = [1200,1203]) && movecontact
trigger5 = stateno = 1300 && movecontact
trigger6 = stateno = 1400 && animelemtime(7)>=2
var(1) = 1
ignorehitpause = 1

