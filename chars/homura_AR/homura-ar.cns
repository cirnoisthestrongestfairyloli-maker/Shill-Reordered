;---------------------------------------------------------------------------
; Abstract Reordered additions for Homura
; Parry on Z (same as Haruhi's / Ichigo's): catches any attack in a short window.
;   success: brief freeze, +40 meter, a little life back, she can act right away
;   whiff:   -80 meter and stuck for 18 frames (minus); in the air she falls with no control
;---------------------------------------------------------------------------

[Statedef 700]
type     = U
movetype = I
physics  = N
ctrl     = 0
anim     = ifelse(StateType = C, 131, ifelse(StateType = A, 132, 130))
sprpriority = 2

[State 700, Air physics]
type = StateTypeSet
trigger1 = StateType = A
physics = A
ignorehitpause = 1
persistent = 1

[State 700, Catch]
type = ReversalDef
trigger1 = Time = 0
reversal.attr = SCA, NA, SA, HA, NP, SP, HP, AA, AP
pausetime = 0, 13
numhits = 0
sparkno = -1
sparkxy = 0, 0
hitsound = -1, -1
p1stateno = 701

[State 700, Catch window]
type = HitOverride
trigger1 = Time = [3, 12]
time = 1
attr = SCA, NA, SA, HA, NP, SP, HP, AA, AP
stateno = 701
ignorehitpause = 1

[State 700, Flash]
type = PalFX
trigger1 = Time = 3
time = 9
add = 130, 40, 200
sinadd = 64, 32, 5, 31

[State 700, Hold pose]
type = ChangeAnim
trigger1 = AnimTime = 0
value = Anim
elem = AnimElemNo(0)

[State 700, Stay put]
type = VelSet
trigger1 = StateType != A
x = 0
y = 0

[State 700, Ground whiff]
;window passed without catching anything
type = ChangeState
trigger1 = StateType != A
trigger1 = Time >= 13
value = 708

[State 700, Air whiff]
type = ChangeState
trigger1 = StateType = A
trigger1 = Time >= 20
value = 709

;---------------------------------------------------------------------------
; Parry success

[Statedef 701]
type     = U
movetype = I
physics  = N
ctrl     = 0
velset   = 0, 0
anim     = ifelse(StateType = C, 131, ifelse(StateType = A, 132, 130))

[State 701, Air physics]
type = StateTypeSet
trigger1 = StateType = A
physics = A
ignorehitpause = 1
persistent = 1

[State 701, Sound]
type = PlaySnd
trigger1 = Time = 0
value = F6, 0

[State 701, Meter]
type = PowerAdd
trigger1 = Time = 0
value = 40
ignorehitpause = 1
persistent = 1

[State 701, Life]
type = LifeAdd
trigger1 = Time = 0
value = 4
ignorehitpause = 1
persistent = 1

[State 701, Safe]
type = NotHitBy
trigger1 = Time = 0
value = SCA
time = 18

[State 701, Freeze]
type = Pause
trigger1 = Time = 0
time = 15
movetime = 15
ignorehitpause = 1
persistent = 1

[State 701, Flash]
type = EnvColor
trigger1 = Time = 0
value = 230, 200, 255
time = 1

[State 701, Hold pose]
type = ChangeAnim
trigger1 = AnimTime = 0
value = Anim
elem = AnimElemNo(0)

[State 701, Stop in air]
type = VelSet
trigger1 = StateType = A
trigger1 = Time = 0
x = 0
y = 0

[State 701, Free to act]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 701, Ground end]
type = ChangeState
trigger1 = StateType != A
trigger1 = Time >= 15
value = ifelse(StateType = C, 11, 0)
ctrl = 1

[State 701, Air end]
type = ChangeState
trigger1 = StateType = A
trigger1 = Time >= 20
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Parry whiffed on the ground: -80 meter, stuck for 18 frames (minus)

[Statedef 708]
type     = U
movetype = I
physics  = U
ctrl     = 0
velset   = 0, 0

[State 708, Cost]
type = PowerAdd
trigger1 = Time = 0
value = -80

[State 708, Failed]
type = PalFX
trigger1 = Time = 0
time = 18
add = -40, -40, -40
mul = 200, 200, 200

[State 708, Hold pose]
type = ChangeAnim
trigger1 = AnimTime = 0
value = Anim
elem = AnimElemNo(0)

[State 708, Recover]
type = ChangeState
trigger1 = Time >= 18
value = ifelse(StateType = C, 11, 0)
ctrl = 1

;---------------------------------------------------------------------------
; Parry whiffed in the air: -80 meter, no control until he lands (landing goes to 52)

[Statedef 709]
type     = A
movetype = I
physics  = A
ctrl     = 0

[State 709, Cost]
type = PowerAdd
trigger1 = Time = 0
value = -80

[State 709, Failed]
type = PalFX
trigger1 = Time = 0
time = 18
add = -40, -40, -40
mul = 200, 200, 200

[State 709, Hold pose]
type = ChangeAnim
trigger1 = AnimTime = 0
value = Anim
elem = AnimElemNo(0)

