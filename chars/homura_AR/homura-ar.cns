;---------------------------------------------------------------------------
; Charged j.B (hold B during j.B). Released before half charge: normal j.B.
; Half (15 frames) or full (30 frames, auto-release): a stronger kick that drags the opponent up
; with her, and grants one extra jump (var(37)). Once per combo (var(35)); var(36) = charge level.

[Statedef 636]
type     = A
movetype = A
physics  = N
juggle   = 3
poweradd = 0
ctrl     = 0
anim     = 630
sprpriority = 2

[State 636, Windup pose]
type = ChangeAnim
trigger1 = 1
value = 630
elem = 2

[State 636, Hover]
type = VelSet
trigger1 = Time = 0
x = vel x * 0.3
y = 0

[State 636, Drift]
type = VelAdd
trigger1 = 1
y = 0.05

[State 636, Charging flash]
type = PalFX
trigger1 = Time % 8 = 0
trigger1 = Time < 30
time = 4
add = 90, 30, 140

[State 636, Half charged]
type = PalFX
trigger1 = Time = 15
time = 6
add = 160, 80, 220

[State 636, Fully charged]
type = PalFX
trigger1 = Time = 30
time = 8
add = 230, 160, 255

[State 636, Land]
type = ChangeState
trigger1 = Pos Y >= 0
trigger1 = Vel Y > 0
value = 52

[State 636, Too early]
type = ChangeState
trigger1 = command != "ar_hold_b"
trigger1 = Time < 15
value = 630

[State 636, Level]
type = VarSet
trigger1 = command != "ar_hold_b" || Time >= 30
var(36) = ifelse(Time >= 30, 2, 1)

[State 636, Release]
type = ChangeState
trigger1 = command != "ar_hold_b" || Time >= 30
value = 637

[Statedef 637]
type     = A
movetype = A
physics  = A
juggle   = 3
poweradd = 0
ctrl     = 0
anim     = 630
sprpriority = 2

