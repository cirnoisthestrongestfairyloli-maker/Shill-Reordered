;-----基本情報------------------------------------------------------

[Info]
Name         = "kuroko_s"   ;キャラの名前（後々必要な場合がるので省略不可）
DisplayName  = "Shirai Kuroko"   ;ゲーム中表示される名前（省略可能）
VersionDate  = 9,26,2010      ;キャラの最終更新日
MugenVersion = 10,12,2007      ;このキャラを使用出来るM.U.G.E.Nのバージョン
Author       = "baggy"      ;このキャラの作成者の名前
Pal.Defaults = 1,2,3,4         ;CPUで出てくるキャラカラーの順番

;-----必要なファイルの設定------------------------------------------
[Files]
Cmd      = kuroko_s.cmd          ;入力コマンド定義ファイルの登録
Cns      = kuroko_s.cns          ;基本ステータス情報ファイルの登録
St       = kuroko_s_0.cns          ;動作プログラムファイルの登録（最大１０個くらい増やせます（St,St0,St1,St2......））
St0       = kuroko_s_1.cns
St1       = kuroko_s_-2.cns
St2      = kuroko_s_-3_AI.cns
St3      = kuroko_AR.cns
StCommon = kuroko_s_common1.cns      ;コモン動作プログラムファイルの登録
Sprite   = kuroko_s.sff          ;複数のPCX画像を１パック化したスプライトファイルの登録
Anim     = kuroko_s.air          ;アニメーションファイルの登録
Sound    = kuroko_s.snd          ;複数のWAV音声を１パック化したサウンドファイルの登録
Movelist = kuroko_movelist.dat
;---カラーパレットファイルの設定（最大１２個まで可能）---

Pal1 = kuroko_s_00.act	;Default
Pal2 = ar_02_mikoto.act	;2 Misaka Mikoto (own series)
Pal3 = ar_03_sunset.act	;3 Sunset
Pal4 = ar_04_azure.act	;4 Azure
Pal5 = ar_05_jade.act	;5 Jade
Pal6 = ar_06_orchid.act	;6 Orchid
Pal7 = ar_07_rose.act	;7 Rose
Pal8 = ar_08_pastel.act	;8 Pastel
Pal9 = ar_09_ice.act	;9 Ice
Pal10 = ar_10_noir.act	;10 Noir
Pal11 = ar_11_gold.act	;11 Gold
Pal12 = ar_12_ember.act	;12 Ember
Pal13 = ar_13_rin.act	;13 Rin Tohsaka (Fate)
Pal14 = bossrush.act   ;Abstract Reordered: boss rush colour (also stored in the sprite file as palette 1,14)

[Palette Keymap]
a = 1
b = 2
c = 3
x = 4 ;Press button X to select palette 1, etc.
y=5

;-----ストーリーボード設定------------------------------------------
;別途作成したキャラ固有のオープニングとエンディングのファイルを
;入れる場合は、ここの項目で設定が出来ます。

[Arcade]
;Intro.Storyboard  = intro.def
;Ending.Storyboard = ending.def
