#===============================================================================
# Abstract Reordered: wakeup timing, run grab and loop drop, for every character
#
# 0. Wakeup: everyone lies downed for 9 frames, then plays their whole get-up animation and has control
#    as soon as it ends. No mash lock. Every character's get-up actions (5120-5129 in their .air files) are
#    timed to 30 frames; a new character needs the same.
# 1. Run grab: control is given back 2 frames into any run, so everyone can grab out of a run.
# 2. Loop drop: if the same move of the attacker hits 4 times in a row in one combo (the move
#    starts again from its first frame each time), the combo drops: the opponent is knocked down.
# 3. Grab tech: pressing Y just as you are grabbed breaks the grab and pushes both players apart.
#===============================================================================
[StateDef -4]

ignorehitpause if !ishelper && (teamside = 1 || teamside = 2) && roundstate = 2 {
	# ---------------------------------------------------------- wakeup: same timing for everyone
	# the downed state (5110) is never cut straight to standing: the engine's own get-up is held back until
	# frame 9 and then started here, so the downed sprite and the get-up animation both play
	if stateNo = 5110 && time = 0 {
		map(_ar_downT) := gameTime;
	}
	map(_ar_wakeT) := gameTime - map(_ar_downT);
	if alive && stateNo = 5110 {
		if map(_ar_wakeT) < 9 {
			assertSpecial{flag: noGetUpFromLieDown; flag2: noFastRecoverFromLieDown}
		} else {
			changeState{value: 5120}
		}
	}
	# ---------------------------------------------------------- grab out of a run
	# every character regains control a moment into the run (state 100), so the Y grab (and every other
	# move that waits for control) can be done straight out of a run
	if alive && stateNo = 100 && time >= 2 {
		ctrlSet{value: 1}
	}

	# ---------------------------------------------------------- loop drop
	if moveType != H {
		map(_ar_loopState) := -1;
		map(_ar_loopCount) := 0;
		map(_ar_loopTime) := 0;
	} else if numenemy && getHitVar(hitcount) > map(_ar_loopHits) {
		if (enemyNear, stateno) != map(_ar_loopState) {
			map(_ar_loopState) := (enemyNear, stateno);
			map(_ar_loopCount) := 1;
		} else if (enemyNear, time) <= map(_ar_loopTime) {
			map(_ar_loopCount) := map(_ar_loopCount) + 1;
		}
		map(_ar_loopTime) := (enemyNear, time);
		if map(_ar_loopCount) > 3 {
			map(_ar_loopCount) := 0;
			changeState{value: 5030}
			velSet{x: -3; y: -5}
		}
	}
	map(_ar_loopHits) := cond(moveType = H, getHitVar(hitcount), 0);

	# ---------------------------------------------------------- grab tech: victim
	# grabbed = being hit while the opponent attacks from a throw state (800-899). A fresh press of Y within
	# 10 frames (or up to 4 frames before, for both pressing grab together) breaks the grab with no damage.
	if moveType != H {
		map(_ar_grabbed) := 0;
	} else if alive && !map(_ar_grabbed) && numenemy && (enemyNear, stateNo = [800, 899]) && (enemyNear, moveType = A) {
		map(_ar_grabbed) := 1;
		map(_ar_grabT) := gameTime;
	}
	if alive && moveType = H && map(_ar_grabbed) = 1 && gameTime - map(_ar_grabT) <= 10 &&
		inputTime(y) > 0 && inputTime(y) <= gameTime - map(_ar_grabT) + 4 {
		map(_ar_grabbed) := 2;
		map(_ar_techT) := gameTime;
		if pos y > -30 {
			posSet{y: 0}
			selfState{value: 0; ctrl: 1}
		} else {
			selfState{value: 50; ctrl: 1}
		}
		velSet{x: -4}
		notHitBy{value: , NT,ST,HT; time: 20}
	}

	# ---------------------------------------------------------- grab tech: the one who grabbed lets go
	if alive && numenemy && stateNo = [800, 899] && (enemyNear, map(_ar_techT)) > 0 &&
		(enemyNear, map(_ar_techT)) >= gameTime - 1 {
		if pos y > -30 {
			posSet{y: 0}
			selfState{value: 0; ctrl: 1}
		} else {
			selfState{value: 50; ctrl: 1}
		}
		velSet{x: -4}
	}
}
